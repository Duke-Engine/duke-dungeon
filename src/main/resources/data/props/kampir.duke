; ---------------------------------------------------------------------------
; What stands in Yalmog'iz kampir's yard: Inuciian's props ("Baba Yaga's hut",
; CC BY 4.0, see CREDITS.md), each a Prop -- solid, nothing's target -- that no
; room ever draws (Weight 0): a map puts them where it wants them. Each has one
; look, here, whatever biome it stands in, at ModelScale 1: the models are
; written in the game's units (art/inuciian/export_models.py).
;
; The hut itself, the fences and the small things (bucket, broom, candles, a
; rat) are scenery, turned as a map turns them: models/buildings/hut/,
; models/props/village/ and models/nature/.
; ---------------------------------------------------------------------------

; Her cauldron on its fire, the ladle in it.
Prop
  Name = Cauldron
  DisplayName = Qozon
  KindOf = [STRUCTURE]
  VisionRange = 0
  Geometry = Cylinder
    Radius = 4.4
    Height = 9.5
  End
  Weight = 0
End

ThemeMonster
  Name = Cauldron
  Model = models/props/village/cauldron.glb
  ModelScale = 1
End

; A stone well with its winch.
Prop
  Name = Well
  DisplayName = Quduq
  KindOf = [STRUCTURE]
  VisionRange = 0
  Geometry = Cylinder
    Radius = 6
    ; The curb is 5.7 units; the roof on its frame, 18.7.
    Height = 18.7
  End
  Weight = 0
End

ThemeMonster
  Name = Well
  Model = models/props/realistic/well.glb
  ModelScale = 6.667
End

