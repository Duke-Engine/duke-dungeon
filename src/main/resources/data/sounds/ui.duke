; ---- the bow, which is heard more than anything else ----------------------

; ★ A KEY HE COULD NOT PAY FOR. The one sound in the game for something that did
; NOT happen, and it earns its place: a skill on cooldown says so on the socket
; -- swept, counting down -- and a skill he cannot afford looks exactly like a
; key that did not register. Without this, the answer is on the panel and the
; player is looking at the fight.
;
; Quiet, and the interface channel rather than effects, because it is the game
; answering him rather than something happening in the world. Delete the block
; and the bar flashing blue is the whole of the feedback.
Sound
  Name = no_mana
  Channel = Ui
  Positional = No
  Gain = 0.35
  Files = [audio/ui/click_2.ogg]
End

Sound
  Name = depth
  Channel = Ui
  Positional = No
  Files = [audio/sfx/descend.ogg]
End

; ---- the screen -----------------------------------------------------------

Sound
  Name = menu_hover
  Channel = Ui
  Positional = No
  Gain = 0.4
  Files = [audio/ui/hover.ogg]
End

Sound
  Name = menu_click
  Channel = Ui
  Positional = No
  Gain = 0.6
  Files = [audio/ui/click_1.ogg, audio/ui/click_2.ogg]
End

; The tick under an order mark -- see OrderMark in the World block.
;
; Quiet on purpose, and quieter than the same file is in a menu: this is heard on
; every click of a session rather than a few times an hour, and a sound at that
; rate has to sit under the notice rather than in it. It is the click landing,
; not an announcement that it landed.
Sound
  Name = order_mark
  Channel = Ui
  Positional = No
  Gain = 0.2
  Files = [audio/ui/click_1.ogg, audio/ui/click_2.ogg]
End

Sound
  Name = level_up
  Channel = Ui
  Positional = No
  ; A climb of plucked strings, as the light he levels in climbs: Kenney's Music
  ; Jingles (CC0), levelled with the rest, so it needs only a little turning down.
  Gain = 0.5
  Files = [audio/ui/level_up.ogg]
End

Sound
  Name = power_taken
  Channel = Ui
  Positional = No
  Files = [audio/ui/power_taken.ogg]
End

; ---- his own screens (Soundscape) -----------------------------------------

; A page turned as the sheet, the quest log or the map opens, and the book shut.
Sound
  Name = screen_open
  Channel = Ui
  Positional = No
  Gain = 0.5
  Files = [audio/ui/page_1.ogg, audio/ui/page_2.ogg]
End

Sound
  Name = screen_close
  Channel = Ui
  Positional = No
  Gain = 0.35
  Files = [audio/ui/book_shut.ogg]
End

; A quest taken, and one done: two of Kenney's jingles, the short and the long.
Sound
  Name = quest_taken
  Channel = Ui
  Positional = No
  Gain = 0.45
  Files = [audio/ui/quest_taken.ogg]
End

Sound
  Name = quest_done
  Channel = Ui
  Positional = No
  Gain = 0.5
  Files = [audio/ui/quest_done.ogg]
End

; Gold paid to him or by him. A burst of a dozen coins is one sound, not twelve.
Sound
  Name = coins
  Channel = Ui
  Positional = No
  Gain = 0.55
  GapSeconds = 0.25
  Files = [audio/ui/coins_1.ogg, audio/ui/coins_2.ogg, audio/ui/coins_3.ogg, audio/ui/coins_4.ogg]
End
