; ---------------------------------------------------------------------------
; The wilds' monsters (data/units/wilds_*.duke), heard: their blows, their pain, their deaths, a cry when
; the big ones come into sight, and their feet -- walking.<Template>.<surface> as every walker's, see
; data/sounds/sfx.duke. Flyers and floaters have no feet to hear. Every clip is one the game already ships
; (CREDITS.md); nothing new was recorded.
; ---------------------------------------------------------------------------

Sound
  Name = fired.Wolf
  Channel = Effects
  Positional = Yes
  Gain = 0.5
  Files = [audio/sfx/weapon/quick_swing_1.ogg, audio/sfx/weapon/quick_swing_2.ogg]
End
