; ---- feet -----------------------------------------------------------------
;
; The client plays walking.<Template>.<surface> for anything that walks on a painted map -- the surface is the
; palette picture's file name (ground/grass.png -> grass) -- and walking.<Template> where the ground has no sound of
; its own or is not painted (the descent's stone). Once a GapSeconds: the stride. Placed, so a distant walker is
; faint; a creature is quieter than a hero.

Sound
  Name = walking.Knight
  Channel = Effects
  Positional = Yes
  Gain = 0.3
  GapSeconds = 0.34
  Files = [audio/sfx/step/stone_l1.ogg, audio/sfx/step/stone_r1.ogg, audio/sfx/step/stone_l2.ogg, audio/sfx/step/stone_r2.ogg, audio/sfx/step/stone_l3.ogg, audio/sfx/step/stone_r3.ogg]
