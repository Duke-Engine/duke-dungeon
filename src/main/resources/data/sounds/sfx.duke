  Name = struck.Gate
  Channel = Effects
  Positional = Yes
  Gain = 0.8
  Files = [audio/sfx/world/lock_open.ogg]
End

Sound
  Name = gone.Gate
  Channel = Effects
  Positional = Yes
  Gain = 0.8
  Files = [audio/sfx/world/lock_open.ogg]
End

