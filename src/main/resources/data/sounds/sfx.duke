  Name = struck.Chest
  Channel = Effects
  Positional = Yes
  Gain = 0.5
  Files = [audio/sfx/world/chest_open_1.ogg, audio/sfx/world/chest_open_2.ogg]
End

Sound
  Name = gone.Chest
  Channel = Effects
  Positional = Yes
  Gain = 0.5
