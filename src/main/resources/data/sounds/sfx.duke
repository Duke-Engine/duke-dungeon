End

Sound
  Name = gone.Key
  Channel = Effects
  Positional = Yes
  Gain = 0.7
  Files = [audio/sfx/world/keys_1.ogg, audio/sfx/world/keys_2.ogg]
End

; The keep's gate: its lock turned as it goes, and the open gate swinging into its place.
