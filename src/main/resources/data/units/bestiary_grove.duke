      ExperienceValue = 45
      ExperienceRequired = [0, 0, 0]
    End
  ]

  SenseRadius = 45
  ChaseRadius = 95
  CloseDistance = 4
  AlertRadius = 70
  RepathFrames = 8
  SwingFrames = 14
  ; Never on a floor of the descent: the open world places it by name.
