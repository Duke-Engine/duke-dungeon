  Walk = Walk
  Attack = Attack
  Death = Death
  ; How far one play of its walk carries it, measured off the clip (MonsterClipFitTest).
  WalkStride = 0

  Skills = [
    Skill
      Key = Q
      ; Drinks a share of every blow it lands.
      Effect = LIFESTEAL
      BoostPercent = 25
      MaxRank = 1
      Name = "Qon so'rish"
    End,
    Skill
      Key = W
      ; Strikes faster for five seconds -- itself, or the sturdiest of its own near it.
      Effect = HASTE
      BoostPercent = 60
      DurationFrames = 150
      Range = 50
      CooldownFrames = 300
      Look = Hasted
      MaxRank = 1
      Icon = icons/stats/stat_speed.png
      Blurb = Bir necha soniya ancha tezroq uradi.
      Name = Shiddat
    End
  ]
End

; CAMP BOSS: calls up sporelings and makes his own hit harder.
Monster
  Name = MushroomKing
  DisplayName = "Qo'ziqorin qirol"
  KindOf = [INFANTRY, SELECTABLE, CAN_ATTACK]
  Geometry = Cylinder
    Radius = 8
    Height = 18
  End
  VisionRange = 130
  Modules = [
    GrowableBody
      MaxHealth = 560
    End,
    MoveUpdate
      Speed = 12
      TurnRate = 0
    End,
    WeaponUpdate
      Damage = 22
      AttackRange = 14
      ReloadFrames = 26
      ; The swing up to the blow (MonsterClipFitTest), taken off ReloadFrames.
      PreAttackFrames = 10
    End,
    Swing
    End,
    SkillBook
    End,
    StatusUpdate
    End,
    MonsterBrain
    End,
    ExperienceModule
      ExperienceValue = 150
      ExperienceRequired = [0, 0, 0]
    End
  ]

  SenseRadius = 55
  ChaseRadius = 150
  CloseDistance = 4
  AlertRadius = 110
  RepathFrames = 8
  SwingFrames = 14
  ; Never on a floor of the descent: the open world places it by name.
  MinDepth = 99
  Weight = 0
  SkillDistance = [0, 60]
  Colour = 0xC8B890
  Scale = 1.5
  Model = models/bestiary/mushroom_king.glb
  ModelScale = 4.99
  Idle = Idle
  Walk = Walk
  Attack = Attack
  Death = Death
  ; How far one play of its walk carries it, measured off the clip (MonsterClipFitTest).
  WalkStride = 13.1

  Skills = [
    Skill
      Key = Q
      ; Rifts round it, and one of its own out of each.
      Effect = SUMMON
      Summons = [Sporeling = 2]
      MaxSummoned = 4
      Radius = 16
      DurationFrames = 600
      SummonExperiencePercent = 0
      WindUpFrames = 20
      Projectile = SummoningRift
      CooldownFrames = 420
      MaxRank = 1
      Name = "Qo'ziqorin bolalari"
    End,
    Skill
      Key = E
      ; Everyone of its own round it hits harder.
      Effect = DAMAGE_AURA
      BoostPercent = 25
      Radius = 50
      Look = MightAura
      TickFrames = 30
      MaxRank = 1
      Icon = icons/stats/stat_attack.png
      Blurb = Atrofidagi o'zinikilar qattiqroq uradi.
      Name = "G'azab"
    End
  ]
End

