; ELITE of the lizards: bigger, burning orange, two affixes.
Monster
  Name = FireLizard
  DisplayName = "Olovli kaltakesak"
  KindOf = [INFANTRY, SELECTABLE, CAN_ATTACK]
  Geometry = Cylinder
    Radius = 8
    Height = 19
  End
  VisionRange = 130
  Modules = [
    GrowableBody
      MaxHealth = 380
    End,
    MoveUpdate
      Speed = 13
      TurnRate = 0
    End,
    WeaponUpdate
      Damage = 26
      AttackRange = 14
      ReloadFrames = 30
      ; The swing up to the blow (MonsterClipFitTest): the client starts its attack as it winds up,
      ; and the blow lands as the clip strikes. Taken off ReloadFrames, so it hits as often as before.
      PreAttackFrames = 10
    End,
    Swing
    End,
    SkillBook
    End,
    StatusUpdate
    End,
    MonsterBrain
    End,
    ExperienceModule
      ExperienceValue = 60
      ExperienceRequired = [0, 0, 0]
    End
  ]

  SenseRadius = 55
  ChaseRadius = 150
  CloseDistance = 4
  AlertRadius = 110
  RepathFrames = 8
  SwingFrames = 18
  ; Never on a floor of the descent: the open world's camps place it by name.
  MinDepth = 99
  Weight = 0
  Colour = 0xFF8A40
  Scale = 1.58
  Model = models/wilds/dino.glb
  ModelScale = 6.3
  Tint = 0xFF8A40
  ; Its own clips, renamed by art/monsters/export_monsters.py.
  Idle = Idle
  Walk = Walk
  Attack = Attack
  Death = Death
  ; How far one play of its walk carries it, measured off the clip (MonsterClipFitTest): its feet stay put.
  WalkStride = 16.53
  UpperBody = Hips

  Skills = [
    Skill
      Key = E
      ; Elite affix: everyone of its own round it hits a quarter harder.
      Effect = DAMAGE_AURA
      BoostPercent = 25
      Radius = 50
      Look = MightAura
      TickFrames = 30
      MaxRank = 1
      Name = "G'azab"
      Icon = icons/stats/stat_attack.png
      Blurb = Atrofidagi o'zinikilar qattiqroq uradi.
    End,
    Skill
      Key = Q
      ; Elite affix: drinks a third of every blow it lands.
      Effect = LIFESTEAL
      BoostPercent = 30
      MaxRank = 1
      Name = "Qonxo'r"
    End
  ]
End

; CAMP BOSS: breathes fire down a line, drinks from his blows.
Monster
  Name = Dragon
  DisplayName = "Ajdar"
  KindOf = [INFANTRY, SELECTABLE, CAN_ATTACK]
  Geometry = Cylinder
    Radius = 9
    Height = 22
  End
  VisionRange = 130
  Modules = [
    GrowableBody
      MaxHealth = 560
    End,
    MoveUpdate
      Speed = 14
      TurnRate = 0
    End,
    WeaponUpdate
      Damage = 24
      AttackRange = 14
      ReloadFrames = 29
      ; The swing up to the blow (MonsterClipFitTest): the client starts its attack as it winds up,
      ; and the blow lands as the clip strikes. Taken off ReloadFrames, so it hits as often as before.
      PreAttackFrames = 7
    End,
    Swing
    End,
    SkillBook
    End,
    StatusUpdate
    End,
    MonsterBrain
    End,
    ExperienceModule
      ExperienceValue = 150
      ExperienceRequired = [0, 0, 0]
    End
  ]

  SenseRadius = 55
  ChaseRadius = 150
  CloseDistance = 4
  AlertRadius = 110
  RepathFrames = 8
  SwingFrames = 20
  ; Never on a floor of the descent: the open world's camps place it by name.
  MinDepth = 99
  Weight = 0
  SkillDistance = [10, 60]
  Colour = 0xC8B890
  Scale = 1.83
  Model = models/wilds/dragon.glb
  ModelScale = 6.95
  ; Its own clips, renamed by art/monsters/export_monsters.py.
  Idle = Idle
  Walk = Walk
  Attack = Attack
  Death = Death
  UpperBody = Torso

  Skills = [
    Skill
      Key = W
      ; Fire breathed down a line, bursting as the mage's fireball does: it can be stepped out of.
      Effect = SKILLSHOT
      Damage = 40
      Range = 70
      Radius = 26
      HitWidth = 8
      ProjectileSpeed = 120
      Projectile = MageFireball
      CooldownFrames = 240
      MaxRank = 1
      Name = Olov nafasi
    End,
    Skill
      Key = Q
      ; Drinks a quarter of every blow it lands.
      Effect = LIFESTEAL
      BoostPercent = 25
      MaxRank = 1
      Name = Qon so'rish
    End
  ]
End
