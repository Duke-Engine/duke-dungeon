; ---------------------------------------------------------------------------
; The desert (Qumli dasht): cactus men, lizards and a fire-throwing jinn; a dragon over the camp.
; One of the wilds' four families (docs/plan/2026-10-15-big-plan.md, Phase 2 item 5): a common one,
; a stronger one, one that shoots, the stronger one's ELITE (bigger, tinted, more health and blows, a
; better drop -- ItemRules' Elites in data/world/loot.duke -- and one or two affixes, each a skill of the
; skill system) and the CAMP BOSS (ItemRules' CampBosses: drops as a boss does). WorldMapWriter's WILDS
; puts a camp of them in the desert. Models: Quaternius (CC0) -- see CREDITS.md and art/monsters.
; Levels are the walk's from the city, as every monster's in the world: these figures are level 1's.
; ---------------------------------------------------------------------------

; common.
Monster
  Name = Cactoro
  DisplayName = "Kaktusvoy"
  KindOf = [INFANTRY, SELECTABLE, CAN_ATTACK]
  Geometry = Cylinder
    Radius = 4
    Height = 12
  End
  VisionRange = 70
  Modules = [
    GrowableBody
      MaxHealth = 65
    End,
    MoveUpdate
      Speed = 15
      TurnRate = 0
    End,
    WeaponUpdate
      Damage = 8
      AttackRange = 10
      ReloadFrames = 20
      ; The swing up to the blow (MonsterClipFitTest): the client starts its attack as it winds up,
      ; and the blow lands as the clip strikes. Taken off ReloadFrames, so it hits as often as before.
      PreAttackFrames = 10
    End,
    Swing
    End,
    SkillBook
    End,
    StatusUpdate
    End,
    MonsterBrain
    End,
    ExperienceModule
      ExperienceValue = 12
      ExperienceRequired = [0, 0, 0]
    End
  ]

  SenseRadius = 45
  ChaseRadius = 95
  CloseDistance = 4
  AlertRadius = 70
  RepathFrames = 10
  SwingFrames = 12
  ; Never on a floor of the descent: the open world's camps place it by name.
  MinDepth = 99
  Weight = 0
  Colour = 0xC8B890
  Scale = 1.00
  Model = models/wilds/cactoro.glb
  ModelScale = 3.2
  ; Its own clips, renamed by art/monsters/export_monsters.py.
  Idle = Idle
  Walk = Walk
  Attack = Attack
  Death = Death
  ; How far one play of its walk carries it, measured off the clip (MonsterClipFitTest): its feet stay put.
  WalkStride = 8.39
  UpperBody = Hips
End

