      ; Drinks a share of every blow it lands.
      Effect = LIFESTEAL
      BoostPercent = 25
      MaxRank = 1
      Name = "Qon so'rish"
    End,
    Skill
      Key = E
      ; Everyone of its own round it hits harder.
      Effect = DAMAGE_AURA
      BoostPercent = 25
      Radius = 50
      Look = MightAura
      TickFrames = 30
      MaxRank = 1
      Icon = icons/stats/stat_attack.png
      Blurb = Atrofidagi o'zinikilar qattiqroq uradi.
      Name = "G'azab"
    End
  ]
End

; CAMP BOSS by the river: drags the hero in, and his hide turns blows aside.
Monster
  Name = Troll
  DisplayName = "Trol"
  KindOf = [INFANTRY, SELECTABLE, CAN_ATTACK]
  Geometry = Cylinder
    Radius = 9
    Height = 22
  End
  VisionRange = 130
  Modules = [
    GrowableBody
      MaxHealth = 600
    End,
    MoveUpdate
      Speed = 11
      TurnRate = 0
    End,
    WeaponUpdate
      Damage = 26
      AttackRange = 16
      ReloadFrames = 30
      ; The swing up to the blow (MonsterClipFitTest), taken off ReloadFrames.
      PreAttackFrames = 10
    End,
    Swing
    End,
    SkillBook
    End,
    StatusUpdate
    End,
    MonsterBrain
    End,
    ExperienceModule
      ExperienceValue = 160
      ExperienceRequired = [0, 0, 0]
    End
  ]

  SenseRadius = 55
  ChaseRadius = 150
  CloseDistance = 4
  AlertRadius = 110
  RepathFrames = 8
  SwingFrames = 14
  ; Never on a floor of the descent: the open world places it by name.
  MinDepth = 99
  Weight = 0
  SkillDistance = [0, 30]
  Colour = 0x6A8A5A
  Scale = 1.83
  Model = models/characters/monsters/yeti.glb
  ModelScale = 7.78
  Tint = 0x6A8A5A
  Idle = Idle
  Walk = Walk
  Attack = Attack
  Death = Death
  ; How far one play of its walk carries it, measured off the clip (MonsterClipFitTest).
  WalkStride = 20.4
  ; The licensed look (CGTrader Royalty Free, licensed-assets/ only; see CREDITS.md) where it is
  ; shipped, the look above where it is not.
  Licensed = MonsterLook
    Model = models/licensed/troll.glb
    ModelScale = 8.02
    Idle = Idle
    Walk = Walk
    Attack = Attack
    Death = Death
    WalkStride = 9.6
  End

  Skills = [
    Skill
      Key = Q
      ; Everyone round it dragged to its front, hurt and held.
      Effect = PULL
      Radius = 32
      Range = 12
      Damage = 30
      StunFrames = 45
      CooldownFrames = 600
      MaxRank = 1
      Look = Whirlwind
      Name = Changal
    End,
    Skill
      Key = R
      ; Its hide turns aside a share of every blow.
      Effect = DRAGON_BLOOD
      BoostPercent = 25
      Heal = 0
      MaxRank = 1
      Name = Qalin teri
    End
  ]
End
