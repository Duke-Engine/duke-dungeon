; ---------------------------------------------------------------------------
; A graveyard's raiser and its graves (data/story/graveyards.duke, docs/plan/2026-10-19-open-world-act1.md).
; Neither is ever placed by a floor (MinDepth 99, Weight 0): a Graveyard block lays them.
; ---------------------------------------------------------------------------

; A grave the dead climb out of: a mound with a sword at its head. It never moves and never strikes. It cannot be
; killed by a blow, only beaten -- its UNYIELDING -- and the game strikes it down then, once its raiser has fallen;
; while the raiser stands, nothing it takes holds (Graveyards).
Monster
  Name = Grave
  DisplayName = "Qabr"
  KindOf = [SELECTABLE]
  Geometry = Cylinder
    Radius = 6
    Height = 6
  End
  VisionRange = 0
  Modules = [
    GrowableBody
      MaxHealth = 400
    End,
    SkillBook
    End,
    StatusUpdate
    End,
    ExperienceModule
      ExperienceValue = 40
      ExperienceRequired = [0, 0, 0]
    End
  ]
  MinDepth = 99
  Weight = 0
  Colour = 0x4E4636
  Scale = 1
  Model = models/props/realistic/grave.glb
  ModelScale = 6.667
  Skills = [
    Skill
      Key = Q
      Effect = UNYIELDING
      HealBelowPercent = 1
      MaxRank = 1
      Name = "Sehr bilan himoyalangan"
    End
  ]
End

; The mage who stands before the graves and raises the dead out of them, casting the while: the necromancer's
; look and fire, its own name, never placed by a floor.
Monster
  Name = GraveRaiser
  DisplayName = "Qabr sehrgari"
  KindOf = [INFANTRY, SELECTABLE, CAN_ATTACK]
  Geometry = Cylinder
    Radius = 7
    Height = 12
  End
  VisionRange = 130
  Modules = [
    GrowableBody
      MaxHealth = 460
    End,
    WeaponUpdate
      Damage = 20
      ; It never walks (no MoveUpdate): it stands among its graves and throws fire from far off.
      AttackRange = 120
      ReloadFrames = 33
      PreAttackFrames = 17
      AttackOnTheMove = No
    End,
    ; The same fire as the Revenant's, thrown by something three times the size --
    ; so it is a bigger ball, which is a projectile of its own rather than a number
    ; on this one. See Projectile GreaterFireball.
    Bow
      Projectile = GreaterFireball
      Speed = 210
      ; Out at the end of a staff held by something twenty units tall.
      MuzzleOffset = 12
    End,
    ; It throws at what it can see, like everything else down here that throws.
    EyesOnly
    End,
    AutoHealUpdate
      HealPerSecond = 9
    End,
    Swing
    End,
    ; Its spells for the dead it raises -- see its Skill blocks, below.
    SkillBook
    End,
    ; Timers for the statuses it is wearing -- the engine's own, and today that
    ; means SLOWED. MoveUpdate already halves the step of anything wearing it, and
    ; StatusUpdate already counts it down and takes it off, so a monster that
    ; carries this thaws by itself whether or not whoever chilled it is still alive.
    StatusUpdate
    End,
    MonsterBrain
    End,
    ExperienceModule
      ExperienceValue = 130
      ExperienceRequired = [0, 0, 0]
    End
  ]


  ; It sees as far as it throws, and never comes: stood among its graves, it fights from there.
  SenseRadius = 130
  ChaseRadius = 140
  CloseDistance = 110
  ; It casts on its dead while he is anywhere it can reach.
  SkillDistance = [0, 130]
  AlertRadius = 110
  RepathFrames = 8
  ; Realistic since 2026-11-05: the workspace's models/grave_raiser on the game rig, its clips in its file, 1 m = 6.667 units.
  Model = models/characters/realistic/grave_raiser.glb
  ModelScale = 6.667
  Facing = 90
  Idle = Idle
  Walk = Walk
  ; How far one play of Walk carries it, measured off the clip (MonsterClipFitTest): its feet stay put.
  WalkStride = 8.68
  Attack = Cast
  Death = Death
  UpperBody = spine_01
  SwingFrames = 32
  MinDepth = 99
  Weight = 0
  Colour = 0x9A6AD8
  Scale = 1.9

  ; What it gives the dead it raises, all in the skill system: their blows drink life back (its aura over its
  ; graves), one of them at a time strikes faster, and a hurt one is mended.
  Skills = [
    Skill
      Key = Q
      Effect = LIFESTEAL_AURA
      BoostPercent = 25
      Radius = 75
      Look = BloodAura
      TickFrames = 30
      MaxRank = 1
      Icon = icons/stats/stat_lifesteal.png
      Blurb = Qabrlari atrofidagi o'liklar har zarbasidan jon qaytarib oladi.
      Name = "Qon qabri"
    End,
    Skill
      Key = W
      Effect = HASTE
      BoostPercent = 60
      DurationFrames = 150
      Range = 90
      CooldownFrames = 210
      Look = Hasted
      MaxRank = 1
      Icon = icons/stats/stat_speed.png
      Blurb = Bir o'likni bir necha soniya ancha tezroq urdiradi.
      Name = Shiddat
    End,
    Skill
      Key = E
      Effect = HEAL
      Heal = 40
      HealBelowPercent = 70
      Range = 100
      WindUpFrames = 20
      Projectile = MendingLight
      CooldownFrames = 150
      MaxRank = 1
      Icon = icons/stats/stat_health.png
      Blurb = Yarador o'likning jonini to'ldiradi.
      Name = "O'lik nafasi"
    End
  ]
End

; A cleared cave's mouth stopped with a rock as the world is laid (Cave's Seal, DungeonRun.sealCaves): nobody's, no
; harm, no death (an UNYIELDING, as a grave) -- the cave is seen sealed.
Monster
  Name = CaveSeal
  DisplayName = "Muhrlangan g'or"
  Geometry = Cylinder
    Radius = 5
    Height = 14
  End
  VisionRange = 0
  Modules = [
    GrowableBody
      MaxHealth = 100
    End,
    SkillBook
    End,
    StatusUpdate
    End
  ]
  MinDepth = 99
  Weight = 0
  Colour = 0x5A544C
  Scale = 1
  Model = models/nature/rocks/rock_tall_c.glb
  ModelScale = 7
  Tint = 0x5A544C
  Skills = [
    Skill
      Key = Q
      Effect = UNYIELDING
      HealBelowPercent = 1
      MaxRank = 1
      Name = "Tosh"
    End
  ]
End
