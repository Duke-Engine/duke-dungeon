      MaxRank = 1
      Icon = icons/stats/stat_attack.png
      Blurb = Atrofidagi o'zinikilar qattiqroq uradi.
      Name = "G'azab"
    End
  ]
End

; CAMP BOSS: a wyvern of the peaks, breathing frost that freezes.
Monster
  Name = Wyvern
  DisplayName = "Qor ajdari"
  KindOf = [INFANTRY, SELECTABLE, CAN_ATTACK]
  Geometry = Cylinder
    Radius = 8
    Height = 20
  End
  VisionRange = 130
  Modules = [
    GrowableBody
      MaxHealth = 560
    End,
    MoveUpdate
      Speed = 15
      TurnRate = 0
    End,
    WeaponUpdate
      Damage = 24
      AttackRange = 16
      ReloadFrames = 17
      ; The swing up to the blow (MonsterClipFitTest), taken off ReloadFrames.
      PreAttackFrames = 17
    End,
    Swing
    End,
    SkillBook
    End,
    StatusUpdate
    End,
    MonsterBrain
    End,
    ExperienceModule
      ExperienceValue = 160
      ExperienceRequired = [0, 0, 0]
    End
  ]

  SenseRadius = 60
  ChaseRadius = 150
  CloseDistance = 4
  AlertRadius = 110
  RepathFrames = 8
  SwingFrames = 14
  ; Never on a floor of the descent: the open world places it by name.
