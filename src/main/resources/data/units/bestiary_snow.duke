  Colour = 0xC8B890
  Scale = 1.67
  Model = models/bestiary/wyvern.glb
  ModelScale = 5.19
  Idle = Idle
  Walk = Walk
  Attack = Attack
  Death = Death
  ; How far one play of its walk carries it, measured off the clip (MonsterClipFitTest).
  WalkStride = 0

  Skills = [
    Skill
      Key = W
      ; Thrown down a line, bursting where it stops: it can be stepped out of.
      Effect = SKILLSHOT
      Damage = 40
      Range = 70
      Radius = 16
      HitWidth = 6
      ProjectileSpeed = 120
      Projectile = SkullFireball
      StunFrames = 30
      CooldownFrames = 210
      MaxRank = 1
      Name = Muz nafasi
    End,
    Skill
      Key = Q
      ; Strikes faster for five seconds -- itself, or the sturdiest of its own near it.
      Effect = HASTE
      BoostPercent = 40
      DurationFrames = 150
      Range = 50
      CooldownFrames = 300
      Look = Hasted
      MaxRank = 1
      Icon = icons/stats/stat_speed.png
      Blurb = Bir necha soniya ancha tezroq uradi.
      Name = Shiddat
    End
  ]
End
