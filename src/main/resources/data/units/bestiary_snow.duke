    End,
    WeaponUpdate
      Damage = 22
      AttackRange = 13
      ReloadFrames = 33
      ; The swing up to the blow (MonsterClipFitTest), taken off ReloadFrames.
      PreAttackFrames = 7
    End,
    Swing
    End,
    SkillBook
    End,
    StatusUpdate
    End,
    MonsterBrain
    End,
    ExperienceModule
      ExperienceValue = 34
      ExperienceRequired = [0, 0, 0]
    End
  ]

  SenseRadius = 45
  ChaseRadius = 95
  CloseDistance = 4
  AlertRadius = 70
  RepathFrames = 10
  SwingFrames = 14
  ; Never on a floor of the descent: the open world places it by name.
  MinDepth = 99
  Weight = 0
  Colour = 0xA8D0F0
  Scale = 1.33
  Model = models/wilds/goleling.glb
  ModelScale = 10.31
  Tint = 0xA8D0F0
  Idle = Idle
  Walk = Walk
  Attack = Attack
  Death = Death
  ; How far one play of its walk carries it, measured off the clip (MonsterClipFitTest).
  WalkStride = 0
  ; The licensed look (CGTrader Royalty Free, licensed-assets/ only; see CREDITS.md) where it is
  ; shipped, the look above where it is not.
  Licensed = MonsterLook
    Model = models/licensed/golem.glb
    ModelScale = 6.54
    Texture = models/licensed/golem_ice.png
    Tint = 0xFFFFFF
    Idle = Idle
    Walk = Walk
    Attack = Attack
    Death = Death
    WalkStride = 12.2
  End

  Skills = [
    Skill
      Key = R
      ; Its hide turns aside a share of every blow.
      Effect = DRAGON_BLOOD
      BoostPercent = 30
      Heal = 0
      MaxRank = 1
      Name = Tosh teri
    End
  ]
End

