Hero
  Name = Rogue
  ; The template name is Rogue — it is what the spawner, his four Skill
  ; blocks and every test call him. It was
  ; "Hero" while he was the only one, which stopped being a name the moment there
  ; were three of them and became a category with one member in it.
  ;
  ; DisplayName is what the PLAYER is told he is called, and is a different
  ; question entirely: the template is which creature, this is who.
  DisplayName = Erika
  KindOf = [INFANTRY, SELECTABLE, CAN_ATTACK]
  Geometry = Cylinder
    Radius = 4
    Height = 12
  End
  ; How far he sees — and, because it is the same number, how far the dungeon
  ; opens up around him. Everything beyond it is black: not the walls, not the
  ; floor, not what is standing on it. This used to be 600, which reaches the far
  ; corner of a 500x360 map, so the whole floor was laid out in front of the
  ; player before he took a step and there was nothing to discover.
  ;
  ; Further than anything down here can sense him — the largest is 55 — because
  ; an archer who cannot see past the range at which he is noticed has no range
  ; at all. He opens the exchange; they answer it.
  VisionRange = 70
  Modules = [
    ; HeroBody rather than the engine's ActiveBody: this one can grow, because the
    ; whole game is him becoming harder to kill. See uz.dukeengine.rpg.hero.
    GrowableBody
      ; ★ BEFORE HIS STRENGTH, whose ten points at twelve apiece go on as the body
      ; is built -- 550 in all, low enough that a careless walk into a second room
      ; can end the run.
      MaxHealth = 430
    End,
    MoveUpdate
      ; ★ Before his agility: 27.2 and twelve points at 0.15 are 29.
      Speed = 27.2
      ; 0 = turn on the spot. TurnRate is SAGE's tank parameter: a positive rate
      ; makes a thing rotate toward its goal and curve along its facing, which is
      ; right for a vehicle and wrong for a man — sent back the way he came, the
      ; hero drove a wide arc instead of turning round.
      TurnRate = 0
    End,
    WeaponUpdate
      ; ★ Before agility, which is his primary and adds all twelve of its points:
      ; 14 an arrow.
      Damage = 2
      ; A bow, and it is now free of VisionRange above rather than kept politely
      ; below it. It used to have to stay inside his sight, because nothing checked
      ; the distance and the two numbers were left to keep each other honest; miss
      ; that and he shot into the dark at things the fog had never shown him.
      ; EyesOnly checks it — near enough, nothing between, nothing standing higher
      ; — so this may be raised as far as the fight wants it.
      ;
      ; Longer than any monster's SenseRadius (the largest is 55), so he can open
      ; fire on something that has not noticed him. Everything down here reaches 8
      ; to 14 with its own weapon, so he outranges the dungeon many times over:
      ; that is the whole shape of playing him — he wins at distance and loses the
      ; moment anything arrives.
      ;
      ; Shooting is not free, though. A monster that is hit comes for whoever hit
      ; it from wherever it is standing, sense radius or no sense radius — see
      ; MonsterBrain. The first arrow starts the fight; it does not avoid it.
      AttackRange = 60
      ; Slower than a fist was. A longbow that fired twice a second would make the
      ; range free rather than earned.
      ReloadFrames = 24
      ; A bow is drawn standing still. He walks or he shoots, never both — which is
      ; what makes his range something he has to hold rather than something he keeps
      ; while retreating for ever. He carries on reloading on the way, and keeps
      ; whatever he was pointed at, so the shot leaves the moment he stops.
      AttackOnTheMove = No
    End,
    ; His shots leave the bow and have to get there — see uz.dukeengine.rpg.fight.
    Bow
    End,
    ; He shoots at what he can see. This also switches the engine's own target
    ; acquisition off for him -- it is a nearest-enemy search that knows nothing
    ; about walls -- and hands the choosing to HeroBrain, which does. Monsters do
    ; not carry it: they fight at arm's length, with nothing in between.
    EyesOnly
    End,
    ; Walks to whatever he is told to attack — see HeroBrain.
    HeroBrain
    End,
    ; Timers for the statuses he wears, as every monster carries -- a stun, so
    ; far: the engine's DISABLED, for as long as whatever stunned him says. His
    ; legs and his bow stand still under it and his skills refuse (SkillBook.cast);
    ; this counts it down and takes it off.
    StatusUpdate
    End,
    ; Her book holds the mechanics the game needs of her, no skills of her own: see Skills at the end of this file.
    SkillBook
    End,
    ; Health coming back on its own, at the rate his Hero block names.
    Recovery
    End,
    ; His roll (Space) and his run when Shift is held: see the Dodge skill and the Controls block.
    Dodge
    End,
    Sprint
    End,
    ; Counts what he kills. He is worth nothing himself, and the engine's own four
    ; ranks are switched off (0 0 0), leaving a plain experience total for the game
    ; to spend on levels of its own devising.
    ExperienceModule
      ExperienceValue = 0
      ExperienceRequired = [0, 0, 0]
    End
  ]


; ---------------------------------------------------------------------------
; The hero.
;
; A different creature kit from the monsters, on a different skeleton, and the
; only thing here that carries something in its hand.
;
; He used to be described one file per movement, because an animation site hands
; its work out that way and every one of those files carries the same
; exporter-generated clip name inside it -- so the FILE was the only thing saying
; which was the run. A character KIT is the other way round: a few libraries,
; each holding dozens of clips under names that mean something. So he is named
; the way the monsters are, and moves by the same set they do: Humanoid, in
; data/animations/, whose files the kit sorts by what the movement is for.
;
; Facing turns the model's forward onto the engine's. A quarter out and he walks
; sideways, a half out and he moonwalks — so it is here rather than in Java, and
; correcting it is an edit.
;
; Naming no Model puts him back to a coloured capsule.
;
; The block's name is the CREATURE TEMPLATE it describes, and it
; is the same word his Skill blocks are headed with. Repeatable: a second
; hero is a file like this one and a line in the game's Files (data/game.duke), and no
; Java. It used to be a single unnamed block whose fields were written straight
; onto the settings, so a second one would have quietly overwritten the first.
; ---------------------------------------------------------------------------

  ; ★ THE HUNTRESS. neilhancart's "Huntress" (CC BY 4.0 -- see CREDITS.md), the
  ; heroine of the campaign and the one who beats the last of it: a grown woman
  ; in leather and steel among the kit's chibis, which is the point -- she is
  ; who the story is about. Made from Sketchfab's statue of her by
  ; art/huntress/export_huntress.py (./gradlew exportHuntress): pedestal and
  ; banner off, 24k triangles, her skeleton cut to 62 bones.
  ;
  ; The KayKit rogue he wore before (models/characters/heroes/rogue.glb) is kept for the
  ; kingdom's soldiers.
  Model = models/characters/heroes/huntress.glb
  ; Written 2.180 tall, the KayKit rogue's height, so the 12 / 2.180 that stood
  ; him twelve units tall stands her the same.
  ModelScale = 5.50
  ; And facing the way the KayKit heroes face, so the same quarter turn.
  Facing = 90

  ; Her own set, not Humanoid: her skeleton is not the kit's, so the kit's clips
  ; are retargeted onto it and kept in her own library -- see
  ; data/animations/huntress.duke. Every name below is the KayKit one.
  Animations = Huntress

  ; Standing with the bow rather than empty-handed, because he is holding one.
  Idle = Ranged_Bow_Idle
  ; He moves at 45 against a monster's 24 -- a walk cycle at that speed reads as
  ; skating, so he runs.
  Walk = Running_A
  ; How far one play of it carries her, in units, so the client paces it to her speed and
  ; her feet stay where they land. Measured off the clip by HeroClipFitTest.
  WalkStride = 28.5
  ; The loose, not the draw: the arrow leaves at the start of this clip, which is
  ; the frame the simulation fires on. Cut to 0.79s by her exporter (CUT), inside her
  ; 0.8s between shots, so no shot is cut short by the next. Ranged_Bow_Draw is the other half of the
  ; shot if that reads better -- one word here, and one name in CLIPS in her
  ; exporter, which is the list of what is retargeted onto her.
  Attack = Ranged_Bow_Release
  ; His flinch: played only as he staggers at a heavy blow, for exactly its frames (his STAGGER,
  ; the last of his Skills), when he cannot strike -- so it never covers a swing he really makes.
  Hurt = Hit_Chest
  ; Death_A falls in 0.8s; Death_B takes 2.6s, which is longer than the floor
  ; stays open after he dies.
  Death = Death_A
  ; A flinch taken on the move plays from her spine up, her legs running on.
  UpperBody = QuickRigCharacter_Spine_012

  Held = [
    ; nodgerty's elven bow ("Elven Assassin Weapon Set", CC BY 4.0 -- see CREDITS.md),
    ; in her left fist on handslot.l: a bone her exporter puts where her curled fingers
    ; close round the bow's grip, along her knuckles, riding her hand in every clip (see
    ; fist in art/huntress/export_huntress.py). The bow is laid out as the kit's bow was
    ; (art/weapons/export_weapons.py): 1.98 long along its own +Z, its grip on the origin.
    ;
    ; The bow goes in the LEFT hand because the right draws the string.
    Held
      Model = models/items/weapons/elven_bow.glb
      Bone = handslot.l
      ; 1.98 long against her 2.18: at 0.8 it is three quarters of her, a hunting bow
      ; rather than a longbow.
      Scale = 0.8
      ; Half a turn about its own length: its grip bulges toward +x and its string is
      ; the straight line on -x, and the bone points +x at the archer -- so turned,
      ; the string is toward her drawing hand and her knuckles are on the grip.
      Roll = 180
    End,

    ; ★ AND ITS DAGGER, on her left hip -- her quiver and arrows are her own, on the
    ; right. sheath.l is a bone her exporter hangs from her hips pointing down the
    ; outside of her thigh; a held thing runs along its +Y, so the dagger's blade (its
    ; own +Y) points down it, the flat against her leg. Made 0.55 long, a quarter of her.
    Held
      Model = models/items/weapons/elven_dagger.glb
      Bone = sheath.l
      Scale = 1
    End
  ]

  ; He stops here and shoots, well inside the 60 his bow reaches. This is the
  ; number that decides how he is played: lower it towards 4 and he walks into
  ; everything and brawls, which is what he used to do.
  CloseDistance = 48

  ; What the panel calls him under his name. His own rather than the panel's: one
  ; line in the Hud section was right while there was one hero, and became the
  ; archer's title on a knight the moment there were two.
  Title = O'q ustasi
  ; ★ WHAT HE IS MADE OF -- see Attributes in the World block. A line an attribute: which, what
  ; he starts with, what a level adds. AGILITY is his primary: it is his speed and
  ; the weight of his arrow both, and it grows fastest. At the first level these make
  ; exactly the archer he always was: 430 + 10 x 12 = 550 health,
  ; 27.2 + 12 x 0.15 = 29 speed, 2 + 12 = 14 an arrow.
  Primary = AGI
  Attributes = [
    Attribute
      Name = STR
      Base = 10
      Growth = 0.4
    End,
    Attribute
      Name = AGI
      Base = 12
      Growth = 0.6
    End,
    Attribute
      Name = INT
      Base = 8
      Growth = 0.3
    End
  ]
  ; ★ WHAT HE CASTS OUT OF, before his intelligence: 40 + 8 x 5 = 80.
  MaxMana = 40
  ; ★ WHAT COMES BACK ON ITS OWN, in TENTHS of a point a second -- 15 is 1.5. Fixed:
  ; no attribute moves either, and slow on purpose. A pool that refills in a
  ; breath is a second cooldown; one that takes a minute is one he spends with care.
  ManaRegen = 15
  HealthRegen = 15


; The hero's own, because two of his states are things no monster has: a bow held
; ready, and a flourish for a new level. His clips come out of the Huntress
; set he links above. Each is one word to change — worth trying:
; Idle_A / Idle_B / Ranged_Bow_Aiming_Idle for the standing ones, Death_B for a
; slower fall (2.6s, longer than the floor stays open), Interact / Throw /
; Ranged_Bow_Draw_Up for the flourish -- and, on the Huntress, a name in CLIPS in
; art/huntress/export_huntress.py, since only what is retargeted onto her is there.
  ; Standing with the bow, as he stands in the world.
  Portrait = PortraitArt
    Calm = Ranged_Bow_Idle
    ; Drawn and waiting rather than loosing: he "has a target" for a whole
    ; engagement, so a release clip here would have him shooting continuously and
    ; none of it would be a shot.
    Fight = Ranged_Bow_Aiming_Idle
    ; Quaternius' plain idle, run faster — see HurtSpeed above.
    Hurt = Idle_Loop
    ; Quaternius' fall, 2.4s: too long for the floor (Death above stays Death_A), not for the panel.
    Dead = Death01
    ; Rising out of the ground, which reads as power arriving.
    LevelUp = Spawn_Ground

    ; ★ Re-measured for the Huntress. The KayKit numbers framed a chibi, whose head
    ; is two fifths of him; hers is an eighth of her. Her head joint stands at 0.91
    ; of her 2.18 and her eyes at 0.93, so the camera aims a little under her eyes
    ; and shows three tenths of her height: head, shoulders and the top of her
    ; armour. A guess from the file, not yet a look in the game -- these two are
    ; the ones to nudge.
    Head = 0.88
    Show = 0.30
    Yaw = 22
    Pitch = -4
    Fov = 34
    HurtBelowPercent = 30
    HurtSpeed = 1.5
  End

  ; ---------------------------------------------------------------------------
  ; She has no skills to buy or cast (the owner, 2026-11-04: the heroes fight with their blows and attack
  ; combinations, skills are the enemies'). What is left in her book is mechanics the game itself needs: her
  ; dodge (Space, the Dodge module), her stagger, her horse (T) and the landing's shockwave (the story casts it).
  ; ---------------------------------------------------------------------------
  Skills = [
    Skill
      ; His dodge, no slot of any bar: pressed on Space (Main.dodge), never bought, his from the start. The Dodge
      ; module of his Modules does it: a roll of Distance toward the way he runs (or faces) over DurationFrames
      ; (0.3s), out of harm's way its first TickFrames (0.23s: no blow takes health or staggers him), through
      ; creatures, short of stone, refused over a seal or while held. Every 2.5 seconds, no mana.
      ; Quaternius' UAL Roll, retargeted onto her rig with her other clips.
      Key = V
      Effect = MODULE
      Distance = 16
      DurationFrames = 9
      TickFrames = 7
      CooldownFrames = 75
      CastAnim = Roll
      MaxRank = 1
      Name = Chetlanish
    End,
    Skill
      ; His stagger, no slot of the four: never bought, never drawn on his bar, his from the start. A
      ; blow of Damage or more after his armour -- his HeavyBlow's MajorAt in world/feel.duke, what
      ; knocks the screen -- or any critical one stuns him StunFrames (0.37s: his wind-up starts over
      ; after it, his reload waits, no skill casts), his CastAnim (his Hurt) playing for exactly those
      ; frames; and none takes him again for DurationFrames (1.2s) after, so a crowd cannot hold him.
      ; The owner, 2026-10-15: "while the hero flinches he must not attack". Staggered on the move, he
      ; is drawn standing at his flinch and walks on with his order when it ends (E73).
      Key = X
      Effect = STAGGER
      Damage = 35
      StunFrames = 11
      DurationFrames = 36
      CastAnim = Hit_Chest
      MaxRank = 1
    End,
    Skill
      ; His horse, no slot of the four: pressed on T (data/world/mounts.duke), never bought, his from the
      ; start, once he owns a horse (its whistle). Up onto it over WindUpFrames (0.6s), his reach played; a
      ; step or a blow calls it off. Then he rides, BoostPercent quicker, drawn as RogueRiding on the horse's
      ; Saddle bone (E88), his weapon holding fire; off at a second press, a blow (EndsOnHurt), an attack
      ; he orders, a skill (the game gets him off and casts nothing), or a town or an indoor map (NotIn:
      ; the zones the game names, Ichkari for every map that is not out of doors).
      Key = T
      Effect = MOUNT
      ; Up again as soon as he is off: no wait between.
      CooldownFrames = 1
      WindUpFrames = 18
      CastAnim = Gather
      BoostPercent = 100
      Look = RogueRiding
      EndsOnHurt = Yes
      NotIn = [Ichkari, Poytaxt, Olmazor, "Bog'iston", Qoratepa, Tolzor, Yangiobod]
      MaxRank = 1
      Name = Ot
      Icon = icons/items/loot/horse_common.png
    End,
    Skill
      ; The landing's shockwave (docs/plan/2026-10-15-seamless-campaign.md, section 4.3): no key of his, cast by the
      ; story as he comes down in the meteor (CAST PUSH at the landing) -- every enemy within Radius thrown Distance
      ; out over DurationFrames along an arc HitWidth high, stunned StunFrames as it lands (E82). Off his bar, as his
      ; stagger is.
      Key = Y
      Effect = PUSH
      Radius = 160
      Distance = 50
      DurationFrames = 20
      HitWidth = 18
      StunFrames = 90
      Look = Thrown
      MaxRank = 1
      Name = "Qo'nish zarbasi"
    End
  ]
End
