; ---------------------------------------------------------------------------
; The open world's ordinary people (maps/world, stage/WorldMapWriter): the
; villagers of the villages along its roads, the travellers and the pedlar who
; walk between them, and the keepers of its watchtowers. Like the merchant and
; the commander they stand on the engine's neutral side, have no Body and are
; never drawn into a floor (Weight 0). Who says what is data/story/villages.duke.
;
; Their looks are the realistic working folk of the workspace's models (villager, farmer, traveller, pedlar, tower_keeper), on the game rig.
; ---------------------------------------------------------------------------

; A villager, who strolls about her village.
Monster
  Name = Villager
  DisplayName = "Qishloqi"
  KindOf = [INFANTRY, SELECTABLE]
  Geometry = Cylinder
    Radius = 4
    Height = 12
  End
  VisionRange = 0
  Modules = [
    MoveUpdate
      Speed = 8
      TurnRate = 0
    End
  ]
  MinDepth = 99
  Weight = 0
  Colour = 0xA88C68
  Scale = 1.0
  ; Realistic since 2026-11-05: the workspace's models/villager on the game rig, its clips in its file, 1 m = 6.667 units.
  Model = models/characters/realistic/villager.glb
  ModelScale = 6.667
  Facing = 90
  Idle = Idle
  Walk = Walk
  ; How far one play of Walk carries it, ESTIMATED off the clip's foot travel (MonsterClipFitTest has not measured it): its feet stay put.
  WalkStride = 7.71
  Attack = Attack
  Death = Death
  UpperBody = spine_01
End

