; The enemy army's commander: STAND-IN look (the skeleton warrior, larger and darkened, with an axe).
; He cannot be killed by the hero, only beaten — his UNYIELDING below — for it is the commander who
; cuts him down (the story's KILL). He is raised again in the interlude.
Monster
  Name = EnemyCommander
  DisplayName = "Dushman sarkardasi"
  KindOf = [INFANTRY, SELECTABLE, CAN_ATTACK]
  Geometry = Cylinder
    Radius = 6
    Height = 18
  End
  VisionRange = 120
  Modules = [
    GrowableBody
      MaxHealth = 240
    End,
    MoveUpdate
      Speed = 16
      TurnRate = 0
    End,
    WeaponUpdate
      Damage = 9
      AttackRange = 12
      ReloadFrames = 34
    End,
    Swing
    End,
    SkillBook
    End,
    StatusUpdate
    End,
    MonsterBrain
    End,
    ExperienceModule
      ExperienceValue = 120
      ExperienceRequired = [0, 0, 0]
    End
  ]
  SenseRadius = 70
  ChaseRadius = 220
  CloseDistance = 4
  AlertRadius = 100
  RepathFrames = 8
  SwingFrames = 18
  MinDepth = 99
  Weight = 0
  Colour = 0x803040
  Scale = 1.6
  Model = models/monsters/skeleton_warrior.glb
  Animations = Humanoid
  Effect = EmberEyes
  ModelScale = 8.3
  Tint = 0x7A4A5A
  Held = Held
    Model = models/monsters/axe.gltf
    Bone = handslot.r
    Scale = 1.2
  End
  Skills = [
    Skill
      Key = Q
      Effect = UNYIELDING
      HealBelowPercent = 40
      MaxRank = 1
      Name = "Yiqiladi, o'lmaydi"
    End
  ]
End

; The villain of Act 1: the lord of the dark castle — an earlier hero the queen cursed (the
