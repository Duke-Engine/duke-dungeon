; ---------------------------------------------------------------------------
; Act 1's people and fighters — see docs/plan/2026-10-15-act1.md and data/story/act1.duke.
;
; Every name and look here is a STAND-IN until the owner chooses (docs/plan/2026-10-15-big-plan.md,
; "Standing items"): the commander, the queen, the two townsfolk, the enemy commander and the
; castle's lord are named for what they are, and dressed in the KayKit sets the game already
; ships (CC0) and panarth's medieval weapons (CC BY 4.0). None of them is ever drawn into a
; floor (MinDepth 99, Weight 0): a map or a trigger puts them.
; ---------------------------------------------------------------------------

; The kingdom's commander in Act 1. STAND-IN name ("Qo'mondon") and look (the KayKit ranger,
; as the talk demo's commander): a person on the neutral side, with legs for WALK.
Monster
  Name = Act1Commander
  DisplayName = "Qo'mondon"
  KindOf = [INFANTRY, SELECTABLE]
  Geometry = Cylinder
    Radius = 4
    Height = 12
  End
  VisionRange = 0
  Modules = [
    MoveUpdate
      Speed = 18
      TurnRate = 0
    End
  ]
  MinDepth = 99
  Weight = 0
  Colour = 0xE8C15A
  Scale = 1.0
  Model = models/heroes/ranger.glb
  ; A little warmer than the talk demo's commander, so the two kinds are not drawn alike.
  Tint = 0xF0D8C0
  ModelScale = 5.5
  Facing = 90
  Animations = Humanoid
  Held = Held
    Model = models/weapons/medieval/sword.glb
    Bone = handslot.r
  End
End

