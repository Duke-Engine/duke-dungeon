  Name = Soldier
  DisplayName = Askar
  KindOf = [INFANTRY, SELECTABLE, CAN_ATTACK]
  Geometry = Cylinder
    Radius = 4
    Height = 12
  End
  VisionRange = 80
  Modules = [
    GrowableBody
      MaxHealth = 70
    End,
    MoveUpdate
      Speed = 17
      TurnRate = 0
    End,
    WeaponUpdate
      Damage = 6
      AttackRange = 10
      ReloadFrames = 13
      ; The swing up to the blow (MonsterClipFitTest): the client starts its attack as it winds up,
      ; and the blow lands as the clip strikes. Taken off ReloadFrames, so it hits as often as before.
      PreAttackFrames = 17
    End,
    Swing
    End,
    SkillBook
    End,
    StatusUpdate
    End,
    MonsterBrain
    End,
    ExperienceModule
      ExperienceValue = 10
      ExperienceRequired = [0, 0, 0]
    End
  ]
  SenseRadius = 60
  ChaseRadius = 120
  CloseDistance = 4
  AlertRadius = 70
  RepathFrames = 10
  SwingFrames = 12
  Idle = Melee_Blocking
  Attack = Melee_1H_Attack_Chop
