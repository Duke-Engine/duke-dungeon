; The kingdom's soldiers: KayKit adventurers fighting for the hero — the ALLY act puts them on his
; side, and they fight as any monster does (MonsterBrain), for him. A knight with a sword...
Monster
  Name = Soldier
  DisplayName = Askar
  KindOf = [INFANTRY, SELECTABLE, CAN_ATTACK]
  Geometry = Cylinder
    Radius = 4
    Height = 12
  End
  VisionRange = 80
  Modules = [
    GrowableBody
      MaxHealth = 70
    End,
    MoveUpdate
      Speed = 17
      TurnRate = 0
    End,
    WeaponUpdate
      Damage = 6
      AttackRange = 10
      ReloadFrames = 30
    End,
    Swing
    End,
    SkillBook
    End,
    StatusUpdate
    End,
    MonsterBrain
    End,
    ExperienceModule
      ExperienceValue = 10
      ExperienceRequired = [0, 0, 0]
    End
  ]
  SenseRadius = 60
  ChaseRadius = 120
  CloseDistance = 4
  AlertRadius = 70
  RepathFrames = 10
  SwingFrames = 12
  Idle = Melee_Blocking
  Attack = Melee_1H_Attack_Chop
  MinDepth = 99
  Weight = 0
  Colour = 0x4A7AC8
  Scale = 1.0
  Model = models/heroes/knight.glb
  ModelScale = 4.72
  Facing = 90
  Animations = Humanoid
  Held = Held
    Model = models/weapons/medieval/sword.glb
    Bone = handslot.r
  End
End

