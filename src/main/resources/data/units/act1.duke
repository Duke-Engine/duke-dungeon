; ---------------------------------------------------------------------------
; Act 1's people and fighters — see docs/plan/2026-10-15-act1.md and data/story/act1.duke.
;
; Every name and look here is a STAND-IN until the owner chooses (docs/plan/2026-10-15-big-plan.md,
; "Standing items"): the commander, the queen, the two townsfolk, the enemy commander and the
; castle's lord are named for what they are, and dressed in the KayKit sets the game already
; ships (CC0) and panarth's medieval weapons (CC BY 4.0). None of them is ever drawn into a
; floor (MinDepth 99, Weight 0): a map or a trigger puts them.
; ---------------------------------------------------------------------------

; The kingdom's commander in Act 1. STAND-IN name ("Qo'mondon") and look (the KayKit ranger,
; as the talk demo's commander): a person on the neutral side, with legs for WALK.
Monster
  Name = Act1Commander
  DisplayName = "Qo'mondon"
  KindOf = [INFANTRY, SELECTABLE]
  Geometry = Cylinder
    Radius = 4
    Height = 12
  End
  VisionRange = 0
  Modules = [
    MoveUpdate
      Speed = 18
      TurnRate = 0
    End
  ]
  MinDepth = 99
  Weight = 0
  Colour = 0xE8C15A
  Scale = 1.0
  Model = models/characters/heroes/ranger.glb
  ; A little warmer than the talk demo's commander, so the two kinds are not drawn alike.
  Tint = 0xF0D8C0
  ModelScale = 5.5
  Facing = 90
  Animations = Humanoid
  ; Moves at a jog, not a walk: Running_A at about its own pace rather than Walking_A several times over.
  Walk = Running_A
  ; How far one play of its walk carries it, measured off the clip (MonsterClipFitTest): its feet stay put.
  WalkStride = 14.83
  UpperBody = spine
  Held = Held
    Model = models/items/weapons/sword.glb
    Bone = handslot.r
  End
End

; The commander with her sword out: who stands beside him through the first wave (act1.duke, FirstWave), on his
; side and fighting. She cannot be killed, only brought to one knee (UNYIELDING); the wave beaten, she is the
; commander again who leads him to the city. Her look is the commander's, a shade apart.
Monster
  Name = Act1CommanderFighter
  DisplayName = "Qo'mondon"
  KindOf = [INFANTRY, SELECTABLE, CAN_ATTACK]
  Geometry = Cylinder
    Radius = 4
    Height = 12
  End
  VisionRange = 90
  Modules = [
    GrowableBody
      MaxHealth = 600
    End,
    MoveUpdate
      Speed = 18
      TurnRate = 0
    End,
    WeaponUpdate
      Damage = 18
      AttackRange = 10
      ReloadFrames = 13
      PreAttackFrames = 17
    End,
    Swing
    End,
    SkillBook
    End,
    StatusUpdate
    End,
    MonsterBrain
    End,
    ExperienceModule
      ExperienceValue = 0
      ExperienceRequired = [0, 0, 0]
    End
  ]
  SenseRadius = 90
  ChaseRadius = 160
  CloseDistance = 4
  AlertRadius = 90
  RepathFrames = 10
  SwingFrames = 12
  Idle = Melee_Blocking
  Attack = Melee_1H_Attack_Chop
  MinDepth = 99
  Weight = 0
  Colour = 0xE8C15B
  Scale = 1.0
  Model = models/characters/heroes/ranger.glb
  Tint = 0xF4DCC4
  ModelScale = 5.5
  Facing = 90
  Animations = Humanoid
  Walk = Running_A
  WalkStride = 14.83
  UpperBody = spine
  Held = Held
    Model = models/items/weapons/sword.glb
    Bone = handslot.r
  End
  Skills = [
    Skill
      Key = Q
      Effect = UNYIELDING
      HealBelowPercent = 30
      MaxRank = 1
      Name = "Yiqiladi, o'lmaydi"
    End
  ]
End

; The queen in Act 1: the licensed queen where it is shipped (below), the KayKit mage tinted violet where not.
