    End,
    StatusUpdate
    End,
    MonsterBrain
    End,
    ExperienceModule
      ExperienceValue = 55
      ExperienceRequired = [0, 0, 0]
    End
  ]

  SenseRadius = 45
  ChaseRadius = 95
  CloseDistance = 4
  AlertRadius = 70
  RepathFrames = 8
  SwingFrames = 14
  ; Never on a floor of the descent: the open world places it by name.
  MinDepth = 99
  Weight = 0
  SkillDistance = [0, 50]
  Colour = 0xD04020
  Scale = 1.5
  Model = models/characters/monsters/blue_demon.glb
  ModelScale = 6.34
  Tint = 0xD04020
  Idle = Idle
  Walk = Walk
  Attack = Attack
  Death = Death
  ; How far one play of its walk carries it, measured off the clip (MonsterClipFitTest).
  WalkStride = 16.6

  Skills = [
    Skill
      Key = Q
      ; Drinks a share of every blow it lands.
      Effect = LIFESTEAL
      BoostPercent = 25
      MaxRank = 1
      Name = "Qon so'rish"
    End,
    Skill
      Key = E
      ; Everyone of its own round it hits harder.
      Effect = DAMAGE_AURA
      BoostPercent = 25
      Radius = 50
      Look = MightAura
      TickFrames = 30
      MaxRank = 1
      Icon = icons/stats/stat_attack.png
      Blurb = Atrofidagi o'zinikilar qattiqroq uradi.
      Name = "G'azab"
    End
  ]
End

