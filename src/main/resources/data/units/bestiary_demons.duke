; ---------------------------------------------------------------------------
; By the queen's castle: imps, demons, cult mages, the fire golem and the demon brute.
; The bestiary (docs/plan/2026-10-15-bestiary.md): WorldMapWriter's Wild camps and roamers place them by name.
; Models: Quaternius (CC0; the zombie ghoul, brute and crawler, the witch and the cult mage CC-BY 3.0 -- see
; CREDITS.md), converted by art/monsters/export_bestiary.py. A Licensed look is a CGTrader Royalty Free model in the
; git-ignored licensed-assets/ (art/monsters/export_licensed_monsters.py), drawn where it is shipped.
; Levels are the walk's from the city, as every monster's in the world: these figures are level 1's.
; ---------------------------------------------------------------------------

; common: a flying imp throwing fire.
Monster
  Name = Shayton
  DisplayName = "Shaytoncha"
  KindOf = [INFANTRY, SELECTABLE, CAN_ATTACK]
  Geometry = Cylinder
    Radius = 3
    Height = 8
  End
  VisionRange = 64
  Modules = [
    GrowableBody
      MaxHealth = 40
    End,
    MoveUpdate
      Speed = 17
      TurnRate = 0
    End,
    WeaponUpdate
      Damage = 6
      AttackRange = 50
      ReloadFrames = 50
      AttackOnTheMove = No
    End,
    Swing
    End,
    SkillBook
    End,
    Bow
      Projectile = Fireball
      Speed = 190
      MuzzleOffset = 8
    End,
    EyesOnly
    End,
    StatusUpdate
    End,
    MonsterBrain
    End,
    ExperienceModule
      ExperienceValue = 11
      ExperienceRequired = [0, 0, 0]
    End
  ]

  SenseRadius = 64
  ChaseRadius = 120
  CloseDistance = 6
  AlertRadius = 70
  RepathFrames = 10
  SwingFrames = 14
  ; Never on a floor of the descent: the open world places it by name.
  MinDepth = 99
  Weight = 0
  KeepDistance = [25, 45]
  Colour = 0xC8B890
  Scale = 0.67
  Model = models/characters/monsters/imp.glb
  ModelScale = 4.77
  Idle = Idle
  Walk = Walk
  Attack = Attack
  Death = Death
  ; How far one play of its walk carries it, measured off the clip (MonsterClipFitTest).
  WalkStride = 0
End

