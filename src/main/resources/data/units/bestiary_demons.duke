      Key = Q
      ; Rifts round it, and one of its own out of each.
      Effect = SUMMON
      Summons = [Shayton = 3]
      MaxSummoned = 3
      Radius = 16
      DurationFrames = 600
      SummonExperiencePercent = 0
      WindUpFrames = 20
      Projectile = SummoningRift
      CooldownFrames = 420
      MaxRank = 1
      Name = Shaytonlarni chaqirish
    End,
    Skill
      Key = E
      ; Everyone of its own round it hits harder.
      Effect = DAMAGE_AURA
      BoostPercent = 30
      Radius = 50
      Look = MightAura
      TickFrames = 30
      MaxRank = 1
      Icon = icons/stats/stat_attack.png
      Blurb = Atrofidagi o'zinikilar qattiqroq uradi.
      Name = "Do'zax"
    End,
    Skill
      Key = W
      ; Thrown down a line, bursting where it stops: it can be stepped out of.
      Effect = SKILLSHOT
      Damage = 45
      Range = 70
      Radius = 26
