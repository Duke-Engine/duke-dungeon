; The purple one, and it brings more of them. Frail and slow like the other two, with a
; mote of dark for its ordinary shot; its skills open rifts that swordsmen and archers
; climb out of, and make the sturdiest of its own strike faster, and everyone of its own
; round it hits harder -- see Monster SkeletonSummoner and the Q, W and E skills of the
; SkeletonSummoner below.
Monster
  Name = SkeletonSummoner
  DisplayName = Skeleton Summoner
  KindOf = [INFANTRY, SELECTABLE, CAN_ATTACK]
  Geometry = Cylinder
    Radius = 4
    Height = 13
  End
  VisionRange = 64
  Modules = [
    GrowableBody
      MaxHealth = 40
    End,
    MoveUpdate
      Speed = 13
      TurnRate = 0
    End,
    ; For while the rifts come back: a little weaker than the Skeleton Mage's fire, and
    ; reaching the far edge of the same band.
    WeaponUpdate
      Damage = 5
      AttackRange = 58
      ReloadFrames = 60
      AttackOnTheMove = No
    End,
    SkillBook
    End,
    ; Before the Bow, as on the Skeleton Mage: a throw still leaving it holds its rifts.
    Swing
    End,
    Bow
      Projectile = ShadowSpark
      Speed = 95
      MuzzleOffset = 8
    End,
    EyesOnly
    End,
    StatusUpdate
    End,
    MonsterBrain
    End,
    ExperienceModule
      ExperienceValue = 26
      ExperienceRequired = [0, 0, 0]
    End
  ]


  ; The purple one, and it brings more of them. It holds the same band as the other
  ; two, and whenever he is inside its SkillDistance and in plain sight it opens rifts
  ; round itself that skeletons and stalkers climb out of -- toward him first. They last a
  ; while, fall down again, and are worth nothing: kill the summoner, not what it
  ; calls up. After its rifts open, it makes the sturdiest of its own near it strike faster.
  SenseRadius = 64
  ChaseRadius = 120
  ; Unused: it holds the band below rather than closing.
  CloseDistance = 6
  AlertRadius = 70
  RepathFrames = 10
  SwingFrames = 20
  MinDepth = 1
  Weight = 8
  ; One to a room: with its MaxSummoned that is four called up a room at most.
  MaxPerRoom = 1
  Colour = 0xB06AE8
  Scale = 1
  SkillDistance = [20, 70]
  KeepDistance = [35, 55]
  ; The staff-carrier in a robe repainted purple. White tint, so the purple is the
  ; robe's own.
  Model = models/monsters/skeleton_mage.glb
  Animations = Humanoid
  Texture = models/monsters/skeleton_texture_purple.png
  Effect = EmberEyes
  ModelScale = 6.0
  Held = Held
    Model = models/monsters/staff.gltf
    Bone = handslot.r
  End
  Attack = Ranged_Magic_Shoot
  Idle = Ranged_Magic_Spellcasting_Long

  ; What it opens its rifts and hastens out of, in the hero's words and units, as the
  ; Skeleton Mage's: enough to call up its four at its cooldown through a fight of a
  ; minute or more, and to hasten as its trickle allows -- or, beside a healer, whose
  ; aura fills it three times as fast, both at their cooldowns.
  MaxMana = 80
  ManaRegen = 25

  Skills = [
    Skill
      Key = Q
      ; Rifts in the floor round it, and one of its own out of each: toward him first
      ; and then turned aside -- see SummonTurnDegrees in the Combat section -- and only
      ; on open floor it can see.
      Effect = SUMMON
      ; Two swordsmen and two archers a cast, in that order -- where the floor has
      ; room for fewer, the swordsmen are the ones that rise -- and never more than
      ; one cast's worth of its own standing at once: a room with a summoner in it is
      ; a fight that grows, with a ceiling on how far.
      Summons = [Skeleton = 2, Stalker = 2]
      MaxSummoned = 4
      ; How far from it they rise.
      Radius = 16
      ; Twenty seconds, and then they fall down again.
      DurationFrames = 600
      ; Worth nothing: a creature that was never placed on the floor is not a well to
      ; draw experience from.
      SummonExperiencePercent = 0
      ; How long a rift lies open before one climbs out: long enough to be seen.
      WindUpFrames = 20
      Projectile = SummoningRift
      ; Twelve seconds between castings.
      CooldownFrames = 360
      ManaCost = 40
      MaxRank = 1
      Name = Chaqiruv
    End,
    Skill
      Key = W
      ; One of its own made to strike faster: the sturdiest near it -- the highest level,
      ; then the most health, then the nearer -- or itself, when nothing sturdier stands
      ; near. Cast as its summoning is, whenever he is inside its SkillDistance and in
      ; plain sight: after the summoning in a fight, and never in an empty room.
      Effect = HASTE
      ; Three quarters again as fast -- every wait of its weapon divided by 1.75 -- for
      ; five seconds. A second haste while it burns starts the five seconds again.
      BoostPercent = 75
      DurationFrames = 150
      ; How far from it the one it hastens may stand, in its plain sight and never through
      ; the keep's shut gate: past its band, to the ones fighting him.
      Range = 60
      ; The summoning's twelve seconds between castings.
      CooldownFrames = 360
      ManaCost = 25
      ; And the one it hastens wears it for as long -- see the Effect Hasted, below.
      Look = Hasted
      MaxRank = 1
      Name = Shiddat
      ; What the HUD draws over the bar of the one it hastens, while it burns -- when the
      ; player picks that one alone, or points at it -- and its card's line: the stat picture
      ; for speed, until a picture of its own is painted.
      Icon = icons/stats/stat_speed.png
      Blurb = Bir necha soniya ancha tezroq uradi.
    End,
    Skill
      Key = E
      ; Everyone of its own round it -- itself, and what it calls up -- hits half as hard
      ; again: every blow and every skill, within its Radius and in its plain sight, and
      ; never through the keep's shut gate. Never cast: it holds while it stands. Two
      ; summoners lend the stronger, never both.
      Effect = DAMAGE_AURA
      BoostPercent = 50
      ; A room round it, and the ones fighting him from its band.
      Radius = 60
      ; Worn: a thick violet ring as wide as its Radius, and violet sparks flying off its
      ; body, played on it every second -- see the Effect MightAura, below.
      Look = MightAura
      TickFrames = 30
      MaxRank = 1
      Name = Qudrat
      ; What the HUD draws over the bar of one it reaches -- the creature the player picks
      ; alone, or points at -- and its card's line: the stat picture for attack, until a
      ; picture of its own is painted.
      Icon = icons/stats/stat_attack.png
      Blurb = Atrofidagi o'zinikilar qattiqroq uradi, mahoratlari ham kuchliroq.
    End
  ]
End

; ---------------------------------------------------------------------------
; What the one a summoner hastens wears, for as long as the haste: the kit's Focus -- a
; glow round the body, motes rising -- in a fury's red. No layer says how long: the client
; is told the haste's DurationFrames (Main.measureLooks), and a second haste while it
; burns carries it on to the new end (Main.layerOf) -- which is why both are let out as
; they go rather than laid once.
; ---------------------------------------------------------------------------
Effect
  Name = Hasted

  Layers = [
    Layer
      Name = Glow
      Type = AURA
      Texture = kit/effects/particles/light_02.png
      Blend = Additive
      Cover = 0.1
      Count = 5
      Rate = 6
      Life = [0.6, 0.8]
      Size = [20, 22]
      Colour = [0xFF5A3A, 0xD81E12]
      Alpha = [0.35, 0]
      Spin = 30
      Height = 6
    End,

    Layer
      Name = Motes
      Type = AURA
      Texture = kit/effects/particles/star_01.png
      Blend = Additive
      Count = 10
      Rate = 7
      Radius = 6
      Life = [0.8, 1.2]
      Size = [2.4, 0.4]
      Colour = [0xFFB080, 0xFF3020]
      Speed = [2, 5]
      Direction = UP
      Spread = 20
      Height = 1
    End
  ]
End

; ---------------------------------------------------------------------------
; A summoner's might, worn, in violet -- the colour of a might whoever bears it, as a
; mana is blue and a thirst red (the healer's ManaAura and the Revenant's BloodAura are
; this look in theirs). Two layers: a thick, bright ring on the floor as wide as its
; Radius, which says how far it reaches, and sparks flying off the body, which say that
; this is the one that bears it. The summoner plays it on itself every TickFrames (see
; its E), and the client is told it lasts two of them (Main.measureLooks): each ring
; fades in over its first half and out over its second, so the one laid a beat later
; takes over as it goes and the two stand as one steady ring, and the sparks -- an AURA
; layer, let out at a Rate -- are carried on at each beat by Main.layerOf, which renews
; every look worn as a state; until the summoner falls, and the last is gone within two
; seconds. circle_03's brightest line lies at 0.7125 of its half-width -- the sharp edge
; its bright band begins at, with a dim shoulder inside it and the glow fading outward --
; so a size of 2.81 of the reach lays it on the Radius itself: what stands inside the
; ring is lent to. (circle_04 is softer and less than a quarter as bright: no Alpha makes
; it bold.) A rider's Count is at least its Rate times its longest Life, so none is
; overwritten while it still shows.
; ---------------------------------------------------------------------------
Effect
  Name = MightAura

  Layers = [
    Layer
      Name = Ring
      Type = MARK
      Measure = Reach
      Follows = Yes
      Texture = kit/effects/particles/circle_03.png
      Blend = Additive
      Count = 1
      Size = [2.81, 2.81]
      Colour = [0xB06AE8, 0xB06AE8]
      Alpha = [0.55, 0.55]
      FadeIn = 0.5
      FadeOut = 0.5
      Height = 0.3
    End,

    ; Sharp four-pointed glints popping off the body and up to about the head, turning as
    ; they go and each gone inside a second: seven a second, never more than a few at once.
    Layer
      Name = Sparks
      Type = AURA
      Texture = kit/effects/particles/star_07.png
      Blend = Additive
      Count = 8
      Rate = 7
      Radius = 4
      Life = [0.5, 0.9]
      Size = [4.0, 1.0]
      Colour = [0xC080FF, 0xB06AE8]
      FadeIn = 0.1
      Speed = [6, 12]
      Direction = UP
      Spread = 35
      Spin = 90
      Height = 3
    End
  ]
End
