; The purple one, and it brings more of them. Frail and slow like the other two, with a
; mote of dark for its ordinary shot; its skills open rifts that swordsmen and archers
; climb out of, and make the sturdiest of its own strike faster, and everyone of its own
; round it hits harder -- see Monster SkeletonSummoner and the Q, W and E skills of the
; SkeletonSummoner below.
Monster
  Name = SkeletonSummoner
  DisplayName = Skeleton Summoner
  KindOf = [INFANTRY, SELECTABLE, CAN_ATTACK]
  Geometry = Cylinder
    Radius = 4
    Height = 13
  End
  VisionRange = 64
  Modules = [
    GrowableBody
      MaxHealth = 40
    End,
    MoveUpdate
      Speed = 13
      TurnRate = 0
    End,
    ; For while the rifts come back: a little weaker than the Skeleton Mage's fire, and
    ; reaching the far edge of the same band.
    WeaponUpdate
      Damage = 5
      AttackRange = 58
      ReloadFrames = 60
      AttackOnTheMove = No
    End,
    SkillBook
    End,
    ; Before the Bow, as on the Skeleton Mage: a throw still leaving it holds its rifts.
    Swing
    End,
    Bow
      Projectile = ShadowSpark
      Speed = 95
      MuzzleOffset = 8
    End,
    EyesOnly
    End,
    StatusUpdate
    End,
    MonsterBrain
    End,
    ExperienceModule
      ExperienceValue = 26
      ExperienceRequired = [0, 0, 0]
    End
  ]


  ; The purple one, and it brings more of them. It holds the same band as the other
  ; two, and whenever he is inside its SkillDistance and in plain sight it opens rifts
  ; round itself that skeletons and stalkers climb out of -- toward him first. They last a
  ; while, fall down again, and are worth nothing: kill the summoner, not what it
  ; calls up. Its rifts open, it makes the sturdiest of its own near it strike faster.
  SenseRadius = 64
  ChaseRadius = 120
  ; Unused: it holds the band below rather than closing.
  CloseDistance = 6
  AlertRadius = 70
  RepathFrames = 10
  SwingFrames = 20
  MinDepth = 1
  Weight = 8
  ; One to a room: with its MaxSummoned that is four called up a room at most.
  MaxPerRoom = 1
  Colour = 0xB06AE8
  Scale = 1
  SkillDistance = [20, 70]
  KeepDistance = [35, 55]
  ; The staff-carrier in a robe repainted purple. White tint, so the purple is the
  ; robe's own.
  Model = models/monsters/skeleton_mage.glb
  Animations = Humanoid
  Texture = models/monsters/skeleton_texture_purple.png
  Effect = EmberEyes
  ModelScale = 6.0
  Held = Held
    Model = models/monsters/staff.gltf
    Bone = handslot.r
  End
  Attack = Ranged_Magic_Shoot
  Idle = Ranged_Magic_Spellcasting_Long

  ; What it opens its rifts and hastens out of, in the hero's words and units, as the
  ; Skeleton Mage's: enough to call up its four at its cooldown through a fight of a
  ; minute or more, and to hasten as its trickle allows -- or, beside a healer, whose
  ; aura fills it three times as fast, both at their cooldowns.
  MaxMana = 80
  ManaRegen = 25

  Skills = [
    Skill
      Key = Q
      ; Rifts in the floor round it, and one of its own out of each: toward him first
      ; and then turned aside -- see SummonTurnDegrees in the Combat section -- and only
      ; on open floor it can see.
      Effect = SUMMON
      ; Two swordsmen and two archers a cast, in that order -- where the floor has
      ; room for fewer, the swordsmen are the ones that rise -- and never more than
      ; one cast's worth of its own standing at once: a room with a summoner in it is
      ; a fight that grows, with a ceiling on how far.
      Summons = [Skeleton = 2, Stalker = 2]
      MaxSummoned = 4
      ; How far from it they rise.
      Radius = 16
      ; Twenty seconds, and then they fall down again.
      DurationFrames = 600
      ; Worth nothing: a creature that was never placed on the floor is not a well to
      ; draw experience from.
      SummonExperiencePercent = 0
      ; How long a rift lies open before one climbs out: long enough to be seen.
      WindUpFrames = 20
      Projectile = SummoningRift
      ; Twelve seconds between castings.
      CooldownFrames = 360
      ManaCost = 40
      MaxRank = 1
      Name = Chaqiruv
    End,
    Skill
      Key = W
      ; One of its own made to strike faster: the sturdiest near it -- the highest level,
      ; then the most health, then the nearer -- or itself, when nothing sturdier stands
      ; near. Cast as its summoning is, whenever he is inside its SkillDistance and in
      ; plain sight: after the summoning in a fight, and never in an empty room.
      Effect = HASTE
      ; Three quarters again as fast -- every wait of its weapon divided by 1.75 -- for
      ; five seconds. A second haste while it burns starts the five seconds again.
      BoostPercent = 75
      DurationFrames = 150
      ; How far from it the one it hastens may stand: past its band, to the ones
      ; fighting him.
      Range = 60
      ; The summoning's twelve seconds between castings.
      CooldownFrames = 360
      ManaCost = 25
      MaxRank = 1
      Name = Shiddat
    End,
    Skill
      Key = E
      ; Everyone of its own round it -- itself, and what it calls up -- hits half as hard
      ; again: every blow and every skill, within its Radius and in its plain sight.
      ; Never cast: it holds while it stands. Two summoners lend the stronger, never
      ; both.
      Effect = DAMAGE_AURA
      BoostPercent = 50
      ; A room round it, and the ones fighting him from its band.
      Radius = 60
      MaxRank = 1
      Name = Qudrat
    End
  ]
End
