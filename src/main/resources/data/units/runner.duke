Monster
  Name = Runner
  DisplayName = Chopqir
  KindOf = [INFANTRY, SELECTABLE, CAN_ATTACK]
  Geometry = Cylinder
    Radius = 3
    Height = 12
  End
  VisionRange = 85
  Modules = [
    GrowableBody
      MaxHealth = 30
    End,
    MoveUpdate
      ; Faster than the hero, which is the whole point of it: you cannot walk away.
      Speed = 34
      TurnRate = 0
    End,
    WeaponUpdate
      Damage = 4
      AttackRange = 8
      ReloadFrames = 16
      ; The swing up to the blow (MonsterClipFitTest): the client starts its attack as it winds up,
      ; and the blow lands as the clip strikes. Taken off ReloadFrames, so it hits as often as before.
      PreAttackFrames = 6
    End,
    ; Tells the brain the frame a blow landed, so it stands and finishes the swing
    ; instead of walking off mid-blow. It launches nothing -- see Swing.
    Swing
    End,
    ; Every monster carries one, casting or not: a summoner's haste is held in it.
    SkillBook
    End,
    ; Timers for the statuses it is wearing -- the engine's own, and today that
    ; means SLOWED. MoveUpdate already halves the step of anything wearing it, and
    ; StatusUpdate already counts it down and takes it off, so a monster that
    ; carries this thaws by itself whether or not whoever chilled it is still alive.
    StatusUpdate
    End,
    MonsterBrain
    End,
    ExperienceModule
      ExperienceValue = 8
      ExperienceRequired = [0, 0, 0]
    End
  ]


  ; Fast, frail, and comes in numbers. Notices further and gives up later, so a
  ; room of them arrives as a wave rather than a queue.
  SenseRadius = 45
  ChaseRadius = 91
  CloseDistance = 4
  AlertRadius = 70
  RepathFrames = 6
  ; Quick, and quick to recover: the one you cannot walk away from.
  SwingFrames = 8
  MinDepth = 1
  Weight = 30
  Colour = 0xF2C14E
  Scale = 0.75
  ; Realistic since 2026-11-05: the workspace's models/runner on the game rig, its clips in its file, 1 m = 6.667 units.
  Model = models/characters/realistic/runner.glb
  ModelScale = 6.667
  Facing = 90
  Idle = Idle
  Walk = Run
  ; How far one play of Run carries it, measured off the clip (MonsterClipFitTest): its feet stay put.
  WalkStride = 15.57
  Attack = Attack
  Death = Death
  UpperBody = spine_01
End
