End

; ELITE of the wolves: bigger, red, two affixes.
Monster
  Name = BloodWolf
  DisplayName = "Qonxo'r bo'ri"
  KindOf = [INFANTRY, SELECTABLE, CAN_ATTACK]
  Geometry = Cylinder
    Radius = 5
    Height = 12
  End
  VisionRange = 70
  Modules = [
    GrowableBody
      MaxHealth = 150
    End,
    MoveUpdate
      Speed = 23
      TurnRate = 0
    End,
    WeaponUpdate
      Damage = 11
      AttackRange = 11
      ReloadFrames = 12
      ; The swing up to the blow (MonsterClipFitTest): the client starts its attack as it winds up,
      ; and the blow lands as the clip strikes. Taken off ReloadFrames, so it hits as often as before.
      PreAttackFrames = 10
    End,
    Swing
    End,
    SkillBook
    End,
    StatusUpdate
    End,
    MonsterBrain
    End,
    ExperienceModule
      ExperienceValue = 45
      ExperienceRequired = [0, 0, 0]
    End
  ]

  SenseRadius = 45
  ChaseRadius = 95
  CloseDistance = 4
  AlertRadius = 70
  RepathFrames = 10
  SwingFrames = 10
  ; Never on a floor of the descent: the open world's camps place it by name.
  MinDepth = 99
  Weight = 0
  SkillDistance = [0, 50]
  Colour = 0xD04838
  Scale = 1.00
  Model = models/wilds/wolf.glb
  ModelScale = 7
  Tint = 0xD04838
  ; Its own clips, renamed by art/monsters/export_monsters.py.
  Idle = Idle
  Walk = Walk
  Attack = Attack
  Death = Death
  ; How far one play of its walk carries it, measured off the clip (MonsterClipFitTest): its feet stay put.
  WalkStride = 15.56

  Skills = [
    Skill
      Key = Q
      ; Elite affix: drinks a third of every blow it lands.
      Effect = LIFESTEAL
      BoostPercent = 30
      MaxRank = 1
      Name = "Qonxo'r"
    End,
    Skill
      Key = W
      ; Elite affix: strikes faster for five seconds -- itself, or the sturdiest of its own near it.
      Effect = HASTE
      BoostPercent = 60
      DurationFrames = 150
      Range = 50
      CooldownFrames = 300
      Look = Hasted
      MaxRank = 1
      Name = Shiddat
      Icon = icons/stats/stat_speed.png
      Blurb = Bir necha soniya ancha tezroq uradi.
    End
  ]
End

; CAMP BOSS: the camp hits harder round him, and he drinks from his blows.
Monster
  Name = GoblinChief
  DisplayName = "Pakana sardor"
  KindOf = [INFANTRY, SELECTABLE, CAN_ATTACK]
  Geometry = Cylinder
    Radius = 8
    Height = 20
  End
  VisionRange = 130
  Modules = [
    GrowableBody
      MaxHealth = 520
    End,
    MoveUpdate
      Speed = 14
      TurnRate = 0
    End,
    WeaponUpdate
      Damage = 22
      AttackRange = 14
      ReloadFrames = 30
      ; The swing up to the blow (MonsterClipFitTest): the client starts its attack as it winds up,
      ; and the blow lands as the clip strikes. Taken off ReloadFrames, so it hits as often as before.
      PreAttackFrames = 4
    End,
    Swing
    End,
    SkillBook
    End,
    StatusUpdate
    End,
    MonsterBrain
    End,
    ExperienceModule
      ExperienceValue = 140
      ExperienceRequired = [0, 0, 0]
    End
  ]

  SenseRadius = 55
  ChaseRadius = 150
  CloseDistance = 4
  AlertRadius = 110
  RepathFrames = 8
  SwingFrames = 20
  ; Never on a floor of the descent: the open world's camps place it by name.
  MinDepth = 99
  Weight = 0
  Colour = 0xC8B890
  Scale = 1.67
  Model = models/wilds/goblin.glb
  ModelScale = 7
  ; Its own clips, renamed by art/monsters/export_monsters.py.
  Idle = Idle
  Walk = Walk
  Attack = Attack
  Death = Death
  ; How far one play of its walk carries it, measured off the clip (MonsterClipFitTest): its feet stay put.
  WalkStride = 14.07
  UpperBody = Body

  Skills = [
    Skill
      Key = Q
      ; Drinks a quarter of every blow it lands.
      Effect = LIFESTEAL
      BoostPercent = 25
      MaxRank = 1
      Name = Qon so'rish
    End,
    Skill
      Key = E
      ; Elite affix: everyone of its own round it hits a quarter harder.
      Effect = DAMAGE_AURA
      BoostPercent = 25
      Radius = 50
      Look = MightAura
      TickFrames = 30
      MaxRank = 1
      Name = "G'azab"
      Icon = icons/stats/stat_attack.png
      Blurb = Atrofidagi o'zinikilar qattiqroq uradi.
    End
  ]
End
