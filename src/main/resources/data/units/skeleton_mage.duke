; The one that casts. Frail, slow, and dangerous only at a distance: between its
; fireballs it throws the Revenant's small fire, and the fireball is a skill its
; brain decides to throw -- see Monster SkeletonMage and Skill
; SkeletonMage Q below. From its sixth level it calls a meteor down on him too,
; its R.
Monster
  Name = SkeletonMage
  DisplayName = Skeleton Mage
  KindOf = [INFANTRY, SELECTABLE, CAN_ATTACK]
  Geometry = Cylinder
    Radius = 4
    Height = 13
  End
  VisionRange = 64
  Modules = [
    GrowableBody
      MaxHealth = 40
    End,
    MoveUpdate
      ; Slower than any hero, so the one it is backing away from can catch it.
      Speed = 13
      TurnRate = 0
    End,
    ; Its ordinary fire, for while the fireball comes back: weak, and reaching the far
    ; edge of the band it keeps (KeepDistance 35 55), so it is never standing about.
    WeaponUpdate
      Damage = 6
      AttackRange = 58
      ReloadFrames = 54
      AttackOnTheMove = No
    End,
    ; That it has skills. Which ones is its Skill blocks' business, below.
    SkillBook
    End,
    ; Before the Bow, because a shot goes to the first launcher that takes it. Swing
    ; only notes the frame and passes it on, which is how the brain knows a throw is
    ; still leaving and holds its fireball until it has.
    Swing
    End,
    ; The Revenant's small fire, which has to get there.
    Bow
      Projectile = Fireball
      Speed = 190
      MuzzleOffset = 8
    End,
    ; And only at what it can see.
    EyesOnly
    End,
    StatusUpdate
    End,
    MonsterBrain
    End,
    ExperienceModule
      ExperienceValue = 20
      ExperienceRequired = [0, 0, 0]
    End
  ]


  ; The first thing down here that decides for itself. It keeps him at a distance
  ; -- further than he can easily reach it, nearer than it can easily miss -- and
  ; throws a fireball whenever he is inside that and in plain sight, and its small
  ; ordinary fire while the fireball comes back. Frail and slow: it is dangerous
  ; only for as long as he lets it stand back there.
  SenseRadius = 64
  ChaseRadius = 120
  ; Unused: it holds the band below rather than closing, and its ordinary fire
  ; reaches the far edge of that band.
  CloseDistance = 6
  AlertRadius = 70
  RepathFrames = 10
  ; How long a throw holds it still -- the fireball or its ordinary fire -- and the
  ; one waits for the other, so each is seen leaving.
  SwingFrames = 20
  MinDepth = 1
  Weight = 10
  ; No more than two to a room, or a room of them is a firing squad.
  MaxPerRoom = 2
  Colour = 0xFF7A3A
  Scale = 1
  ; It throws when he is at least this far and at most this far, surface to surface.
  SkillDistance = [20, 60]
  ; And it holds him between these: nearer and it backs away, further and it comes.
  KeepDistance = [35, 55]
  ; The staff-carrier again, burning: a warm wash tells it from the pale Revenant
  ; before its fire does.
  Model = models/monsters/skeleton_mage.glb
  Animations = Humanoid
  Effect = EmberEyes
  ModelScale = 6.0
  Held = Held
    Model = models/monsters/staff.gltf
    Bone = handslot.r
  End
  Tint = 0xFF9A6A
  Attack = Ranged_Magic_Shoot
  Idle = Ranged_Magic_Spellcasting_Long

  ; ---------------------------------------------------------------------------
  ; A monster's own skills.
  ;
  ; Headed by the creature's name exactly as a hero's are, and cast by its brain
  ; rather than a key -- the first, in the order written, that its level has
  ; opened, that is ready and that it can pay for: see SkillDistance and
  ; KeepDistance on its Monster block. Each has one rank: what makes it hit
  ; harder further down is its level, as for its weapon. ProjectileSpeed is how
  ; fast what it throws travels; unsaid, it would be the hero's HeavySpeed. It
  ; says 120, which is what HeavySpeed is today, and stays 120 if that moves.
  ;
  ; And it pays for them, as a hero does, out of a pool in the same words and
  ; units: MaxMana in points, ManaRegen in tenths of a point a second -- each a
  ; tenth more a level past the first (ManaPercentPerLevel in generation.duke),
  ; and full when it is placed. Enough to throw at its cooldowns through a fight
  ; of a minute or more, its meteor included, and longer the higher it stands.
  ; Nobody sees the pool: the bar's mana is the hero's alone.
  ; ---------------------------------------------------------------------------
  MaxMana = 60
  ManaRegen = 30

  Skills = [
    Skill
      ; Its ultimate: the Mage's own meteor, from the other side -- a mark on the
      ; floor where he stands, and the blast a second and a half later. It waits
      ; for its sixth level as a hero's ultimate waits for his (LevelPerRank is the
      ; level its one rank opens at), so on the first floor only the fire mages
      ; nearest the keep call it down, and deeper every one does. Written first,
      ; so it is the one its brain casts whenever it is open, ready and paid for;
      ; while it recharges, or its pool is short of it, the fireball follows.
      Key = R
      Effect = METEOR
      ; A hero at the middle of the mark walks out of its 30 in the second and a
      ; half it lies there. The Mage's own is 160 across 44: this is the
      ; monster's, and its level is what makes it hit harder.
      Damage = 90
      Radius = 30
      Range = 70
      WindUpFrames = 45
      ; Its own mark, violet as its fireball is -- data/projectiles/
      ; skull_meteor_mark.duke. Not the Mage's MeteorMark: a mark is drawn as wide
      ; as the skill that throws it, and his is wider.
      Projectile = SkullMeteorMark
      ; Twenty seconds between meteors, and most of its pool: a stunning fireball
      ; under a falling meteor is a hard pair, and its cooldown and its cost keep
      ; it rare.
      CooldownFrames = 600
      ManaCost = 50
      MaxRank = 1
      LevelPerRank = 6
      Name = Meteor
    End,
    Skill
      Key = Q
      ; Its fireball: the Mage's own Q, from something that does not want to be near
      ; him. As fast as his: over its whole Range in a little more than half a second,
      ; so a player who sees it leave the staff has that long at the most to step out
      ; of its line -- and it bursts where it stops, as his does.
      Effect = SKILLSHOT
      ; The one worth stepping out of the way of: its ordinary fire is 6.
      Damage = 45
      Range = 70
      Radius = 16
      HitWidth = 6
      ProjectileSpeed = 120
      Projectile = SkullFireball
      ; And whoever it hurts -- the one it struck and everyone its burst caught --
      ; stands dazed for a second: no step, no blow, no cast. Its ordinary fire
      ; stuns nothing: a stun on every shot of something that throws every two
      ; seconds would hold him still for most of a fight.
      StunFrames = 30
      ; Six seconds between fireballs, with its ordinary fire in between.
      CooldownFrames = 180
      ManaCost = 20
      MaxRank = 1
      Name = Olov shari
    End
  ]
End
