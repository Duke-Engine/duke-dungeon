; The green one, and it fights for the others. Frail and slow like the Skeleton Mage,
; with a spark of light for its ordinary shot; its skills are holy light called down
; on whichever of its own is worst hurt, and every pool of its own round it filling
; faster -- see Monster SkeletonHealer and the Q and W skills of the SkeletonHealer
; below.
Monster
  Name = SkeletonHealer
  DisplayName = Skelet tabib
  KindOf = [INFANTRY, SELECTABLE, CAN_ATTACK]
  Geometry = Cylinder
    Radius = 4
    Height = 13
  End
  VisionRange = 64
  Modules = [
    GrowableBody
      ; The frailest of the three: it is the one to kill first.
      MaxHealth = 36
    End,
    MoveUpdate
      Speed = 13
      TurnRate = 0
    End,
    ; For while the mending comes back: weaker than the Skeleton Mage's fire, and
    ; reaching the far edge of the same band.
    WeaponUpdate
      Damage = 4
      AttackRange = 58
      ReloadFrames = 60
      AttackOnTheMove = No
    End,
    SkillBook
    End,
    ; Before the Bow, as on the Skeleton Mage: a throw still leaving it holds its mending.
    Swing
    End,
    Bow
      Projectile = HolySpark
      Speed = 95
      MuzzleOffset = 8
    End,
    EyesOnly
    End,
    StatusUpdate
    End,
    MonsterBrain
    End,
    ExperienceModule
      ExperienceValue = 22
      ExperienceRequired = [0, 0, 0]
    End
  ]


  ; The green one, and it fights for the others. It holds the same band as the
  ; Skeleton Mage, throws a spark of light while it waits, and whenever one of its
  ; own in plain sight is badly hurt it calls holy light down on him -- the worst
  ; hurt first. It cannot mend itself: kill it first and the room stops mending.
  SenseRadius = 64
  ChaseRadius = 120
  ; Unused: it holds the band below rather than closing.
  CloseDistance = 6
  AlertRadius = 70
  RepathFrames = 10
  SwingFrames = 20
  ; From the first floor, as every mage is. It is the one to kill first there too,
  ; and it stands with every boss: see BossGuards in the Descent block of generation.duke.
  MinDepth = 1
  Weight = 8
  ; One to a room: two would mend each other for as long as the fight lasted.
  MaxPerRoom = 1
  Colour = 0x8FDC6A
  Scale = 1
  KeepDistance = [35, 55]
  ; The staff-carrier in a robe repainted green: its colour says what it does before
  ; its light does. White tint, so the green is the robe's own.
  Model = models/characters/monsters/skeleton_mage.glb
  Animations = Humanoid
  ; Moves at a jog, not a walk: Running_A at about its own pace rather than Walking_A several times over.
  Walk = Running_A
  ; How far one play of its walk carries it, measured off the clip (MonsterClipFitTest): its feet stay put.
  WalkStride = 16.18
  UpperBody = spine
  Texture = models/characters/monsters/skeleton_texture_green.png
  Effect = EmberEyes
  ModelScale = 6.0
  Held = Held
    Model = models/items/gear/skeleton_staff.gltf
    Bone = handslot.r
  End
  Attack = Ranged_Magic_Shoot
  Idle = Ranged_Magic_Spellcasting_Long

  ; What it mends out of, in the hero's words and units, as the Skeleton Mage's:
  ; enough to mend at its cooldown through a fight of a minute or more.
  MaxMana = 50
  ManaRegen = 25

  Skills = [
    Skill
      Key = Q
      ; Holy light, called down on whichever of its own is worst hurt -- counted as a
      ; share of his own health, and only if that is below HealBelowPercent, so it is
      ; never spent on someone who does not need it. Within Range of the healer and in
      ; plain sight of it, and it may not mend itself.
      Effect = HEAL
      ; A third of a Skeleton, a tenth of the Warden: it keeps the rank and file standing
      ; and only slows a boss. It grows with the healer's level, as its blows do.
      Heal = 30
      HealBelowPercent = 60
      Range = 60
      ; The light lies on the floor this long before it lands and mends: long enough to
      ; be seen coming, and to finish off the one it was coming for.
      WindUpFrames = 20
      Projectile = MendingLight
      ; Eight seconds between mendings. Noticeable, and not a wall.
      CooldownFrames = 240
      ManaCost = 25
      MaxRank = 1
      Name = Muqaddas nur
    End,
    Skill
      Key = W
      ; Every pool of its own round it -- its own, a summoner's, a fire mage's -- fills
      ; five points a second faster, within its Radius, through walls or not, and never
      ; through the keep's shut gate: in tenths of a point a second, as a pool's own
      ; trickle. A creature with no pool is given none. Never cast: while it stands it
      ; lends it anew every AuraPulseFrames, and what it lends holds BuffLifeFrames --
      ; see world.duke's Combat block. Two healers lend the stronger.
      Effect = MANA_AURA
      ManaRegen = 50
      ; A room round it, and the ones fighting him from its band.
      Radius = 60
      ; Worn: blue ripples spreading on the floor under its feet, a little wider than its
      ; body, played on it every second -- see the Effect ManaAura, below. Nothing draws how
      ; far it reaches: the light-blue circle under each one it reaches says who it lends to.
      Look = ManaAura
      TickFrames = 30
      MaxRank = 1
      Name = Sehr buloqi
      ; What the HUD draws over the bar of a pool it fills -- the creature the player picks
      ; alone, or points at -- and its card's line: the stat picture for intelligence, until a
      ; picture of its own is painted.
      Icon = icons/stats/stat_intelligence.png
      Blurb = Atrofidagi o'zinikilarning manasi tezroq to'ladi.
    End
  ]
End

; ---------------------------------------------------------------------------
; A healer's mana, worn, in blue -- the colour of a mana whoever bears it, not the
; healer's own green: the summoner's MightAura on a picture of its own, a few rings of
; ripples (effects/aura_ripples.png) spreading on the floor from under its feet, a little
; wider than its body, played on it every TickFrames and lasting two, as the summoner's
; MightAura and the Revenant's BloodAura are. Nothing draws its Radius, and nothing rides
; its body: see the MightAura for why it lies where it does, and does not turn.
; ---------------------------------------------------------------------------
Effect
  Name = ManaAura

  Layers = [
    Layer
      Name = Ripples
      Type = MARK
      Measure = Units
      Follows = Yes
      Texture = effects/aura_ripples.png
      Blend = Additive
      Count = 1
      Size = [22, 22]
      Colour = [0x3F8CFF, 0x3F8CFF]
      Alpha = [0.75, 0.75]
      FadeIn = 0.5
      FadeOut = 0.5
      Height = 0.3
      TurnJitter = 0
    End
  ]
End
