; The green one, and it fights for the others. Frail and slow like the Skeleton Mage,
; with a spark of light for its ordinary shot; its skills are holy light called down
; on whichever of its own is worst hurt, and every pool of its own round it filling
; faster -- see Monster SkeletonHealer and the Q and W skills of the SkeletonHealer
; below.
Monster
  Name = SkeletonHealer
  DisplayName = Skeleton Healer
  KindOf = [INFANTRY, SELECTABLE, CAN_ATTACK]
  Geometry = Cylinder
    Radius = 4
    Height = 13
  End
  VisionRange = 64
  Modules = [
    GrowableBody
      ; The frailest of the three: it is the one to kill first.
      MaxHealth = 36
    End,
    MoveUpdate
      Speed = 13
      TurnRate = 0
    End,
    ; For while the mending comes back: weaker than the Skeleton Mage's fire, and
    ; reaching the far edge of the same band.
    WeaponUpdate
      Damage = 4
      AttackRange = 58
      ReloadFrames = 60
      AttackOnTheMove = No
    End,
    SkillBook
    End,
    ; Before the Bow, as on the Skeleton Mage: a throw still leaving it holds its mending.
    Swing
    End,
    Bow
      Projectile = HolySpark
      Speed = 95
      MuzzleOffset = 8
    End,
    EyesOnly
    End,
    StatusUpdate
    End,
    MonsterBrain
    End,
    ExperienceModule
      ExperienceValue = 22
      ExperienceRequired = [0, 0, 0]
    End
  ]


  ; The green one, and it fights for the others. It holds the same band as the
  ; Skeleton Mage, throws a spark of light while it waits, and whenever one of its
  ; own in plain sight is badly hurt it calls holy light down on him -- the worst
  ; hurt first. It cannot mend itself: kill it first and the room stops mending.
  SenseRadius = 64
  ChaseRadius = 120
  ; Unused: it holds the band below rather than closing.
  CloseDistance = 6
  AlertRadius = 70
  RepathFrames = 10
  SwingFrames = 20
  ; From the first floor, as every mage is. It is the one to kill first there too,
  ; and it stands with every boss: see BossGuards in the Descent block of generation.duke.
  MinDepth = 1
  Weight = 8
  ; One to a room: two would mend each other for as long as the fight lasted.
  MaxPerRoom = 1
  Colour = 0x8FDC6A
  Scale = 1
  KeepDistance = [35, 55]
  ; The staff-carrier in a robe repainted green: its colour says what it does before
  ; its light does. White tint, so the green is the robe's own.
  Model = models/monsters/skeleton_mage.glb
  Animations = Humanoid
  Texture = models/monsters/skeleton_texture_green.png
  Effect = EmberEyes
  ModelScale = 6.0
  Held = Held
    Model = models/monsters/staff.gltf
    Bone = handslot.r
  End
  Attack = Ranged_Magic_Shoot
  Idle = Ranged_Magic_Spellcasting_Long

  ; What it mends out of, in the hero's words and units, as the Skeleton Mage's:
  ; enough to mend at its cooldown through a fight of a minute or more.
  MaxMana = 50
  ManaRegen = 25

  Skills = [
    Skill
      Key = Q
      ; Holy light, called down on whichever of its own is worst hurt -- counted as a
      ; share of his own health, and only if that is below HealBelowPercent, so it is
      ; never spent on someone who does not need it. Within Range of the healer and in
      ; plain sight of it, and it may not mend itself.
      Effect = HEAL
      ; A third of a Skeleton, a tenth of the Warden: it keeps the rank and file standing
      ; and only slows a boss. It grows with the healer's level, as its blows do.
      Heal = 30
      HealBelowPercent = 60
      Range = 60
      ; The light lies on the floor this long before it lands and mends: long enough to
      ; be seen coming, and to finish off the one it was coming for.
      WindUpFrames = 20
      Projectile = MendingLight
      ; Eight seconds between mendings. Noticeable, and not a wall.
      CooldownFrames = 240
      ManaCost = 25
      MaxRank = 1
      Name = Muqaddas nur
    End,
    Skill
      Key = W
      ; Every pool of its own round it -- its own, a summoner's, a fire mage's -- fills
      ; five points a second faster, within its Radius and in its plain sight, and never
      ; through the keep's shut gate: in tenths of a point a second, as a pool's own
      ; trickle. A creature with no pool is given none. Never cast: it holds while it
      ; stands. Two healers lend the stronger.
      Effect = MANA_AURA
      ManaRegen = 50
      ; A room round it, and the ones fighting him from its band.
      Radius = 60
      ; Worn: a thick blue ring as wide as its Radius, and blue motes at its feet, played
      ; on it every second -- see the Effect ManaAura, below.
      Look = ManaAura
      TickFrames = 30
      MaxRank = 1
      Name = Sehr buloqi
      ; What the HUD draws over the bar of every pool it fills, and its card's line: the stat
      ; picture for intelligence, until a picture of its own is painted.
      Icon = icons/stats/stat_intelligence.png
      Blurb = Atrofidagi o'zinikilarning manasi tezroq to'ladi.
    End
  ]
End

; ---------------------------------------------------------------------------
; A healer's mana, worn, in blue -- the colour of a mana whoever bears it, not the
; healer's own green: the summoner's MightAura in another colour -- the same thick ring
; on the floor as wide as its Radius, played on it every TickFrames and lasting two --
; and, in the place of its sparks, a few blue motes drifting up at its feet. Like those
; sparks they are an AURA layer, carried on at each beat by Main.layerOf.
; ---------------------------------------------------------------------------
Effect
  Name = ManaAura

  Layers = [
    Layer
      Name = Ring
      Type = MARK
      Measure = Reach
      Follows = Yes
      Texture = kit/effects/particles/circle_03.png
      Blend = Additive
      Count = 1
      Size = [2.81, 2.81]
      Colour = [0x3F8CFF, 0x3F8CFF]
      Alpha = [0.55, 0.55]
      FadeIn = 0.5
      FadeOut = 0.5
      Height = 0.3
    End,

    ; Soft round motes, a few at a time, low about its feet and drifting up no higher than
    ; its waist: the small, slow sign of a pool being filled.
    Layer
      Name = Motes
      Type = AURA
      Texture = kit/effects/particles/star_05.png
      Blend = Additive
      Count = 10
      Rate = 6
      Radius = 8
      Life = [1.0, 1.5]
      Size = [4.0, 1.2]
      Colour = [0x8FC4FF, 0x3F8CFF]
      FadeIn = 0.2
      Speed = [2, 5]
      Direction = UP
      Spread = 15
      Height = 0.5
    End
  ]
End
