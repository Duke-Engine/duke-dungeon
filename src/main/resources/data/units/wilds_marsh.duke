End

; ELITE of the frogs: bigger, poison green, two affixes.
Monster
  Name = VenomFrog
  DisplayName = "Zaharli qurbaqa"
  KindOf = [INFANTRY, SELECTABLE, CAN_ATTACK]
  Geometry = Cylinder
    Radius = 7
    Height = 16
  End
  VisionRange = 70
  Modules = [
    GrowableBody
      MaxHealth = 340
    End,
    MoveUpdate
      Speed = 16
      TurnRate = 0
    End,
    WeaponUpdate
      Damage = 22
      AttackRange = 12
      ReloadFrames = 24
      ; The swing up to the blow (MonsterClipFitTest): the client starts its attack as it winds up,
      ; and the blow lands as the clip strikes. Taken off ReloadFrames, so it hits as often as before.
      PreAttackFrames = 10
    End,
    Swing
    End,
    SkillBook
    End,
    StatusUpdate
    End,
    MonsterBrain
    End,
    ExperienceModule
      ExperienceValue = 55
      ExperienceRequired = [0, 0, 0]
    End
  ]

  SenseRadius = 45
  ChaseRadius = 95
  CloseDistance = 4
  AlertRadius = 70
  RepathFrames = 10
  SwingFrames = 14
  ; Never on a floor of the descent: the open world's camps place it by name.
  MinDepth = 99
  Weight = 0
  Colour = 0x70D060
  Scale = 1.33
  Model = models/wilds/frog.glb
  ModelScale = 6.55
  Tint = 0x70D060
  ; Its own clips, renamed by art/monsters/export_monsters.py.
  Idle = Idle
  Walk = Walk
  Attack = Attack
  Death = Death
  ; How far one play of its walk carries it, measured off the clip (MonsterClipFitTest): its feet stay put.
  WalkStride = 17.18
  UpperBody = Hips

  Skills = [
    Skill
      Key = E
      ; Elite affix: everyone of its own round it drinks from its blows.
      Effect = LIFESTEAL_AURA
      BoostPercent = 15
      Radius = 50
      Look = BloodAura
      TickFrames = 30
      MaxRank = 1
      Name = Qon aurasi
      Icon = icons/stats/stat_lifesteal.png
      Blurb = Atrofidagi o'zinikilar har zarbasidan jon qaytarib oladi.
    End,
    Skill
      Key = R
      ; Elite affix: a quarter of every blow turned aside, and a little health back each second.
      Effect = DRAGON_BLOOD
      BoostPercent = 25
      Heal = 3
      MaxRank = 1
      Name = Toshteri
    End
  ]
End

