    StatusUpdate
    End,
    MonsterBrain
    End,
    ExperienceModule
      ExperienceValue = 24
      ExperienceRequired = [0, 0, 0]
    End
  ]

  SenseRadius = 45
  ChaseRadius = 95
  CloseDistance = 4
  AlertRadius = 70
  RepathFrames = 10
  SwingFrames = 14
  ; Never on a floor of the descent: the open world's camps place it by name.
  MinDepth = 99
  Weight = 0
  Colour = 0xC8B890
  Scale = 1.00
  Model = models/wilds/frog.glb
  ModelScale = 4.85
  ; Its own clips, renamed by art/monsters/export_monsters.py.
  Idle = Idle
  Walk = Walk
  Attack = Attack
  Death = Death
  ; How far one play of its walk carries it, measured off the clip (MonsterClipFitTest): its feet stay put.
  WalkStride = 12.72
  UpperBody = Hips
End

; ranged: shadow sparks.
Monster
