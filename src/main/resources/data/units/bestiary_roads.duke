    Model = models/licensed/bandit.glb
    ModelScale = 8.54
    Tint = 0xB04030
    Idle = Idle
    Walk = Walk
    Attack = Attack
    Death = Death
    WalkStride = 7.1
  End

  Skills = [
    Skill
      Key = Q
      ; Drinks a share of every blow it lands.
      Effect = LIFESTEAL
      BoostPercent = 30
      MaxRank = 1
      Name = "Qonxo'r"
    End,
    Skill
      Key = W
      ; Strikes faster for five seconds -- itself, or the sturdiest of its own near it.
      Effect = HASTE
      BoostPercent = 60
      DurationFrames = 150
      Range = 50
      CooldownFrames = 300
      Look = Hasted
      MaxRank = 1
      Icon = icons/stats/stat_speed.png
      Blurb = Bir necha soniya ancha tezroq uradi.
      Name = Shiddat
    End
  ]
End

