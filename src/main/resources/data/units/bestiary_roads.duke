  Model = models/bestiary/bandit.glb
  ModelScale = 7.99
  Tint = 0xB04030
  Idle = Idle
  Walk = Walk
  Attack = Attack
  Death = Death
  ; How far one play of its walk carries it, measured off the clip (MonsterClipFitTest).
