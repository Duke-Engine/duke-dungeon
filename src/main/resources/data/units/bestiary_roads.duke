      ExperienceRequired = [0, 0, 0]
    End
  ]

  SenseRadius = 64
  ChaseRadius = 120
  CloseDistance = 6
  AlertRadius = 70
  RepathFrames = 10
  SwingFrames = 14
  ; Never on a floor of the descent: the open world places it by name.
