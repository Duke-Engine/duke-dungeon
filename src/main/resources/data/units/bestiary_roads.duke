; ---------------------------------------------------------------------------
; The meadow's roads (Act 1): bandits and their chief, the meadow's wolves and wild bulls.
; The bestiary (docs/plan/2026-10-15-bestiary.md): WorldMapWriter's Wild camps and roamers place them by name.
; Models: Quaternius (CC0; the zombie ghoul, brute and crawler, the witch and the cult mage CC-BY 3.0 -- see
; CREDITS.md), converted by art/monsters/export_bestiary.py. A Licensed look is a CGTrader Royalty Free model in the
; git-ignored licensed-assets/ (art/monsters/export_licensed_monsters.py), drawn where it is shipped.
; Levels are the walk's from the city, as every monster's in the world: these figures are level 1's.
; ---------------------------------------------------------------------------

; common: comes in a crowd off the road.
Monster
  Name = Bandit
  DisplayName = "Qaroqchi"
  KindOf = [INFANTRY, SELECTABLE, CAN_ATTACK]
  Geometry = Cylinder
    Radius = 4
    Height = 12
  End
  VisionRange = 70
  Modules = [
    GrowableBody
      MaxHealth = 60
    End,
    MoveUpdate
      Speed = 18
      TurnRate = 0
    End,
    WeaponUpdate
      Damage = 7
      AttackRange = 9
      ReloadFrames = 12
      ; The swing up to the blow (MonsterClipFitTest), taken off ReloadFrames.
      PreAttackFrames = 8
    End,
    Swing
    End,
    SkillBook
    End,
    StatusUpdate
    End,
    MonsterBrain
    End,
    ExperienceModule
      ExperienceValue = 11
      ExperienceRequired = [0, 0, 0]
    End
  ]

  SenseRadius = 45
  ChaseRadius = 95
  CloseDistance = 4
  AlertRadius = 70
  RepathFrames = 10
  SwingFrames = 14
  ; Never on a floor of the descent: the open world places it by name.
  MinDepth = 99
  Weight = 0
  Colour = 0xC8B890
  Scale = 1
  Model = models/bestiary/bandit.glb
  ModelScale = 6.39
  Idle = Idle
  Walk = Walk
  Attack = Attack
  Death = Death
  ; How far one play of its walk carries it, measured off the clip (MonsterClipFitTest).
  WalkStride = 11.5
  ; The licensed look (CGTrader Royalty Free, licensed-assets/ only; see CREDITS.md) where it is
  ; shipped, the look above where it is not.
  Licensed = MonsterLook
    Model = models/licensed/bandit.glb
    ModelScale = 6.88
    Idle = Idle
    Walk = Walk
    Attack = Attack
    Death = Death
    WalkStride = 5.8
  End
End

