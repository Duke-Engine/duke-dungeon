; ---------------------------------------------------------------------------
; Act 2's people of the capital — see docs/plan/2026-10-15-act2.md and data/story/act2.duke.
; Three townsfolk who tell the heroine what the city says of the queen. STAND-IN names and
; looks: the KayKit adventurers (CC0) tinted apart from Act 1's people. Never drawn into a floor.
; ---------------------------------------------------------------------------

Monster
  Name = Baker
  DisplayName = "Novvoy Karim"
  KindOf = [INFANTRY, SELECTABLE]
  Geometry = Cylinder
    Radius = 4
    Height = 12
  End
  VisionRange = 0
  Modules = [
    MoveUpdate
      Speed = 10
      TurnRate = 0
    End
  ]
  MinDepth = 99
  Weight = 0
  Colour = 0xD8B890
  Scale = 1.0
  Model = models/heroes/knight.glb
  Tint = 0xD8B890
  ModelScale = 4.72
  Facing = 90
  Animations = Humanoid
  ; How far one play of its walk carries it, measured off the clip (MonsterClipFitTest): its feet stay put.
  WalkStride = 3.52
  UpperBody = spine
End

