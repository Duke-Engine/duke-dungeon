; ---------------------------------------------------------------------------
; The steppe's old ruins: the golems, the crowned shade and the minotaur.
; The bestiary (docs/plan/2026-10-15-bestiary.md): WorldMapWriter's Wild camps and roamers place them by name.
; Models: Quaternius (CC0; the zombie ghoul, brute and crawler, the witch and the cult mage CC-BY 3.0 -- see
; CREDITS.md), converted by art/monsters/export_bestiary.py. A Licensed look is a CGTrader Royalty Free model in the
; git-ignored licensed-assets/ (art/monsters/export_licensed_monsters.py), drawn where it is shipped.
; Levels are the walk's from the city, as every monster's in the world: these figures are level 1's.
; ---------------------------------------------------------------------------

; common: the ruins' big pale rats, in packs.
Monster
  Name = RuinRat
  DisplayName = "Xaroba kalamushi"
  KindOf = [INFANTRY, SELECTABLE, CAN_ATTACK]
  Geometry = Cylinder
    Radius = 3
    Height = 7
  End
  VisionRange = 70
  Modules = [
    GrowableBody
      MaxHealth = 40
    End,
    MoveUpdate
      Speed = 20
      TurnRate = 0
    End,
    WeaponUpdate
      Damage = 6
      AttackRange = 8
      ReloadFrames = 10
      ; The swing up to the blow (MonsterClipFitTest), taken off ReloadFrames.
      PreAttackFrames = 10
    End,
    Swing
    End,
    SkillBook
    End,
    StatusUpdate
    End,
    MonsterBrain
    End,
    ExperienceModule
      ExperienceValue = 7
      ExperienceRequired = [0, 0, 0]
    End
  ]

  SenseRadius = 45
  ChaseRadius = 95
  CloseDistance = 4
  AlertRadius = 70
  RepathFrames = 10
  SwingFrames = 14
  ; Never on a floor of the descent: the open world places it by name.
  MinDepth = 99
  Weight = 0
  Colour = 0xB09070
  Scale = 0.57
  Model = models/characters/monsters/rat.glb
  ModelScale = 2.97
  Tint = 0xB09070
  Idle = Idle
  Walk = Walk
  Attack = Attack
  Death = Death
  ; How far one play of its walk carries it, measured off the clip (MonsterClipFitTest).
  WalkStride = 5.92
End

