Monster
  Name = Reaper
  ; Fast. The archer's whole game is the distance he keeps, and this is the first
  ; thing down here that closes it faster than he can back away.
  DisplayName = "O'roqchi"
  KindOf = [INFANTRY, SELECTABLE, CAN_ATTACK]
  Geometry = Cylinder
    Radius = 6
    Height = 19
  End
  VisionRange = 130
  Modules = [
    GrowableBody
      MaxHealth = 380
    End,
    MoveUpdate
      Speed = 26
      TurnRate = 0
    End,
    WeaponUpdate
      Damage = 18
      AttackRange = 13
      ReloadFrames = 7
      ; The swing up to the blow (MonsterClipFitTest): the client starts its attack as it winds up,
      ; and the blow lands as the clip strikes. Taken off ReloadFrames, so it hits as often as before.
      PreAttackFrames = 17
    End,
    Swing
    End,
    ; That it has skills: one, never cast -- see its Skill block, below.
    SkillBook
    End,
    ; Timers for the statuses it is wearing -- the engine's own, and today that
    ; means SLOWED. MoveUpdate already halves the step of anything wearing it, and
    ; StatusUpdate already counts it down and takes it off, so a monster that
    ; carries this thaws by itself whether or not whoever chilled it is still alive.
    StatusUpdate
    End,
    MonsterBrain
    End,
    ExperienceModule
      ExperienceValue = 110
      ExperienceRequired = [0, 0, 0]
    End
  ]


  SenseRadius = 55
  ChaseRadius = 195
  CloseDistance = 4
  AlertRadius = 110
  RepathFrames = 6
  ; Quicker than the rest of them, which is the whole of what it is.
  SwingFrames = 12
  MinDepth = 0
  Weight = 0
  Colour = 0xFFFFFF
  Scale = 1.6
  ; The hooded one, drawn as high as the KayKit one was (3.05 x 6.2 = 18.9 units); the model is 1.74 m, so ModelScale is 10.85.
  ; Realistic since 2026-11-05: the workspace's models/reaper on the game rig, its clips in its file, 1 m = 6.667 units.
  Model = models/characters/realistic/reaper.glb
  ModelScale = 10.85
  Facing = 90
  Idle = Idle
  Walk = Run
  ; How far one play of Run carries it, ESTIMATED off the clip's foot travel (MonsterClipFitTest has not measured it): its feet stay put.
  WalkStride = 25.34
  Attack = Attack
  Death = Death
  UpperBody = spine_01
  ; What is looking at you out of the dark.

  Skills = [
    Skill
      Key = Q
      ; A quarter of every blow back, never cast, as every boss has -- see the
      ; Warden's.
      Effect = LIFESTEAL
      BoostPercent = 25
      MaxRank = 1
      Name = Qon so'rish
    End
  ]
End
