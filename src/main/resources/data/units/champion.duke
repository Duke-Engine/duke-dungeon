Monster
  Name = Champion
  ; The last one, and the numbers the single boss used to have: at level 35,
  ; where the fourth floor's boss stands, its level's bonus makes this 2640
  ; health and about 65 damage. Beat it and the run is over.
  DisplayName = Pahlavon
  KindOf = [INFANTRY, SELECTABLE, CAN_ATTACK]
  Geometry = Cylinder
    Radius = 8
    Height = 24
  End
  VisionRange = 130
  Modules = [
    GrowableBody
      MaxHealth = 600
    End,
    MoveUpdate
      Speed = 14
      TurnRate = 0
    End,
    WeaponUpdate
      Damage = 24
      AttackRange = 14
      ReloadFrames = 17
      ; The swing up to the blow (MonsterClipFitTest): the client starts its attack as it winds up,
      ; and the blow lands as the clip strikes. Taken off ReloadFrames, so it hits as often as before.
      PreAttackFrames = 17
    End,
    Swing
    End,
    ; That it has skills: one, never cast -- see its Skill block, below.
    SkillBook
    End,
    ; Timers for the statuses it is wearing -- the engine's own, and today that
    ; means SLOWED. MoveUpdate already halves the step of anything wearing it, and
    ; StatusUpdate already counts it down and takes it off, so a monster that
    ; carries this thaws by itself whether or not whoever chilled it is still alive.
    StatusUpdate
    End,
    MonsterBrain
    End,
    ExperienceModule
      ExperienceValue = 160
      ExperienceRequired = [0, 0, 0]
    End
  ]


  SenseRadius = 55
  ChaseRadius = 195
  CloseDistance = 4
  AlertRadius = 110
  RepathFrames = 8
  ; Slow enough to be read, which is most of what makes a boss fightable.
  SwingFrames = 20
  MinDepth = 0
  Weight = 0
  Colour = 0xFFFFFF
  Scale = 2.2
  ; Twice anything else, and darkened until it reads as its own creature.
  ; GeometryHeight is 24.
  ; Realistic since 2026-11-05: the workspace's models/champion on the game rig, its clips in its file, 1 m = 6.667 units.
  Model = models/characters/realistic/champion.glb
  ModelScale = 9.7
  Facing = 90
  Idle = Idle
  Walk = Walk
  ; How far one play of Walk carries it, ESTIMATED off the clip's foot travel (MonsterClipFitTest has not measured it): its feet stay put.
  WalkStride = 17.43
  Attack = Attack
  Death = Death
  UpperBody = spine_01
  ; What is looking at you out of the dark.

  Skills = [
    Skill
      Key = Q
      ; A quarter of every blow back, never cast, as every boss has -- see the
      ; Warden's.
      Effect = LIFESTEAL
      BoostPercent = 25
      MaxRank = 1
      Name = Qon so'rish
    End
  ]
End
