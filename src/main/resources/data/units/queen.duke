; ---------------------------------------------------------------------------
; The queen: a person, on the engine's neutral side like the commander, never
; drawn into a floor (Weight 0). She gives the hero the medallion, and the
; turning puts it back in her hand -- see docs/plan/2026-10-09-medallion.md.
;
; Her look is the "Dark Elf Shadow Enchantress" where that licensed model is shipped (Licensed,
; below); without it, the stand-in: the KayKit mage, tinted toward a queen's violet.
; ---------------------------------------------------------------------------
Monster
  Name = Queen
  DisplayName = Malika
  KindOf = [INFANTRY, SELECTABLE]
  Geometry = Cylinder
    Radius = 4
    Height = 12
  End
  VisionRange = 0
  Modules = [
    MoveUpdate
      Speed = 8
      TurnRate = 0
    End
  ]
  MinDepth = 99
  Weight = 0
  Colour = 0x9A5AC8
  Scale = 1.0
  Model = models/heroes/mage.glb
  Tint = 0xB08AD8
  ; The mage boxes about 2.655 tall: 12 / 2.655.
  ModelScale = 4.8
  Facing = 90
  Animations = Humanoid
  ; How far one play of its walk carries it, measured off the clip (MonsterClipFitTest): its feet stay put.
  WalkStride = 3.58
  UpperBody = spine
  ; ★ LICENSED LOOK. Drawn as the "Dark Elf Shadow Enchantress" (CGTrader, Royalty Free -- see CREDITS.md) where
  ; models/licensed/queen.glb is shipped: it lives in the git-ignored licensed-assets/ folder,
  ; never in this repository, so a clone without it (and CI) draws the stand-in above. Her clips
  ; are in her own file (art/licensed/export_licensed.py), her size 12 units over her 1.7, and
  ; WalkStride is how far one play of her Walk carries her at that size, so her feet stay put.
  ; Her Walk is a queen's: short steps nearly in line, hands clasped, unhurried (Speed 8, a villager's pace).
  Licensed = MonsterLook
    Model = models/licensed/queen.glb
    ModelScale = 7.06
    Facing = 90
    Idle = Idle
    Walk = Walk
    Attack = Attack
    Death = Death
    WalkStride = 7.15
    UpperBody = spine
  End
End
