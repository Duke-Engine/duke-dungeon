      ; Drinks a share of every blow it lands.
      Effect = LIFESTEAL
      BoostPercent = 30
      MaxRank = 1
      Name = "Qon so'rish"
    End,
    Skill
      Key = W
      ; Strikes faster for five seconds -- itself, or the sturdiest of its own near it.
      Effect = HASTE
      BoostPercent = 60
      DurationFrames = 150
      Range = 50
      CooldownFrames = 300
      Look = Hasted
      MaxRank = 1
      Icon = icons/stats/stat_speed.png
      Blurb = Bir necha soniya ancha tezroq uradi.
      Name = Shiddat
    End
  ]
End

; CAMP BOSS: a tentacle of the thing in the lake -- it hardly moves, but drags the hero to it.
Monster
  Name = Kraken
  DisplayName = "Ko'l maxluqi"
  KindOf = [INFANTRY, SELECTABLE, CAN_ATTACK]
  Geometry = Cylinder
    Radius = 8
    Height = 26
  End
  VisionRange = 130
  Modules = [
    GrowableBody
      MaxHealth = 600
    End,
    MoveUpdate
      Speed = 3
      TurnRate = 0
    End,
    WeaponUpdate
      Damage = 28
      AttackRange = 22
      ReloadFrames = 39
      ; The swing up to the blow (MonsterClipFitTest), taken off ReloadFrames.
      PreAttackFrames = 1
    End,
    Swing
    End,
    SkillBook
    End,
    StatusUpdate
    End,
    MonsterBrain
    End,
    ExperienceModule
      ExperienceValue = 170
      ExperienceRequired = [0, 0, 0]
    End
  ]

  SenseRadius = 60
  ChaseRadius = 60
  CloseDistance = 4
  AlertRadius = 110
  RepathFrames = 8
  SwingFrames = 14
  ; Never on a floor of the descent: the open world places it by name.
  MinDepth = 99
  Weight = 0
  SkillDistance = [0, 30]
  Colour = 0xC8B890
  Scale = 2.17
  Model = models/characters/monsters/kraken_tentacle.glb
  ModelScale = 1.32
  Idle = Idle
  Walk = Walk
  Attack = Attack
  Death = Death
  ; How far one play of its walk carries it, measured off the clip (MonsterClipFitTest).
  WalkStride = 0

  Skills = [
    Skill
      Key = Q
      ; Everyone round it dragged to its front, hurt and held.
      Effect = PULL
      Radius = 32
      Range = 12
      Damage = 25
      StunFrames = 45
      CooldownFrames = 600
      MaxRank = 1
      Look = Whirlwind
      Name = Chirmovchi
    End,
    Skill
      Key = W
      ; A wave down a line that hurts everyone it runs through.
      Effect = WAVE
      Damage = 35
      Distance = 50
      Range = 50
      HitWidth = 16
      ProjectileSpeed = 55
      Projectile = SwordWave
      StunFrames = 20
      CooldownFrames = 360
      MaxRank = 1
      Name = "To'lqin"
    End
  ]
End

