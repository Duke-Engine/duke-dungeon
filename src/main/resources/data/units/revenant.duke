Monster
  Name = Revenant
  DisplayName = Revenant
  KindOf = [INFANTRY, SELECTABLE, CAN_ATTACK]
  Geometry = Cylinder
    Radius = 4
    Height = 13
  End
  VisionRange = 58
  Modules = [
    GrowableBody
      MaxHealth = 90
    End,
    MoveUpdate
      Speed = 16
      TurnRate = 0
    End,
    WeaponUpdate
      Damage = 8
      ; It throws fire rather than walking up. Shorter than the crossbow: this one
      ; is dangerous because it will not die, not because it reaches.
      AttackRange = 46
      ReloadFrames = 58
      AttackOnTheMove = No
    End,
    ; A small one, and small on purpose -- this is its ordinary attack.
    Bow
      Projectile = Fireball
      ; Faster than a bolt (the Stalker's is 150): over its whole reach of 46 in about a
      ; quarter of a second, so there is little time to see it coming.
      Speed = 190
      ; Out at the end of the staff, not out of its chest.
      MuzzleOffset = 8
    End,
    ; It throws at what it can see, for the same reason the crossbow shoots at it.
    EyesOnly
    End,
    ; The whole character of it: leave it alive and the fight resets.
    AutoHealUpdate
      HealPerSecond = 7
    End,
    ; Tells the brain the frame a blow landed, so it stands and finishes the swing
    ; instead of walking off mid-blow. It launches nothing -- see Swing.
    Swing
    End,
    ; What carries its aura, below -- and, as every monster's does, a summoner's haste.
    SkillBook
    End,
    ; Timers for the statuses it is wearing -- the engine's own, and today that
    ; means SLOWED. MoveUpdate already halves the step of anything wearing it, and
    ; StatusUpdate already counts it down and takes it off, so a monster that
    ; carries this thaws by itself whether or not whoever chilled it is still alive.
    StatusUpdate
    End,
    MonsterBrain
    End,
    ExperienceModule
      ExperienceValue = 24
      ExperienceRequired = [0, 0, 0]
    End
  ]


  ; Heals itself (AutoHealUpdate in its template above). Kill it quickly or it undoes
  ; the fight — a damage check rather than a health check. And everyone of its own round
  ; it drinks from their blows: see its Skill, below.
  ;
  ; And it throws fire, which it did not: a thing in a pointed hat that walks up
  ; and hits you is a skeleton with a hat on. Its ordinary attack is a small
  ; fireball -- small on purpose, because it is an ordinary attack. What a
  ; fireball proper looks like is a skill, and a later question.
  SenseRadius = 36
  ChaseRadius = 75
  CloseDistance = 38
  AlertRadius = 70
  RepathFrames = 10
  SwingFrames = 14
  ; It casts rather than swings.
  Attack = Ranged_Magic_Shoot
  ; And it STANDS with the staff up, which is the half that makes the other half
  ; visible. With the ordinary idle its weapon hand sits at 0.53 -- down at its
  ; side -- so the staff hung at its feet and the cast was a twitch between two
  ; frames of that. Hands up and forward at 0.89, and the throw reads as a throw.
  Idle = Ranged_Magic_Spellcasting_Long
  MinDepth = 1
  Weight = 12
  Colour = 0x6FA8FF
  Scale = 1.1
  ; The one that carries a staff, because the one that mends itself should not
  ; look like the ones that only swing. GeometryHeight is 13.
  Model = models/monsters/skeleton_mage.glb
  Animations = Humanoid
  ; What is looking at you out of the dark.
  Effect = EmberEyes
  ModelScale = 6.0
  Held = Held
    Model = models/monsters/staff.gltf
    Bone = handslot.r
  End
  ; It heals itself; the pale wash says so before the health bar does.
  Tint = 0x9FC4FF

  Skills = [
    Skill
      Key = Q
      ; Everyone of its own round it -- itself too -- drinks a tenth of every blow it
      ; lands, as health: a swing where it lands, a shot where it arrives, a burst and a
      ; meteor's blast for each they hurt -- added to a boss's own quarter. Within its
      ; Radius and in its plain sight, and never through the keep's shut gate. Never cast:
      ; it holds while it stands. Two Revenants lend the stronger, never both.
      Effect = LIFESTEAL_AURA
      BoostPercent = 10
      ; A room round it, and the ones fighting beside it.
      Radius = 60
      ; Worn: a thick red ring as wide as its Radius, and red drops rising round its body,
      ; played on it every second -- see the Effect BloodAura, below.
      Look = BloodAura
      TickFrames = 30
      MaxRank = 1
      Name = Qon aurasi
      ; What the HUD draws over the bar of one it reaches -- the creature the player picks
      ; alone, or points at -- and its card's line: the stat picture for lifesteal, until a
      ; picture of its own is painted.
      Icon = icons/stats/stat_lifesteal.png
      Blurb = Atrofidagi o'zinikilar har zarbasidan jon qaytarib oladi.
    End
  ]
End

; ---------------------------------------------------------------------------
; A Revenant's drink, worn, in red -- the colour of a thirst whoever bears it, not the
; Revenant's own blue: a thick ring on the floor as wide as its Radius, played on it every
; TickFrames and lasting two, as the summoner's MightAura and the healer's ManaAura are --
; and red drops rising round the body, as blood drawn up, which say this is the one that
; bears it: an AURA layer, let out at a Rate and carried on at each beat by Main.layerOf.
; Its ring burns a little brighter than the other two: a red is the darkest of the three.
; ---------------------------------------------------------------------------
Effect
  Name = BloodAura

  Layers = [
    Layer
      Name = Ring
      Type = MARK
      Measure = Reach
      Follows = Yes
      Texture = kit/effects/particles/circle_03.png
      Blend = Additive
      Count = 1
      Size = [2.81, 2.81]
      Colour = [0xD01C28, 0xD01C28]
      Alpha = [0.6, 0.6]
      FadeIn = 0.5
      FadeOut = 0.5
      Height = 0.3
    End,

    ; Soft red drops, drawn out upward as they rise, from the shin to about the head and
    ; gone as they reach it. They are drops, not a glow -- Cover lets them hide some of the
    ; pale body behind them, so they stay red where light added to it would wash out to
    ; pink -- and they start a little off the floor, where a long one is not cut by it.
    Layer
      Name = Drops
      Type = AURA
      Texture = kit/effects/particles/circle_05.png
      Blend = Additive
      Cover = 0.5
      Count = 13
      Rate = 9
      Radius = 6
      Life = [0.9, 1.4]
      Size = [3.0, 1.4]
      Colour = [0xFF4048, 0xA0101C]
      Alpha = [1, 0.5]
      FadeIn = 0.15
      Speed = [7, 11]
      Direction = UP
      Spread = 12
      Stretch = 0.12
      Height = 2
    End
  ]
End
