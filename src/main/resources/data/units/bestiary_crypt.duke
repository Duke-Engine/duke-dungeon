; CAMP BOSS: a king the curse keeps -- he calls the dead up, and they drink from their blows round him.
Monster
  Name = FallenKing
  DisplayName = "La'natlangan qirol"
  KindOf = [INFANTRY, SELECTABLE, CAN_ATTACK]
  Geometry = Cylinder
    Radius = 7
    Height = 16
  End
  VisionRange = 130
  Modules = [
    GrowableBody
      MaxHealth = 580
    End,
    MoveUpdate
      Speed = 14
      TurnRate = 0
    End,
    WeaponUpdate
      Damage = 24
      AttackRange = 13
      ReloadFrames = 20
      ; The swing up to the blow (MonsterClipFitTest), taken off ReloadFrames.
      PreAttackFrames = 10
    End,
    Swing
    End,
    SkillBook
    End,
    StatusUpdate
    End,
    MonsterBrain
    End,
    ExperienceModule
      ExperienceValue = 170
      ExperienceRequired = [0, 0, 0]
    End
  ]

  SenseRadius = 55
  ChaseRadius = 150
  CloseDistance = 4
  AlertRadius = 110
  RepathFrames = 8
  SwingFrames = 14
  ; Never on a floor of the descent: the open world places it by name.
  MinDepth = 99
  Weight = 0
  SkillDistance = [0, 60]
  Colour = 0xA8B0C8
  Scale = 1.33
  Model = models/characters/monsters/fallen_king.glb
  ModelScale = 8.4
  Tint = 0xA8B0C8
  Idle = Idle
  Walk = Walk
  Attack = Attack
  Death = Death
  ; How far one play of its walk carries it, measured off the clip (MonsterClipFitTest).
  WalkStride = 15.1

  Skills = [
    Skill
      Key = Q
      ; Rifts round it, and one of its own out of each.
      Effect = SUMMON
      Summons = [Skeleton = 2, Stalker = 1]
      MaxSummoned = 3
      Radius = 16
      DurationFrames = 600
      SummonExperiencePercent = 0
      WindUpFrames = 20
      Projectile = SummoningRift
      CooldownFrames = 420
      MaxRank = 1
      Name = Qabrdan turganlar
    End,
    Skill
      Key = E
      ; Everyone of its own round it drinks a share of its blows.
      Effect = LIFESTEAL_AURA
      BoostPercent = 20
      Radius = 50
      Look = BloodAura
      TickFrames = 30
      MaxRank = 1
      Icon = icons/stats/stat_lifesteal.png
      Blurb = Atrofidagi o'zinikilar har zarbasidan jon qaytarib oladi.
      Name = "La'nat"
    End,
    Skill
      Key = W
      ; Thrown down a line, bursting where it stops: it can be stepped out of.
      Effect = SKILLSHOT
      Damage = 40
      Range = 70
      Radius = 16
      HitWidth = 6
      ProjectileSpeed = 120
      Projectile = SkullFireball
      StunFrames = 20
      CooldownFrames = 210
      MaxRank = 1
      Name = Qora olov
    End
  ]
End

