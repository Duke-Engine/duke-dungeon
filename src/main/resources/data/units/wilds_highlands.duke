  Geometry = Cylinder
    Radius = 6
    Height = 16
  End
  VisionRange = 70
  Modules = [
    GrowableBody
      MaxHealth = 170
    End,
    MoveUpdate
      Speed = 20
      TurnRate = 0
    End,
    WeaponUpdate
      Damage = 12
      AttackRange = 12
      ReloadFrames = 19
      ; The swing up to the blow (MonsterClipFitTest): the client starts its attack as it winds up,
      ; and the blow lands as the clip strikes. Taken off ReloadFrames, so it hits as often as before.
      PreAttackFrames = 7
    End,
    Swing
    End,
    SkillBook
    End,
    StatusUpdate
    End,
    MonsterBrain
    End,
    ExperienceModule
      ExperienceValue = 45
      ExperienceRequired = [0, 0, 0]
    End
  ]

  SenseRadius = 45
  ChaseRadius = 95
  CloseDistance = 4
  AlertRadius = 70
  RepathFrames = 10
  SwingFrames = 12
  ; Never on a floor of the descent: the open world's camps place it by name.
  MinDepth = 99
  Weight = 0
  SkillDistance = [0, 50]
  Colour = 0x9AA0B0
  Scale = 1.33
  Model = models/characters/monsters/goleling.glb
  ModelScale = 6.3
  Tint = 0x9AA0B0
  ; Its own clips, renamed by art/monsters/export_monsters.py.
  Idle = Idle
  Walk = Walk
  Attack = Attack
  Death = Death
  UpperBody = Torso

  Skills = [
    Skill
      Key = R
      ; Elite affix: a quarter of every blow turned aside, and a little health back each second.
      Effect = DRAGON_BLOOD
      BoostPercent = 25
      Heal = 3
      MaxRank = 1
      Name = Toshteri
    End,
    Skill
      Key = W
      ; Elite affix: strikes faster for five seconds -- itself, or the sturdiest of its own near it.
      Effect = HASTE
      BoostPercent = 60
      DurationFrames = 150
      Range = 50
      CooldownFrames = 300
      Look = Hasted
      MaxRank = 1
      Name = Shiddat
      Icon = icons/stats/stat_speed.png
      Blurb = Bir necha soniya ancha tezroq uradi.
    End
  ]
End

