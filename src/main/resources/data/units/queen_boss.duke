; ---------------------------------------------------------------------------
; The queen fought: the last boss (docs/plan/2026-10-09-final-fight.md). The queen who
; talks and hands out the medallion is the person of data/units/queen.duke.
; She fights in phases -- her Boss block in data/story/final.duke: first from afar,
; no blow taking anything from her, while the cursed hero fights for her; then, once
; he is beaten, herself, every skill hers. Her death breaks the medallion.
;
; Her look is the "Dark Elf Shadow Enchantress" where that licensed model is shipped (Licensed,
; below); without it, the stand-in: the KayKit mage, as the merchant is, tinted toward a queen's violet.
; ---------------------------------------------------------------------------
Monster
  Name = QueenBoss
  DisplayName = Malika
  KindOf = [INFANTRY, SELECTABLE, CAN_ATTACK]
  Geometry = Cylinder
    Radius = 5
    Height = 13
  End
  VisionRange = 130
  Modules = [
    GrowableBody
      MaxHealth = 600
    End,
    MoveUpdate
      Speed = 12
      TurnRate = 0
    End,
    WeaponUpdate
      Damage = 22
      AttackRange = 62
      ReloadFrames = 45
      AttackOnTheMove = No
    End,
    Bow
      Projectile = MageBolt
      Speed = 200
      MuzzleOffset = 8
    End,
    EyesOnly
    End,
    Swing
    End,
    SkillBook
    End,
    StatusUpdate
    End,
    MonsterBrain
    End,
    ExperienceModule
      ExperienceValue = 400
      ExperienceRequired = [0, 0, 0]
    End
  ]

  SenseRadius = 70
  ChaseRadius = 220
  CloseDistance = 50
  AlertRadius = 120
  RepathFrames = 8
  SwingFrames = 18
  ; She fights from afar: she keeps her distance and casts across it.
  SkillDistance = [20, 70]
  KeepDistance = [40, 60]
  Attack = Ranged_Magic_Shoot
  Idle = Ranged_Magic_Spellcasting_Long
  ; Never drawn into a floor: a map puts her.
  MinDepth = 99
  Weight = 0
  Colour = 0x9A5AC8
  Scale = 1.0
  Model = models/heroes/mage.glb
  Tint = 0xB48CE6
  ; The mage boxes about 2.655 tall: 13 / 2.655.
  ModelScale = 4.9
  Facing = 90
  Animations = Humanoid
  ; Moves at a jog, not a walk: Running_A at about its own pace rather than Walking_A several times over.
  Walk = Running_A
  ; How far one play of its walk carries it, measured off the clip (MonsterClipFitTest): its feet stay put.
  WalkStride = 13.21
  UpperBody = spine
  Held = Held
    Model = models/heroes/staff.gltf
    Bone = handslot.r
  End
  ; Empty-handed: her own file has no staff and no bone to hang one on.
  ; ★ LICENSED LOOK. Drawn as the "Dark Elf Shadow Enchantress" (CGTrader, Royalty Free -- see CREDITS.md) where
  ; models/licensed/queen.glb is shipped: it lives in the git-ignored licensed-assets/ folder,
  ; never in this repository, so a clone without it (and CI) draws the stand-in above. Her clips
  ; are in her own file (art/licensed/export_licensed.py), her size 13 units over her 1.7, and
  ; WalkStride is how far one play of her Walk carries her at that size, so her feet stay put.
  Licensed = MonsterLook
    Model = models/licensed/queen.glb
    ModelScale = 7.65
    Facing = 90
    Idle = Cast_Idle
    ; The fighting walk, Quaternius' formal one as it was: the slow regal Walk is the person's, not the boss's.
    Walk = Walk_Fight
    Attack = Attack
    Death = Death
    WalkStride = 10.3
    UpperBody = spine
  End

  ; Which of these she casts is her phase's (Skills = [...] in her Boss block).
  Skills = [
    Skill
      Key = Q
      Effect = SKILLSHOT
      Damage = 50
      Range = 70
      Radius = 16
      HitWidth = 6
      ProjectileSpeed = 130
      Projectile = SkullFireball
      StunFrames = 30
      CooldownFrames = 150
      ManaCost = 0
      MaxRank = 1
      Name = Olov shari
    End,
    Skill
      Key = W
      Effect = METEOR
      Damage = 110
      Radius = 30
      Range = 70
      WindUpFrames = 45
      Projectile = SkullMeteorMark
      CooldownFrames = 420
      ManaCost = 0
      MaxRank = 1
      Name = Meteor
    End
  ]
End
