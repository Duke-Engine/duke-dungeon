; ---------------------------------------------------------------------------
; A merchant: a person who trades. Like the commander he is on the engine's
; neutral side, has no Body and is never drawn into a floor (Weight 0); he has
; legs, and strolls round where the map puts him (his Npc's Wander). What he
; sells is his Merchant block in data/story/trade.duke.
;
; His look is a stand-in: the KayKit mage, tinted toward a merchant's brown.
; ---------------------------------------------------------------------------
Monster
  Name = Merchant
  DisplayName = Savdogar Botir
  KindOf = [INFANTRY, SELECTABLE]
  Geometry = Cylinder
    Radius = 4
    Height = 12
  End
  VisionRange = 0
  Modules = [
    MoveUpdate
      Speed = 10
      TurnRate = 0
    End
  ]
  MinDepth = 99
  Weight = 0
  Colour = 0xB08850
  Scale = 1.0
  ; Realistic since 2026-11-05: the workspace's models/merchant on the game rig, its clips in its file, 1 m = 6.667 units.
  Model = models/characters/realistic/merchant.glb
  ModelScale = 6.667
  Facing = 90
  Idle = Idle
  Walk = Walk
  ; How far one play of Walk carries it, measured off the clip (MonsterClipFitTest): its feet stay put.
  WalkStride = 8.35
  Attack = Attack
  Death = Death
  UpperBody = spine_01
End
