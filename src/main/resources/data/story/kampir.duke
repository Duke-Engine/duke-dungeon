; ---------------------------------------------------------------------------
; Yalmog'iz kampir's hut in the dark wood (maps/world, the zone Kampir_kulbasi):
; the old woman by her cauldron, the girl in her cage, the imp. Stubs only: she
; hints that she knows the queen's secret, the girl asks for help. The Act 2
; conversation and what freeing the girl is worth are the owner's to decide --
; see docs/plan/2026-10-01-campaign.md.
; ---------------------------------------------------------------------------

Speaker
  Name = BabaYaga
  DisplayName = "Yalmog'iz kampir"
  Picture =
End

Speaker
  Name = Damsel
  DisplayName = Qiz
  Picture =
End

Conversation
  Name = KampirGreets
  Lines = [
    Line
      Speaker = BabaYaga
      Text = "Oho, mehmon... Qorong'i o'rmonga o'z oyog'i bilan kelgan qahramonni ko'pdan beri ko'rmagandim."
    End,
    Line
      Speaker = BabaYaga
      Text = "Malikangning bo'ynidagi medalyon... Uni kim yasaganini bilasanmi? Men bilaman, bolam."
    End,
    Line
      Speaker = BabaYaga
      Text = "Har bir sirning bahosi bor. Hali vaqti emas — qaytib kel, shunda gaplashamiz."
    End
  ]
End

; Asked for the secret (Act 2, data/story/act2.duke): her price.
Conversation
  Name = KampirsPrice
  Lines = [
    Line
      Speaker = BabaYaga
      Text = "Sirni bilmoqchimisan, qizim? Bepul emas. Avval mening ishimni bajar."
    End,
    Line
      Speaker = BabaYaga
      Text = "O'rmonimda bir o'likchi kezadi — qabrlarimni o'g'irlab, jonlarni o'ziga bo'ysundiradi."
    End,
    Line
      Speaker = BabaYaga
      Text = "Uni yo'q qil. Qaytib kelganingda, malikangning sirini aytaman."
    End
  ]
End

; Her price paid: the queen's secret, and how to end it (the campaign's Act 2).
Conversation
  Name = KampirsSecret
  Lines = [
    Line
      Speaker = BabaYaga
      Text = "Bajarding... Unda eshit. Medalyonni men yasaganman — malikaning buyurtmasi bilan."
    End,
    Line
      Speaker = BabaYaga
      Text = "U har bir o'ldirilgan dushmanning jonini yutadi. O'sha jonlar malikani abadiy yosh va go'zal saqlaydi."
    End,
    Line
      Speaker = BabaYaga
      Text = "Qahramon medalyonni to'ldiradi — so'ng u qahramonni ham yutadi. Sening yigiting endi qora qasrda, la'nat ichida."
    End,
    Line
      Speaker = BabaYaga
      Text = "U urushni to'xtatmaydi — malika esa yangi qahramonlar chaqiraveradi. Seni ham shu nur olib keldi."
    End,
    Line
      Speaker = Hero
      Text = "Qanday tugataman?"
    End,
    Line
      Speaker = BabaYaga
      Text = "Malikani o'ldir. Medalyon sinadi, jonlar ozod bo'ladi, la'nat ko'tariladi. Ammo uning qasri sehr bilan yopiq."
    End,
    Line
      Speaker = BabaYaga
      Text = "Avval bosib olingan yerlarni ozod qil: uchta qal'a — Yashil dala, Toshli adir, Qumli dasht. Ularsiz darvoza ochilmaydi."
    End
  ]
End

Conversation
  Name = DamselAsks
  Lines = [
    Line
      Speaker = Damsel
      Text = "Iltimos, meni bu qafasdan chiqaring! Kampir qozonidan qaytmasidan oldin..."
    End,
    Line
      Speaker = Damsel
      Text = "Kalit o'sha o'likchida — u meni kampirga sotgan. Uni o'ldirsangiz, kalit sizniki."
    End
  ]
  Starts = [CagedGirl]
End

Npc
  Name = BabaYaga
  Talk = KampirGreets
  Role = Jodugar
  Radius = 30
End

Npc
  Name = Damsel
  Talk = DamselAsks
  Role = Asira
  Radius = 25
End

; Hers, and says nothing yet.
Npc
