; ---------------------------------------------------------------------------
; The queen's medallion and the hero's turning — see docs/plan/2026-10-09-medallion.md.
;
; Worn in the Tumor slot, it lends its wearer its passive, "Jon yutish" — the
; engine's SOUL_DRINK, its Skill block below: his book counts the soul of every
; enemy he kills, and every TickFrames souls make his blows and skills
; BoostPercent harder, up to Damage percent — while he wears it, never while it is
; only carried. The souls stay his, and are saved with the run. A soul is seen: a
; Wisp rises from the corpse and flies into him.
;
; The turning is the story's CURSE act (Target = the person it goes to): the
; medallion leaves his bag and appears in her hand (GivenLook played on her),
; his look darkens (his CursedWord, tinted by CursedRed/Green/Blue over
; CursedEaseFrames), he goes over to the monsters' side, out of the player's
; hands, and the act ends with TurnedWord on the banner.
; ---------------------------------------------------------------------------
Medallion
  Item = Medallion
  ; The card's and the buff row's word for the souls: "Jonlar: 37".
  SoulsWord = Jonlar
  Wisp = SoulWisp
  ; World units a frame: a cell (10) every two and a half frames.
  WispSpeed = 4
  CursedWord = CURSED
  ; Added to his own colour, so below nothing takes away: a cold, bloodless dark.
  CursedRed = -0.30
  CursedGreen = -0.40
  CursedBlue = -0.20
  CursedEaseFrames = 60
  GivenLook = SoulWisp
  GivenLookFrames = 90
  TurnedWord = "Qahramon la'natlandi"
End

; The medallion itself: worn, never dropped (Weight 0), never sold (a QUEST thing).
LootItem
  Name = Medallion
  DisplayName = Malikaning medalyoni
  Icon = icons/stats/stat_lifesteal.png
  Kind = QUEST
  Slot = Tumor
  ; Its passive, lent while it is worn: a soul for every enemy its wearer kills,
  ; every 10 souls 1% harder blows and skills, up to 20% (200 souls).
  Skills = [
    Skill
      Key = M
      Effect = SOUL_DRINK
      Name = "Jon yutish"
      TickFrames = 10
      BoostPercent = 1
      Damage = 20
      MaxRank = 1
    End
  ]
  Value = 0
  Weight = 0
End

; A soul in flight: no model, its effect is its body, at a man's chest height.
Projectile
  Name = SoulWisp
  DisplayName = Jon
  VisionRange = 0
  Height = 8
  Tint = 0xA8E8FF
  Effect = SoulWisp
  EffectOffset = 0
End

; A pale, cold light with a few motes shed behind it — the soul — and the same
; glow in the queen's hand as the medallion appears in it.
Effect
  Name = SoulWisp

  Layers = [
    Layer
      Name = Core
      Type = AURA
      Texture = kit/effects/particles/light_02.png
      Blend = Additive
      Cover = 0.2
      Count = 1
      Size = [6, 6]
      Colour = [0xD8F6FF, 0x8AD8FF]
      Alpha = [0.9, 0.9]
      FadeIn = 0.05
      FadeOut = 0.2
      PulseRate = 4
      PulseDepth = 0.3
    End,

    Layer
      Name = Motes
      Type = TRAIL
      Texture = kit/effects/particles/star_01.png
      Blend = Additive
      Count = 16
      Rate = 30
      Life = [0.3, 0.6]
      Size = [1.6, 0.3]
      Colour = [0xC8F0FF, 0x2A5A8A]
      Alpha = [1, 0]
      Speed = [1, 3]
      Direction = ALL
      Drag = 2
    End,

    Layer
      Name = Light
      Type = LIGHT
      LightColour = 0x9AD8FF
      LightPower = 1.2
      LightRadius = 14
    End
  ]
End

; ---------------------------------------------------------------------------
; The demo: maps/medalyon. The queen gives him her medallion; the hall's
; skeletons feed it; at the altar it drinks him whole.
; ---------------------------------------------------------------------------

Speaker
  Name = Queen
  DisplayName = Malika
  ; No picture of her yet: the box frames the first letter of her name.
  Picture =
End

Npc
  Name = Queen
  Talk = QueenGives
  Role = Malika
  Radius = 30
End

Conversation
  Name = QueenGives
  Lines = [
    Line
      Speaker = Queen
      Text = "Xush kelibsiz, qahramon. Saltanatimda qahramon qolmadi — siz oxirgisisiz."
    End,
    Line
      Speaker = Queen
      Text = "Bu medalyonni taqing. U siz o'ldirgan har bir dushmanning jonini yutib, kuchini sizga quyadi."
    End,
    Line
      Speaker = Queen
      Text = "Uni faqat qahramon taqa oladi. Zalga boring, so'ng mehrobga."
    End,
    Line
      Speaker = Hero
      Text = "Rahmat, malikam."
    End
  ]
End

Conversation
  Name = QueenTakes
  Lines = [
    Line
      Speaker = Queen
      Text = "Medalyon to'ldi. Rahmat, qahramon — u yana mening qo'limda."
    End,
    Line
      Speaker = Queen
      Text = "Endi siz menikisiz."
    End
  ]
End

Cutscene
  Name = Turned
  Shots = [
    Shot
      ; On him as the dark comes over him...
      Zone = Altar
      Frames = 1
      Hold = 60
    End,
    Shot
      ; ...then to the throne, where the medallion has appeared in her hand...
      Zone = Throne
      Frames = 60
      Hold = 20
    End,
    Shot
      ; ...and what she says of it.
      Says = QueenTakes
      Hold = 30
    End
  ]
End

Trigger
  Name = MedallionGiven
  Map = medalyon
  When = HEARD
  Target = QueenGives
  Actions = [
    Action
      Act = GIVE
      Target = Medallion
    End
  ]
End

Trigger
  Name = Turning
  Map = medalyon
  When = ZONE
  Target = Altar
  ; Only a hero who wears the medallion is taken: one who carries it in his pack, or has none, walks by.
  If = [
    Condition
      Is = WEARS
      Target = Medallion
    End
  ]
  Actions = [
    Action
      Act = CURSE
      Target = Queen
    End,
    Action
      Act = CUTSCENE
      Target = Turned
    End
  ]
End
