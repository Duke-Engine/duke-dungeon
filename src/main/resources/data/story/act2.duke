; ===========================================================================
; The arrival.
; ===========================================================================

Conversation
  Name = HeroineArrives
  Lines = [
    Line
      Speaker = Hero
      Text = "Yana o'sha nur... Yillar davomida uni izladim — va shu nur meni ham olib keldi."
    End,
    Line
      Speaker = Hero
      Text = "U shu dunyoda. Bilaman."
    End
  ]
End

Conversation
  Name = CommanderMeetsHer
  Lines = [
    Line
      Speaker = Act1Commander
      Text = "Yana nur... Saltanat yana qahramon chaqirdi. Sen kimsan?"
    End,
    Line
      Speaker = Hero
      Text = "Men bir yigitni izlayapman. U bundan yillar oldin shu yerga tushgan — qilichli, bir oz sarosimada."
    End,
    Line
      Speaker = Act1Commander
      Text = "Oxirgi qahramon... U qora qasrga ketdi va qaytmadi. Malika u haqda gapirishni taqiqlagan."
    End,
    Line
      Speaker = Act1Commander
      Text = "Men senga ko'p narsa aytolmayman. Shaharda so'ra — odamlar men aytolmaganni biladi."
    End
  ]
End

Conversation
  Name = BakerTalks
  Lines = [
    Line
      Speaker = Baker
      Text = "Qahramon? Ha, bir vaqtlar bor edi. Endi uning nomini aytish ham qo'rqinchli. Qora qasrdan yovuzlik keladi, deyishadi."
    End
  ]
End

Conversation
  Name = GuardTalks
  Lines = [
    Line
      Speaker = Guard
      Text = "Yigirma yil qorovullik qildim — malika bir kun ham qarimadi. Ajib, a? Lekin buni men aytmadim."
    End
  ]
End

Conversation
  Name = ElderTalks
  Lines = [
    Line
      Speaker = Elder
      Text = "Bobom yosh bo'lganida ham malika shunday go'zal edi. Uning yoshini hech kim bilmaydi..."
    End
  ]
End

Conversation
  Name = ElderKnows
  Lines = [
    Line
      Speaker = Elder
      Text = "Qahramonni izlayapsanmi? Unda malikaning sirini bil — u bilan birga."
    End,
    Line
      Speaker = Elder
      Text = "Qorong'i o'rmonning tubida, tovuq oyoqli kulbada Yalmog'iz kampir yashaydi. Malikaning sirini faqat u biladi."
    End,
    Line
      Speaker = Hero
      Text = "Unda o'rmonga boraman."
    End
  ]
End

Quest
  Name = Rumours
  Kind = MAIN
  Title = "Uni izlab"
  Steps = [
    Step
      Goal = TALK
      Target = Elder
      Text = "Shaharda so'rab-surishtiring: oqsoqol nimadir biladi"
      Glow = Yes
      OnDone = Done
        Says = ElderKnows
        Experience = 60
        Starts = Witch
      End
    End
  ]
End

Cutscene
  Name = HeroineLands
  Shots = [
    Shot
      ; The beam over the capital's square, and her in it: low and close, settling as she lands.
      Zone = Arrival
      Frames = 30
      Hold = 40
      Pitch = 30
      Zoom = 85
      Ease = OUT
    End,
    Shot
      Says = HeroineArrives
      Hold = 10
    End
  ]
End

; The capital's people, every time the world is laid in the act (a load lays it again).
Trigger
  Name = CapitalPeople
  Map = world
  When = MAP_START
  Repeat = Yes
  If = [
    Condition
      Is = FLAG_SET
      Target = Act2
    End
  ]
  Actions = [
    Action
      Act = SPAWN
      Target = Act1Commander
      Zone = CommanderSpot
    End,
    Action
      Act = SPAWN
      Target = Baker
      Zone = BakerSpot
    End,
    Action
      Act = SPAWN
      Target = Guard
      Zone = GuardSpot
    End,
    Action
      Act = SPAWN
      Target = Elder
      Zone = ElderSpot
    End
  ]
End

Trigger
  Name = HeroineComes
  Map = world
  When = MAP_START
  If = [
    Condition
      Is = FLAG_SET
      Target = Act2
    End,
    Condition
      Is = FLAG_UNSET
      Target = HeroineArrived
    End
  ]
  Actions = [
    Action
      Act = TITLE
      Target = ChapterArrival
    End,
    Action
      Act = EFFECT
      Target = SkyLight
      Zone = Arrival
    End,
    Action
      Act = FALL
      Target = Hero
      Zone = Arrival
      Height = 140
      Frames = 30
      Landed = HeroLandsDust
    End,
    Action
      Act = FLAG
      Target = HeroineArrived
    End,
    Action
      Act = CUTSCENE
      Target = HeroineLands
    End
  ]
End

Trigger
  Name = CommanderMeets
  Map = world
  When = SEEN
  Target = HeroineLands
  Actions = [
    Action
      Act = WALK
      Target = Act1Commander
      Zone = Arrival
    End,
    Action
      Act = SAY
      Target = CommanderMeetsHer
    End,
    Action
      Act = START_QUEST
      Target = Rumours
    End,
    Action
      Act = CHECKPOINT
    End
  ]
End

; ===========================================================================
; The witch in the dark wood, her price, her secret; the caged girl.
; ===========================================================================

Quest
  Name = Witch
  Kind = MAIN
  Title = "Qorong'i o'rmondagi kampir"
  Steps = [
    Step
      Goal = TALK
      Target = BabaYaga
      Text = "Qorong'i o'rmon tubidagi Yalmog'iz kampirni toping"
      Glow = Yes
      OnDone = Done
        Says = KampirsPrice
        Starts = WitchsPrice
      End
    End
  ]
End

Quest
  Name = WitchsPrice
  Kind = MAIN
  Title = "Kampirning bahosi"
  Steps = [
    Step
      Goal = KILL
      Target = Necromancer
      Where = Kampir_kulbasi
      Text = "O'rmondagi o'likchini o'ldiring"
      Glow = Yes
    End,
    Step
      Goal = TALK
      Target = BabaYaga
      Text = "Kampirga qayting"
      OnDone = Done
        Says = KampirsSecret
        Experience = 200
      End
    End
  ]
End

; The necromancer she wants dead: one stands in her wood whatever came before.
Trigger
  Name = NecromancerWaits
  Map = world
  When = QUEST_STARTED
  Target = WitchsPrice
  Actions = [
    Action
      Act = SPAWN
      Target = Necromancer
      Zone = NecroLair
    End
  ]
End

; The secret told: the lands to free.
Trigger
  Name = SecretTold
  Map = world
  When = QUEST_DONE
  Target = WitchsPrice
  Actions = [
    Action
      Act = FLAG
      Target = SecretKnown
    End,
    Action
      Act = START_QUEST
      Target = FreeGreen
    End,
    Action
      Act = START_QUEST
      Target = FreeRocky
    End,
    Action
      Act = START_QUEST
      Target = FreeSand
    End,
    Action
      Act = CHECKPOINT
    End
  ]
End

; The caged girl (STAND-IN name "Qiz"; her role is the owner's): the key is the necromancer's.
LootItem
  Name = CageKey
  DisplayName = "Qafas kaliti"
  Icon = icons/items/key.png
  Kind = QUEST
  Value = 0
  Weight = 0
End

Conversation
  Name = DamselFreed
  Lines = [
    Line
      Speaker = Damsel
      Text = "Ozodman! Rahmat, opa. Kampir sizga sirni aytsa — ishoning, u yolg'on gapirmaydi. Faqat narxini so'raydi."
    End
  ]
End

Quest
  Name = CagedGirl
  Kind = SIDE
  Title = "Qafasdagi qiz"
  Steps = [
    Step
      Goal = COLLECT
      Target = CageKey
      Where = Kampir_kulbasi
      Text = "Qafas kalitini o'likchidan oling"
    End,
    Step
      Goal = GIVE
      Target = Damsel
      Item = CageKey
      Text = "Qizni qafasdan chiqaring"
      OnDone = Done
        Says = DamselFreed
        Experience = 120
        Item = Ring
      End
    End
  ]
End

Trigger
  Name = KeyFromTheNecromancer
  Map = world
  When = DIED
  Target = Necromancer
  If = [
    Condition
      Is = FLAG_SET
      Target = Act2
    End
  ]
  Actions = [
    Action
      Act = GIVE
      Target = CageKey
    End
  ]
End

