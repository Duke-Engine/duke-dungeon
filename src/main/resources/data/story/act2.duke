; ===========================================================================
; The caged girl let out: the cage opens, she steps out and goes to the capital, where the
; commander is; the empty cage stays swinging on its gibbet.
; ===========================================================================

Place
  Map = world
  ; The cell under her cage (the map's Npcs: Damsel 39 89).
  Zone = "CageSpot 39 89 1"
End

Place
  Map = world
  ; By the commander on the capital's square.
  Zone = "GirlHome 123 463 1"
End

Conversation
  Name = GirlAtHome
  Lines = [
    Line
      Speaker = Damsel
      Text = "Siz bo'lmaganingizda, hali ham o'sha qafasda bo'lardim. Qo'mondon menga boshpana berdi."
    End
  ]
End

; Out of her cage: the same girl, walking (STAND-IN name, Qiz).
Npc
  Name = FreedDamsel
  Talk = GirlAtHome
  Role = Ozod
  Radius = 25
End

; The empty cage: a thing that stands, says nothing and is nobody's.
