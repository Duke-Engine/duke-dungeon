      ; The castle over its walls, the camera drawing back and up as its gate opens.
      Zone = Malika_qasri
      Frames = 60
      Hold = 30
      Pitch = 60
      Zoom = 200
      Ease = IN_OUT
    End
  ]
End

Trigger
  Name = CastleOpens
  Map = world
  When = ZONE
  Target = Malika_qasri
  If = [
    Condition
      Is = FLAG_SET
      Target = LandsFreed
    End
  ]
  Actions = [
    Action
      Act = EFFECT
      Target = SkyLight
      Zone = Malika_qasri
    End,
    Action
      Act = CUTSCENE
      Target = GateOpens
    End
  ]
End

Trigger
