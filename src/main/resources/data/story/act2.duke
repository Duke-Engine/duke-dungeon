  Radius = 1
End

Trigger
  Name = CageOpens
  Map = world
  When = QUEST_DONE
  Target = CagedGirl
  Actions = [
    Action
      Act = REMOVE
      Target = Damsel
    End,
    Action
      Act = SPAWN
      Target = EmptyCage
      Zone = CageSpot
    End,
    Action
      Act = SPAWN
      Target = FreedDamsel
      Zone = CageSpot
    End,
    Action
      Act = WALK
      Target = FreedDamsel
      Zone = GirlHome
    End,
    Action
      Act = FLAG
      Target = GirlFreed
    End,
    Action
      Act = CHECKPOINT
    End
  ]
End

; Laid again (a load, a death), she is home and the cage is empty.
Trigger
  Name = GirlStaysFree
  Map = world
  When = MAP_START
  Repeat = Yes
