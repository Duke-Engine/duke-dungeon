  Map = world
  When = SEEN
  Target = GateOpens
  Actions = [
    Action
      Act = MAP
      Target = hall
    End
  ]
End

; ===========================================================================
; The queen's hall (maps/hall, data/story/final.duke): its chapter card, and the cursed hero grown
; to the level Act 1's hero reached (act1Level=N, carried) — the player's own.
; ===========================================================================

Trigger
  Name = HallOpens
  Map = hall
  When = MAP_START
  Actions = [
    Action
      Act = TITLE
      Target = ChapterHall
    End
  ]
End

Trigger
  Name = HisOwnLevel
  Map = hall
  When = MAP_START
  If = [
    Condition
      Is = FLAG_SET
      Target = Act2
    End
  ]
  Actions = [
    Action
      Act = GROW
      Target = CursedHero
      Count = 10
    End
  ]
End

; The ending played (final.duke's TheEnd): "Oxiri", the credits, and the front menu.
Trigger
  Name = EndCard
  Map = hall
  When = AFTER
  Target = TheEnd
  Delay = 90
  Actions = [
    Action
      Act = TITLE
      Target = TheEndCard
    End
  ]
End

; ---------------------------------------------------------------------------
; Title cards: the act's chapters and the end. The credits are data/story/credits.duke.
; ---------------------------------------------------------------------------

Title
  Name = ChapterArrival
  Text = "2-qism: Kamonchi"
  Subtext = "Yillar o'tib"
End

Title
  Name = ChapterHall
  Text = "Malika zali"
  Subtext = "2-qism"
End

Title
  Name = TheEndCard
  Text = Oxiri
  Subtext = "La'nat ko'tarildi"
  FadeIn = 1.5
  Hold = 4
  FadeOut = 1.5
End

