; ---------------------------------------------------------------------------
; Act 2, as quests in the open world (maps/world) — see docs/plan/2026-10-15-act2.md.
;
; Years on, by the kingdom's summoning, the heroine — the Rogue (her DisplayName, Erika, is the
; STAND-IN name) — lands in the capital. The commander meets her; the city's talk sends her to the
; witch in the dark wood (Yalmog'iz kampir), who tells the queen's secret once her price is paid,
; and the caged girl asks to be let out. The three conquered lands are freed, the queen's castle
; opens, and the end is the final fight's hall (maps/hall, data/story/final.duke): she spares him,
; the queen dies, the souls rise — then "Oxiri", the credits, and the front menu.
;
; The triggers that start things on the world ask If FLAG_SET Act2 (the act's own flag, set by its
; joints): the open world played on its own, off the stages list, stays as it was.
; ---------------------------------------------------------------------------

Campaign
  Name = act2
  Word = "2-qism: Kamonchi"
  Blurb = "Yillar o'tib, u yigitini izlab keladi. 1-qism saqlangan bo'lsa, o'sha yerdan davom etadi."
  Hero = Rogue
  ; Act 1's end save (data/story/act1.duke, SAVE act1): its flags, and its hero's level as act1Level=N —
  ; the level the cursed hero is grown to in the hall. With none, Act 1's hero is taken to have reached:
  Follows = act1
  DefaultLevel = 10
  ; In order; --act2=N skips straight to one (N from 1), with what the joints before it give.
  Joints = [
    Joint
      Map = world
      Flags = [Act2]
    End,
    Joint
      Map = world
      Flags = [Act2, HeroineArrived]
      Quests = [Witch]
      Experience = 300
      Gold = 60
      At = Kampir_kulbasi
    End,
    Joint
      Map = world
      Flags = [Act2, HeroineArrived, SecretKnown]
      Quests = [FreeGreen, FreeRocky, FreeSand]
      Experience = 900
      Gold = 150
      At = Yashil_dala
    End,
    Joint
      Map = world
      Flags = [Act2, HeroineArrived, SecretKnown, FreedGreen, FreedRocky, FreedSand, LandsFreed]
      Quests = [ToTheQueen]
      Experience = 1500
      Gold = 300
      At = CastleRoad
    End,
    Joint
      Map = hall
      Flags = [Act2, HeroineArrived, SecretKnown, FreedGreen, FreedRocky, FreedSand, LandsFreed]
      Experience = 1500
      Gold = 300
    End
  ]
End

