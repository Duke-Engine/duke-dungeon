; ---------------------------------------------------------------------------
; Gold and trading — see docs/plan/2026-10-08-people-and-trade.md.
;
; Every kill of the dungeon's pays the killer GoldPerKill + GoldPerLevel x its
; level, and a boss BossGold whatever its level. Kept small (the owner, 2026-10-19):
; gold is for a merchant's few good things, not a reward for every corpse.
; A merchant's Stock is "item price count" each; a map restocks him as its floor
; is laid. A thing sells for SellPercent of its price (a merchant's price,
; or BasePrice for one nobody stocks), times its level; quest things and keys do
; not sell.
; ---------------------------------------------------------------------------
Trade
  GoldPerKill = 1
  GoldPerLevel = 0
  BossGold = 10
  SellPercent = 40
  BasePrice = 30
  ; How often, in frames, a wandering person picks somewhere new to stroll to.
  WanderFrames = 150
  GoldWord = Oltin
  ; The coins drawn before the purse, wherever it is shown.
  GoldIcon = icons/items/gold.png
  ; The gold a kill paid, floated up over the corpse (see GoldBurst below); %d the gold. "+%d oltin" says the
  ; word as well.
  GainWord = "+%d"
  StockWord = Sotiladi
  BagWord = Xaltangiz
  CloseHint = "Esc — yopish"
  NoGoldWord = Oltin yetmaydi
  FullWord = Xalta to'la
  SoldOutWord = Qolmadi
  CantSellWord = Buni sotib bo'lmaydi
End

; What a kill that pays looks like -- drawing only, nothing the simulation reads. The coins: CoinLook
; played at the corpse once for every GoldPerBurst paid, at most MostBursts times, so a bigger purse is
; more coins. The number: the GainWord above, FloatHeight units over the corpse's feet, rising
; FloatRise of the window's height over FloatSeconds, solid for HoldShare of that and then fading, its
; letters TextSize of the window's height -- BigScale bigger from BigGold -- in Colour.
GoldBurst
  CoinLook = CoinBurst
  GoldPerBurst = 8
  MostBursts = 6
  FloatSeconds = 1.2
  HoldShare = 0.35
  FloatHeight = 16
  FloatRise = 0.07
  TextSize = 0.03
  BigGold = 30
  BigScale = 1.35
  Colour = 0xFFD447
End

; A handful of gold coins thrown up out of a corpse, spinning, bouncing on the ground and then flying
; into the hero who made the kill (GoldBurst plays it toward him), in about a second, with a glint as
; they leave. The coin is effects/coin.png, painted by
; art/icons/ItemIcons.java from game-icons.net's crown coin (Lorc, CC BY 3.0); a white Colour keeps its gold.
Effect
  Name = CoinBurst

  Layers = [
    Layer
      Name = Coins
      Type = BURST
      Texture = effects/coin.png
      Blend = Alpha
      Count = 4
      ; Up out of the corpse, down onto the ground under it at about 0.45 s, a hop that lands again at
      ; about 0.7, and from HomeDelay drawn into the hero whose kill it was, arriving as its life ends.
      Life = [1.05, 1.2]
      Size = [2.4, 2.0]
      SizeJitter = 0.2
      Colour = [0xFFFFFF, 0xFFFFFF]
      Alpha = [1, 1]
      FadeOut = 0.1
      Speed = [12, 18]
      Direction = UP
      Spread = 45
      Height = 3
      Gravity = 100
      ; The share of its speed a coin keeps as it strikes the ground.
      Bounce = 0.45
      ; Turns a second, over and over across the screen: a coin spinning.
      Flip = 2.5
      Home = Yes
      HomeDelay = 0.65
    End,

    Layer
      Name = Glint
      Type = BURST
      Texture = kit/effects/particles/star_01.png
      Blend = Additive
      Count = 3
      Life = [0.2, 0.4]
      Size = [3, 0.5]
      Colour = [0xFFF4B0, 0xFFB020]
      Alpha = [1, 0]
      Speed = [4, 8]
      Direction = UP
      Spread = 60
      Height = 7
    End
  ]
End

Speaker
  Name = Merchant
  DisplayName = Savdogar Botir
  Picture =
End

Conversation
  Name = MerchantGreets
  Lines = [
    Line
      Speaker = Merchant
      Text = "Xush kelibsiz! Oltiningiz bo'lsa, menda yaxshi mollar bor. Gaplashmoqchi bo'lsangiz, meni bosing."
    End
  ]
End

Npc
  Name = Merchant
  Talk = MerchantGreets
  Role = Savdogar
  Radius = 30
  Wander = 15
End

Merchant
  Name = Merchant
  Stock = [
    Gauntlet 80 2,
    Boots 80 2,
    Tome 80 2,
    Amulet 50 3,
    Ring 50 3,
    Whetstone 60 2,
    non 12 10,
    suv 5 10,
    qovurilgan_gosht 20 6,
    choy 15 6,
    shorva 40 3,
    ; Crafting's (docs/plan/2026-10-15-crafting.md): recipe scrolls and ember stones.
    chizma 80 3,
    olov_toshi 60 2,
    teri 6 10,
    ruda 8 10,
  ]
  ; And six things more, rolled at the hero's level each time a map stocks him (data/world/loot.duke).
  Gear = 6
End

; His own: never found, only bought (Weight 0).
LootItem
