; ---------------------------------------------------------------------------
; People, their talk and the quests — see docs/plan/2026-10-08-dialogue-and-quests.md.
;
; A Speaker is who a line may be said by (Hero needs no block: it is whoever the
; player plays). A Conversation is lines said in turn, and the quests it hands
; out. An Npc is a Monster template that talks: what it says and how near a hero
; comes before it does. A Quest is steps done in order, each a Goal — REACH a
; zone of the map, KILL Count of a Monster, COLLECT Count of a LootItem, TALK to
; an Npc, GIVE an Item to an Npc — its tracker Text (%d/%d the count so far and
; the count asked), and OnDone: a conversation, experience, an item, the next quest.
; Every name is checked when the files are read.
; ---------------------------------------------------------------------------

; The box at the bottom of the screen, and the marks over people's heads.
Dialogue
  ContinueHint = "Davom etish uchun bosing / Space"
  GiveMark = ui/cursors/default/mark_exclamation.png
  HandInMark = ui/cursors/default/mark_question.png
  MarkColour = 0xE8C15A
  ; How often, in frames, bags, zones and people's radii are looked at.
  CheckFrames = 10
End

Speaker
  Name = Commander
  DisplayName = "Qo'mondon Laylo"
  ; No picture of her yet: the box frames the first letter of her name.
  Picture =
End

; ---------------------------------------------------------------------------
; The demo: maps/talk. She greets him, sends him at the skeletons by the wall,
; and asks after the locket she lost in the far hall.
; ---------------------------------------------------------------------------

Conversation
  Name = CommanderGreets
  Lines = [
    Line
      Speaker = Commander
      Text = "Nihoyat keldingiz! Siz chaqirilgan qahramonsiz, to'g'rimi?"
    End,
    Line
      Speaker = Hero
      Text = "Men... qayerdaman? Bir lahza oldin mashq qilayotgan edim."
    End,
    Line
      Speaker = Commander
      Text = "Vaqt yo'q. Devor ortidagi zalda skeletlar to'planmoqda — beshtasini yo'q qiling."
    End,
    Line
      Speaker = Commander
      Text = "Va agar uzoq zalda tumorimni topsangiz — u menga onamdan qolgan."
    End
  ]
  Starts = [WallSkeletons, LostLocket]
End

Conversation
  Name = CommanderThanks
  Lines = [
    Line
      Speaker = Commander
      Text = "Beshtasi ham yo'q bo'ldi? Siz haqiqatan qahramonsiz."
    End,
    Line
      Speaker = Commander
      Text = "Mana, bu qo'lqopni oling. Endi zal oxiridagi qo'riqchini yengish qoldi."
    End
  ]
End

Conversation
  Name = LocketReturned
  Lines = [
    Line
      Speaker = Commander
      Text = "Tumorim! Rahmat. Buni hech qachon unutmayman."
    End
  ]
End

Npc
  Name = Commander
  Talk = CommanderGreets
  Radius = 30
End

Quest
  Name = WallSkeletons
  Kind = MAIN
  Title = "Devordagi skeletlar"
  Steps = [
    Step
      Goal = KILL
      Target = Skeleton
      Count = 5
      Text = "Skeletlarni qiring %d/%d"
    End,
    Step
      Goal = TALK
      Target = Commander
      Text = "Qo'mondonga qayting"
      OnDone = Done
        Says = CommanderThanks
        Experience = 150
        Item = Gauntlet
      End
    End
  ]
End

Quest
  Name = LostLocket
  Kind = SIDE
  Title = "Yo'qolgan tumor"
  Steps = [
    Step
      Goal = COLLECT
      Target = Locket
      Count = 1
      Text = "Uzoq zalda tumorni toping"
    End,
    Step
      Goal = GIVE
      Target = Commander
      Item = Locket
      Text = "Tumorni qo'mondonga bering"
      OnDone = Done
        Says = LocketReturned
        Experience = 80
      End
    End
  ]
End

; Her locket: a thing a quest asks for, which gives nothing and is never dropped.
LootItem
  Name = Locket
  DisplayName = Tumor
  Icon = icons/stats/stat_crit.png
  Kind = QUEST
  Value = 0
  Weight = 0
End

; ---------------------------------------------------------------------------
; The demo's story: a cutscene as he comes into the far hall, and an ambush once
; her skeletons are dealt with. See docs/plan/2026-10-08-story-scripting.md.
; ---------------------------------------------------------------------------

Conversation
  Name = CommanderSeesChest
  Lines = [
    Line
      Speaker = Commander
      Text = "Ana u — burchakdagi sandiq! Tumorim o'sha yerda bo'lishi kerak."
    End
  ]
End

Conversation
  Name = AmbushLine
  Lines = [
    Line
      Speaker = Commander
      Text = "Ehtiyot bo'ling! Ular orqamizdan kelishdi!"
    End
  ]
End

Cutscene
  Name = ChestReveal
  Shots = [
    Shot
      ; Two seconds' flight to the chest in the far corner, and a second looking at it.
      Zone = Chest
      Frames = 60
      Hold = 30
    End,
    Shot
      Says = CommanderSeesChest
      Hold = 15
    End
  ]
End

Trigger
  Name = HallSeen
  Map = talk
  When = ZONE
  Target = HallDoor
  Actions = [
    Action
      Act = CUTSCENE
      Target = ChestReveal
    End
  ]
End

Trigger
  Name = Ambush
  Map = talk
  When = QUEST_DONE
  Target = WallSkeletons
  Actions = [
    Action
      Act = SAY
      Target = AmbushLine
    End,
    Action
      Act = SPAWN
      Target = Skeleton
      Count = 3
      Zone = Ambush
    End,
    Action
      ; And she steps back to the wall, out of their way.
      Act = WALK
      Target = Commander
      Zone = Wall
    End
  ]
End
