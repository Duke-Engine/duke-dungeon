      LightRadius = 50
      Seconds = 1.5
      Height = 20
    End
  ]
End

; The nest's bats fly out once its rats are dead: the step after them, so every one of them counts.
Trigger
  Name = CellarBatsFly
  Map = world
  When = STEP_DONE
  Target = Cellar
  Step = 1
  Actions = [
    Action
      Act = SPAWN
      Target = Bat
      Count = 5
      Zone = "Yerto'la"
    End
  ]
End

; The capital overrun: rats in the market and the cellar, bats over the streets, from the hero's first
; coming in until the blacksmith's nest is cleared -- laid again whenever the world is (a load lays it fresh).
Trigger
  Name = PestsInTheCapital
  Map = world
  When = ZONE
  Target = Poytaxt
  If = [
    Condition
      Is = FLAG_SET
      Target = Act1
    End,
    Condition
      Is = FLAG_UNSET
      Target = PestsLaid
    End
  ]
  Actions = [
    Action
      Act = FLAG
      Target = PestsLaid
    End,
    Action
      Act = SPAWN
      Target = Rat
      Count = 4
      Zone = Bozor
    End,
    Action
      Act = SPAWN
      Target = Bat
      Count = 3
      Zone = Poytaxt
    End,
    Action
      Act = SPAWN
      Target = Rat
      Count = 2
      Zone = "Yerto'la"
    End
  ]
End

Trigger
  Name = PestsLaidAgain
  Map = world
  When = MAP_START
  Repeat = Yes
  If = [
    Condition
      Is = FLAG_SET
      Target = Act1
    End,
    Condition
      Is = FLAG_SET
      Target = PestsLaid
    End,
    Condition
      Is = FLAG_UNSET
      Target = PestsGone
    End
  ]
  Actions = [
    Action
      Act = SPAWN
      Target = Rat
      Count = 4
      Zone = Bozor
    End,
    Action
      Act = SPAWN
      Target = Bat
      Count = 3
      Zone = Poytaxt
    End
  ]
End

Trigger
  Name = PestsGone
  Map = world
  When = QUEST_DONE
  Target = Cellar
  Actions = [
    Action
      Act = FLAG
      Target = PestsGone
    End
  ]
End
