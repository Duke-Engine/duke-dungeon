      Act = SPAWN
      Target = Act1Queen
      Count = 1
      Zone = Vision
    End,
    Action
      Act = CURSE
      Target = Act1Queen
    End,
    Action
      Act = SAVE
      Target = act1
    End,
    Action
      Act = CUTSCENE
      Target = TurningAct1
    End
  ]
End

Trigger
  Name = ActOneEnds
  Map = qora_qasr
  When = SEEN
  Target = TurningAct1
