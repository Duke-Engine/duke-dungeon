    Condition
      Is = FLAG_SET
      Target = Act1
    End
  ]
  Target = Cellar
  Actions = [
    Action
      Act = SPAWN
      Target = Rat
      Count = 5
      Zone = "Yerto'la"
    End
  ]
End

; The ring lies in the cellar while she wants it and nobody has picked it up: laid as her ask is
; taken, and again whenever the world is laid (a load lays it fresh).
Trigger
  Name = RingLies
  Map = world
  When = QUEST_STARTED
  If = [
    Condition
      Is = FLAG_SET
      Target = Act1
    End
  ]
  Target = LostRing
  Actions = [
    Action
      Act = LAY
      Target = FamilyRing
      Zone = "Yerto'la"
    End
  ]
End

Trigger
  Name = RingLiesAgain
  Map = world
  When = MAP_START
  Repeat = Yes
  If = [
    Condition
      Is = QUEST_ACTIVE
      Target = LostRing
    End,
    Condition
      Is = LACKS
      Target = FamilyRing
    End
  ]
  Actions = [
    Action
      Act = LAY
      Target = FamilyRing
      Zone = "Yerto'la"
    End
  ]
End

