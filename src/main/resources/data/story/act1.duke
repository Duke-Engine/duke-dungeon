;    (docs/plan/2026-10-19-open-world-act1.md).
; ===========================================================================

Conversation
  Name = SoldiersCome
  Lines = [
    Line
      Speaker = Act1Commander
      Text = "Askarlar shu yerda. Sehrgarni o'ldiring — qolganini birga bitiramiz!"
    End
  ]
End

Conversation
  Name = CaveSeen
  Lines = [
    Line
      Speaker = Hero
      Text = "Anavi nima? Tog' etagida — qop-qora og'iz."
    End,
    Line
      Speaker = Act1Commander
      Text = "G'or. Ichi monstrlarga to'la. Qora ritsar hukmronlik qila boshlagandan beri bunaqa g'orlar ko'payib ketdi."
    End,
    Line
      Speaker = Act1Commander
      Text = "Uni yo'q qilish uchun ichidagi barcha monstrlarni o'ldirish kerak. Lekin u yerdan hali hech kim qaytib kelmagan."
    End,
    Line
      Speaker = Hero
      Text = "Qora ritsarning qarorgohi qayerda?"
    End,
    Line
      Speaker = Act1Commander
      Text = "Shimolda. Tog'lar ortida."
    End
  ]
End

Conversation
  Name = CityAttacked
  Lines = [
    Line
      Speaker = Soqchi
      Text = "Qo'mondon! Shaharga hujum qilishdi! Darvoza zo'rg'a turibdi!"
    End,
    Line
      Speaker = Act1Commander
      Text = "Biz shahar himoyasiga qaytishimiz kerak."
    End,
    Line
      Speaker = Hero
      Text = "Siz boravering. Men Qora ritsarni topaman va buning barchasiga chek qo'yaman."
    End,
    Line
      Speaker = Act1Commander
      Text = "Omad yor bo'lsin. Bilib qo'y: uning oldiga borguningcha iloji boricha ko'proq g'or va qabrlarni yo'q qil. Ular unga kuch beradi."
    End
  ]
End

; At the graves: the soldiers the queen gave come up, and the commander with them.
Trigger
  Name = TrainingBegins
  Map = world
  When = STEP_DONE
  Target = Training
  Step = 1
  Actions = [
