; ===========================================================================
; 5. qora_qasr — the dark castle, its lord, and the turning.
; ===========================================================================

Conversation
  Name = DarkLordWarns
  Lines = [
    Line
      Speaker = DarkLord
      Text = "Yana bittasi... Malika seni ham yubordimi?"
    End,
    Line
      Speaker = Hero
      Text = "Seni o'ldirsam, uyga qaytaman."
    End,
    Line
      Speaker = DarkLord
      Text = "Men ham bir vaqtlar shunday deganman."
    End
  ]
End

Conversation
  Name = QueenLaughs
  Lines = [
    Line
      Speaker = Act1Queen
      Text = "Ha-ha-ha... Rahmat, qahramon."
    End,
    Line
      Speaker = Act1Queen
      Text = "Medalyon to'ldi — va u yana mening qo'limda."
    End,
    Line
      Speaker = Hero
      Text = "Sen... meni aldading. Qora ritsar ham men kabi chaqirilgan edi..."
    End,
    Line
      Speaker = Act1Queen
      Text = "Endi bu qasrning xo'jayini sensan. Abadiy. Menga yangi qahramon kerak bo'lganda — yana jang qilasan."
    End
  ]
End

Quest
  Name = DarkCastle
  Kind = MAIN
  Title = "Qora qasr"
  Steps = [
    Step
      Goal = KILL
      Target = DarkLord
      Where = Throne
      Text = "Qora ritsarni o'ldiring"
      Glow = Yes
    End
  ]
End

Cutscene
  Name = CastleShown
  Shots = [
    Shot
      Zone = Throne
      Frames = 60
      Hold = 20
    End,
    Shot
      Says = DarkLordWarns
      Hold = 10
    End
  ]
End

Cutscene
  Name = TurningAct1
  Shots = [
    Shot
      ; On him, where the lord fell, looking down close as the dark comes over him...
      Zone = Throne
      Frames = 40
      Hold = 30
      Pitch = 70
      Zoom = 60
      Ease = IN_OUT
    End,
    Shot
      ; ...then to her, come in a vision, the medallion in her hand, seen level...
      Zone = Vision
      Frames = 45
      Hold = 20
      Pitch = 25
      Zoom = 80
      Ease = IN_OUT
    End,
    Shot
      Says = QueenLaughs
      Hold = 20
    End,
    Shot
      ; ...and back to him, drawn slowly up and away: bound to the castle.
      Zone = Throne
      Frames = 90
      Hold = 30
      Pitch = 65
      Zoom = 230
      Ease = IN
    End
  ]
End

Trigger
  Name = CastleEntered
  Map = qora_qasr
  When = MAP_START
  Actions = [
    Action
      ; The chapter's name over the screen as it opens.
      Act = TITLE
      Target = ChapterCastle
    End,
    Action
      Act = CUTSCENE
      Target = CastleShown
    End
  ]
End

; The lord dies, and the medallion drinks him whole: it leaves the hero for the queen's hand, he
; darkens and goes over to the monsters — and the act ends, saved for Act 2.
Trigger
  Name = TheTurning
  Map = qora_qasr
  When = DIED
  Target = DarkLord
  Actions = [
    Action
      Act = SPAWN
      Target = Act1Queen
      Count = 1
      Zone = Vision
    End,
    Action
      Act = CURSE
      Target = Act1Queen
    End,
    Action
      Act = SAVE
      Target = act1
    End,
    Action
      Act = CUTSCENE
      Target = TurningAct1
    End
  ]
End

Trigger
  Name = ActOneEnds
  Map = qora_qasr
  When = SEEN
  Target = TurningAct1
  Actions = [
    Action
      ; The act's end as a card, the turning's banner cleared for it (a WIN that says nothing, after the win).
      Act = WIN
    End,
    Action
      Act = TITLE
      Target = ActOneEnd
    End
  ]
End

