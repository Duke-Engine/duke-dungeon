; The ground cracking under him as he lands out of the sky: dust thrown out, a ring of light along the ground,
; and a knock of the camera.
Effect
  Name = HeroLandsDust
  ShakeSeconds = 0.4
  ShakePower = 2.0
  Layers = [
    Layer
      Name = Dust
      Type = BURST
      Texture = kit/effects/particles/smoke_01.png
      Blend = Alpha
      Cover = 0.6
      Count = 22
      Life = [0.9, 1.5]
      Size = [4, 10]
      Colour = [0xB0A890, 0x706858]
      Alpha = [0.7, 0]
      Speed = [10, 20]
      Direction = OUT
      Spread = 15
      Radius = 3
      Height = 1
      TurnJitter = 360
    End,
    Layer
      Name = Ring
      Type = RING
      Texture = kit/effects/particles/circle_05.png
      Blend = Additive
      Count = 1
      Life = [0.6, 0.6]
      Size = [6, 36]
      Colour = [0xFFF0C0, 0xC09040]
      Alpha = [0.8, 0]
      Height = 0.2
    End
  ]
End

