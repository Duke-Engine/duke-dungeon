; People: none of the act's greet of themselves but the queen and the townsfolk; the commander
; speaks through the story.
Npc
  Name = Act1Commander
  Role = "Qo'mondon"
  Radius = 30
End

Npc
  Name = Act1Queen
  Talk = QueenWelcome
  Role = Malika
  Radius = 34
End

Npc
  Name = Blacksmith
  Talk = BlacksmithAsks
  Role = Temirchi
  Radius = 30
  Wander = 10
End

Npc
  Name = OldWoman
  Talk = OldWomanAsks
  Role = Momo
  Radius = 30
  Wander = 12
End

; The enemy commander cannot be killed by the hero, only beaten (his UNYIELDING); and before
; the hero lands nothing hurts him, so the soldiers cannot beat him first.
Boss
  Name = EnemyCommander
  BeatenLook = Beaten
  Phases = [
    Phase
      Below = 100
      DamageTaken = 0
    End,
    Phase
      AfterFlag = HeroLanded
      DamageTaken = 100
    End
  ]
End

; ===========================================================================
; 1. The opening battle, on the field before the north gate (world: Darvoza_oldi) — the menu's
;    backdrop is this battle (MenuScene lays the same Battle block), and "New game" turns it into
;    the intro: the ritual, the pillar of light, the meteor, the landing, the battle held while he
;    is told who he is, then the commander leads him to the palace. Beat by beat, with the frames,
;    in docs/plan/2026-10-15-seamless-campaign.md, section 4: every number is here.
; ===========================================================================

; The armies and the ritualists, laid as one: the menu's backdrop lays it too, so the two are the
; same battle on the same spot.
Battle
  Name = Opening
  Map = world
  Kingdom = [Soldier, Soldier, Soldier, Soldier, Militia, Militia, Militia]
  Enemy = [Skeleton, Skeleton, Skeleton, Skeleton, Skeleton, Skeleton, Skeleton, Runner, Runner, SkeletonMage, EnemyCommander]
  KingdomZone = Saf
  EnemyZone = Dushman_safi
  Leader = Act1Commander
  Ritualist = Ritualist
  Ritualists = 3
  Landing = Qonish
  ; Units from the landing's middle: an equilateral triangle round it, the first to its north. The landing is the
  ; middle of the field (WorldMapWriter), so this ring stands round the whole battle -- the first point just behind
  ; the enemy's line, the other two off the ends of the kingdom's, with the armies fighting inside it.
  Ring = 120
End

Conversation
  Name = BattleHolds
  Lines = [
    Line
      Speaker = Act1Commander
      Text = "Safni ushlang! Darvozadan bir qadam ham chekinmaymiz!"
    End,
    Line
      Speaker = EnemyCommander
      Text = "Taslim bo'l, qo'mondon. Qahramonlaringiz allaqachon tugagan."
    End,
    Line
      Speaker = Act1Commander
      Text = "Qahramon bo'lmasa ham — biz bormiz! Kohinlar, chaqiring uni!"
    End
  ]
End

Conversation
  Name = HeroLands
  Lines = [
    Line
      Speaker = Hero
      Text = "Bu... qayer? Hozirgina Erika bilan mashq qilayotgan edim..."
    End,
    Line
      Speaker = Act1Commander
      Text = "Osmondan olov bo'lib tushding — demak, sen qahramonsan. Kohinlar seni chaqirdi."
    End,
    Line
      Speaker = EnemyCommander
      Text = "Yo'q... yana bittasi?! Chekinish!"
    End
  ]
End

Conversation
  Name = AfterLanding
  Lines = [
    Line
      Speaker = Act1Commander
      Text = "Ular qochmoqda! Askarlar, qolganini tugating!"
    End,
    Line
      Speaker = Act1Commander
      Text = "Bu dunyoda qahramon qolmagan. Sen chaqirilgan oxirgi qahramonsan."
    End,
    Line
      Speaker = Hero
      Text = "Men uyga qaytishim kerak. U meni kutyapti."
    End,
    Line
      Speaker = Act1Commander
      Text = "Unda malikaning huzuriga yur. Yo'lni faqat u biladi. Ortimdan yur — saroy shahar ichida."
    End
  ]
End

; The follow mission: she walks to the palace along the road, he keeps near; she waits if he strays.
Quest
  Name = FollowCommander
  Kind = MAIN
  Title = "Qo'mondon izidan"
  Description = "Qo'mondon sizni malika saroyiga olib boradi. Uning ortidan yuring: boshi uzra oltin belgi bor. Uzoqlashsangiz, u sizni kutadi."
  Steps = [
    Step
      Goal = FOLLOW
      Target = Act1Commander
      Where = Saroy
      Text = "Qo'mondon izidan saroyga boring"
    End
  ]
End

; Led to the palace, the commander's work done: the queen is the next to see. Without it nothing in the quest log
; said where to go once she stopped (a save there loaded with no quest at all).
Quest
  Name = MeetTheQueen
  Kind = MAIN
  Title = "Malika huzurida"
  Description = "Qo'mondon sizni saroyga olib keldi. Taxt oldidagi malika bilan gaplashing."
  Steps = [
    Step
      Goal = TALK
      Target = Act1Queen
      Where = Taxt
      Text = "Malika bilan gaplashing"
    End
  ]
End

Trigger
  Name = QueenAwaits
  Map = world
  When = QUEST_DONE
  Target = FollowCommander
  If = [
    Condition
      Is = FLAG_UNSET
      Target = Welcomed
    End
  ]
  Actions = [
    Action
      Act = START_QUEST
      Target = MeetTheQueen
    End
  ]
End

; The menu's own framing over the field, the line held, then the camera eases to the ritualists.
Cutscene
  Name = Summoning
  Shots = [
    Shot
      ; The line held, seen from where the camera stands: the menu's own framing, when the backdrop became the game.
      Says = BattleHolds
      Hold = 10
    End,
    Shot
      ; Then one smooth move (E85): over the field as the menu frames it, down past the kingdom's line, then up and
      ; back to the middle of it -- the three of them ringed round the landing, the whole battle inside their ring.
      Frames = 150
      Hold = 10
      Ease = IN_OUT
      Path = [
        Key
        End,
        Key
          Zone = Darvoza_oldi
          Turn = 0
          Pitch = 66
          Zoom = 230
        End,
        Key
          Zone = Saf
          Pitch = 52
          Zoom = 170
        End,
        Key
          Zone = Qonish
          Pitch = 38
          Zoom = 250
        End
      ]
    End
  ]
End

; The camera held on the landing through the ritual, the beams, the pillar and the meteor.
Cutscene
  Name = Ritual
  Shots = [
    Shot
      Zone = Qonish
      Frames = 1
      Hold = 240
    End
  ]
End

; Low and close in the smoke as he rises; then what he is told.
Cutscene
  Name = Landing
  Shots = [
    Shot
      ; Down low and close into the smoke as he rises...
      Frames = 30
      Hold = 40
      Ease = OUT
      Path = [
        Key
        End,
        Key
          Zone = Qonish
          Pitch = 30
          Zoom = 85
        End
      ]
    End,
    Shot
      Says = HeroLands
      Hold = 10
    End,
    Shot
      ; ...then back up over the kingdom's line, the stunned army round it.
      Frames = 45
      Hold = 10
      Ease = IN_OUT
      Path = [
        Key
        End,
        Key
          Zone = Saf
          Pitch = 45
          Zoom = 120
        End
      ]
    End,
    Shot
      Says = AfterLanding
      Hold = 15
    End
  ]
End

; t 0: the card, the battle laid, the hero held high in the sky over the landing, the opening shown.
Trigger
  Name = BattleStart
  Map = world
  When = MAP_START
  If = [
    Condition
      Is = FLAG_SET
      Target = Act1
    End,
    Condition
      Is = FLAG_UNSET
      Target = HeroLanded
    End
  ]
  Actions = [
    Action
      Act = TITLE
      Target = ChapterBattle
    End,
    Action
      Act = BATTLE
      Target = Opening
    End,
    Action
      Act = SKY
      Target = Hero
      Zone = Qonish
      Height = 3000
    End,
    Action
      Act = CUTSCENE
      Target = Summoning
    End
  ]
End

; The camera on them: arms spread wide to the sides, faces to the sky; then hands snap together forward.
Trigger
  Name = RitualBegins
  Map = world
  When = SEEN
  Target = Summoning
  If = [
    Condition
      Is = FLAG_SET
      Target = Act1
    End
  ]
  Actions = [
    Action
      Act = POSE
      Target = Ritualist
      Clip = Ritual
      OrElse = Ranged_Magic_Summon
      Frames = 150
    End,
    Action
      Act = EFFECT
      Target = RitualGlow
      Zone = Qonish
    End,
    Action
      Act = CUTSCENE
      Target = Ritual
    End
  ]
End

; +105: a bright beam from each one's hands to a point over the landing, three sides into one.
Trigger
  Name = BeamsFire
  Map = world
  When = AFTER
  Target = RitualBegins
  Delay = 105
  Actions = [
    Action
      Act = BEAM
      Target = Ritualist
      Zone = Qonish
      Height = 40
      Drawn = RitualBeam
      Frames = 100
    End
  ]
End

; +104: the three beams meet over the landing in one bright flash.
Trigger
  Name = BeamsMeet
  Map = world
  When = AFTER
  Target = RitualBegins
  Delay = 104
  Actions = [
    Action
      Act = EFFECT
      Target = BeamMeet
      Zone = Qonish
    End
  ]
End

; +120: the beams feed a pillar of light that rises to the sky.
Trigger
  Name = PillarRises
  Map = world
  When = AFTER
  Target = RitualBegins
  Delay = 120
  Actions = [
    Action
      Act = BEAM
      Zone = Qonish
      Height = 900
      Drawn = SkyPillarBeam
      Frames = 90
    End,
    Action
      Act = EFFECT
      Target = SkyPillar
      Zone = Qonish
    End
  ]
End

; +150: the meteor — him, burning — streaks down at an angle out of the south-west.
Trigger
  Name = MeteorFalls
  Map = world
  When = AFTER
  Target = RitualBegins
  Delay = 150
  Actions = [
    Action
      Act = STREAK
      Target = Hero
      Zone = Qonish
      Height = 700
      Lean = 400
      Bearing = 135
      Frames = 24
      Drawn = MeteorTrail
      Landed = MeteorImpact
    End
  ]
End

; +174, the impact: the shockwave throws the enemy clear and stuns them, the battle is held, he
; kneels in the smoke and rises, and the ritualists are gone in a flash.
Trigger
  Name = Impact
  Map = world
  When = AFTER
  Target = MeteorFalls
  Delay = 24
  Actions = [
    Action
      ; The knock-back is his: every hero's PUSH (Qo'nish zarbasi, data/units), cast where he struck -- every enemy
      ; within 160 thrown 50 out over an arc and stunned, in the skill system (E82).
      Act = CAST
      Target = PUSH
      Zone = Qonish
    End,
    Action
      Act = SOUND
      Target = landing.impact
      Zone = Qonish
    End,
    Action
      Act = HOLD
      Zone = Darvoza_oldi
    End,
    Action
      Act = POSE
      Target = Hero
      Clip = HeroLanding
      Frames = 70
    End,
    Action
      Act = REMOVE
      Target = Ritualist
      Drawn = RitualistVanish
    End,
    Action
      Act = FLAG
      Target = HeroLanded
    End
  ]
End

; +249: what he is told, the battle still held.
Trigger
  Name = LandingTalk
  Map = world
  When = AFTER
  Target = Impact
  Delay = 75
  Actions = [
    Action
      Act = CUTSCENE
      Target = Landing
    End
  ]
End

; The dialogue over: the battle let go, the soldiers finish the stunned, and the commander leads on.
Trigger
  Name = BattleWon
  Map = world
  When = SEEN
  Target = Landing
  If = [
    Condition
      Is = FLAG_SET
      Target = Act1
    End
  ]
  Actions = [
    Action
      Act = RELEASE
    End,
    Action
      Act = KILL
      Target = Skeleton
    End,
    Action
      Act = KILL
      Target = Runner
    End,
    Action
      Act = KILL
      Target = SkeletonMage
    End,
    Action
      Act = KILL
      Target = EnemyCommander
    End
  ]
End

; ---- the first wave: out of the old graves, onto what is left of the line ----

Conversation
  Name = WaveComes
  Lines = [
    Line
      Speaker = Act1Commander
      Text = "Qarang — qabrlar tomondan yana kelishyapti! Qahramon, jang qil!"
    End
  ]
End

Conversation
  Name = Retreat
  Lines = [
    Line
      Speaker = Act1Commander
      Text = "Safimizdan faqat ikkimiz qoldik. Ular o'sha qabrlardan tinmay chiqyapti."
    End,
    Line
      Speaker = Act1Commander
      Text = "Yolg'iz qarshilik qila olmaymiz. Shaharga chekinamiz — malika nima qilishni biladi. Ortimdan yur!"
    End
  ]
End

Quest
  Name = FirstWave
  Kind = MAIN
  Title = "Birinchi to'lqin"
  Description = "Qabrlardan chiqqan o'liklar safga yopirildi. Ularni qiring."
  Steps = [
    Step
      Goal = KILL
      Target = Skeleton
      Count = 6
      Where = Darvoza_oldi
      Text = "Qabrlardan chiqqan o'liklarni qiring %d/%d"
      Glow = Yes
    End
  ]
End

; A moment after the battle is let go -- its dead counted already, so none of them is the wave's -- the dead come
; out of the old graves at the line.
Trigger
  Name = FirstWaveRises
  Map = world
  When = AFTER
  Target = BattleWon
  Delay = 90
  Actions = [
    Action
      Act = SAY
      Target = WaveComes
    End,
    Action
      Act = SPAWN
      Target = Skeleton
      Count = 6
      Zone = Dushman_safi
    End,
    Action
      Act = SPAWN
      Target = Runner
      Count = 2
      Zone = Dushman_safi
    End,
    Action
      Act = START_QUEST
      Target = FirstWave
    End
  ]
End

; The wave down: nobody of the line is left but the two of them, and they fall back to the city.
Trigger
  Name = WaveBeaten
  Map = world
  When = QUEST_DONE
  Target = FirstWave
  Actions = [
    Action
      Act = REMOVE
      Target = Soldier
    End,
    Action
      Act = REMOVE
      Target = Militia
    End,
    Action
      Act = KILL
      Target = Runner
    End,
    Action
      Act = SAY
      Target = Retreat
    End,
    Action
      Act = FLAG
      Target = BattleWon
    End,
    Action
      Act = START_QUEST
      Target = FollowCommander
    End,
    Action
      Act = CHECKPOINT
    End
  ]
End

; ---- the world shut but for the way to the capital: section 6 ----

Conversation
  Name = GateShut
  Lines = [
