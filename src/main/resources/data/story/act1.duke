; ---------------------------------------------------------------------------
; Act 1, start to the turning, as one playable chain — see docs/plan/2026-10-15-act1.md.
;
;   1. jang       the opening battle: the hero lands in a beam of light
;   2. poytaxt    the capital: the queen, her gold and her medallion; people's small asks
;   3. mashq      the training: the descent's floors, two of them, then back to the capital
;   4. urush      the war: the descent's keep floors, two of them
;   5. qora_qasr  the dark castle: its lord's death, the medallion drinks him whole — the turning
;
; Each joint is a map or a descent (the Campaign block's Descents), chained by triggers' MAP;
; every floor entered is the autosave's checkpoint, and a death goes back to it. Every name
; the owner has not chosen is a STAND-IN: the commander ("Qo'mondon"), the queen ("Malika"),
; the hero's beloved (the Rogue's own name, Erika: she is Act 2's heroine), the townsfolk, the enemy commander and the castle's lord.
; The hero is the Knight (his DisplayName is the descent's).
; ---------------------------------------------------------------------------

Campaign
  Word = "1-qism: Oxirgi qahramon"
  Blurb = "Jang maydonidan qora qasrgacha. Hikoya shu yerdan boshlanadi."
  Hero = Knight
  ; Generated floors under names of their own: their bosses open the next floor as the descent's
  ; do, and the story's DEPTH triggers say when they end.
  Descents = [
    Descent
      Name = mashq
      FirstDepth = 1
    End,
    Descent
      Name = urush
      FirstDepth = 3
    End
  ]
  ; In order; the first is where a new game opens. What a hero skipped straight to one is given
  ; (the --act1=N debug arg, N from 1): the flags, things and experience the joints before it give.
  Joints = [
    Joint
      Map = jang
    End,
    Joint
      Map = poytaxt
      Flags = [HeroLanded]
      Experience = 100
      Gold = 20
    End,
    Joint
      Map = mashq
      Flags = [HeroLanded, Welcomed]
      Items = [Medallion]
      Experience = 120
      Gold = 120
    End,
    Joint
      Map = urush
      Flags = [HeroLanded, Welcomed, Trained, WarBegun]
      Items = [Medallion]
      Experience = 400
      Gold = 200
    End,
    Joint
      Map = qora_qasr
      Flags = [HeroLanded, Welcomed, Trained, WarBegun, LandsFreed]
      Items = [Medallion]
      Experience = 800
      Gold = 300
    End
  ]
End

; ---------------------------------------------------------------------------
; Who speaks. No pictures yet: the box frames the first letter of each name.
; ---------------------------------------------------------------------------

Speaker
  Name = Act1Commander
  ; STAND-IN name.
  DisplayName = "Qo'mondon"
  Picture =
End

Speaker
  Name = Act1Queen
  DisplayName = Malika
  Picture =
End

Speaker
  Name = EnemyCommander
  ; STAND-IN name.
  DisplayName = "Dushman sarkardasi"
  Picture =
End

Speaker
  Name = DarkLord
  ; STAND-IN name.
  DisplayName = "Qora ritsar"
  Picture =
End

Speaker
  Name = Blacksmith
  DisplayName = "Temirchi Usta"
  Picture =
End

Speaker
  Name = OldWoman
  DisplayName = "Zebo momo"
  Picture =
End

; People: none of the act's greet of themselves but the queen and the townsfolk; the commander
; speaks through the story.
Npc
  Name = Act1Commander
  Role = "Qo'mondon"
  Radius = 30
End

Npc
  Name = Act1Queen
  Talk = QueenWelcome
  Role = Malika
  Radius = 34
End

Npc
  Name = Blacksmith
  Talk = BlacksmithAsks
  Role = Temirchi
  Radius = 30
  Wander = 10
End

Npc
  Name = OldWoman
  Talk = OldWomanAsks
  Role = Momo
  Radius = 30
  Wander = 12
End

; The enemy commander cannot be killed by the hero, only beaten (his UNYIELDING); and before
; the hero lands nothing hurts him, so the soldiers cannot beat him first.
Boss
  Name = EnemyCommander
  BeatenLook = Beaten
  Phases = [
    Phase
      Below = 100
      DamageTaken = 0
    End,
    Phase
      AfterFlag = HeroLanded
      DamageTaken = 100
    End
  ]
End

; ===========================================================================
; 1. jang — the opening battle.
; ===========================================================================

Conversation
  Name = BattleHolds
  Lines = [
    Line
      Speaker = Act1Commander
      Text = "Safni ushlang! Darvozadan bir qadam ham chekinmaymiz!"
    End,
    Line
      Speaker = EnemyCommander
      Text = "Taslim bo'l, qo'mondon. Qahramonlaringiz allaqachon tugagan."
    End,
    Line
      Speaker = Act1Commander
      Text = "Qahramon bo'lmasa ham — biz bormiz!"
    End
  ]
End

Conversation
  Name = HeroLands
  Lines = [
    Line
      Speaker = Hero
      Text = "Bu... qayer? Hozirgina Erika bilan mashq qilayotgan edim..."
    End,
    Line
      Speaker = Act1Commander
      Text = "Osmondan nur tushdi — demak, sen qahramonsan! Savollarni keyin ber, hozir qilichingni ol!"
    End
  ]
End

Conversation
  Name = EnemyFalls
  Lines = [
    Line
      Speaker = EnemyCommander
      Text = "Yo'q... qayerdan kelding sen?.."
    End
  ]
End

Conversation
  Name = CommanderStrikes
  Lines = [
    Line
      Speaker = Act1Commander
      Text = "Bu jang meniki edi."
    End
  ]
End

Conversation
  Name = AfterBattle
  Lines = [
    Line
      Speaker = Act1Commander
      Text = "Ular qochmoqda! Bugun biz yutdik — sen tufayli."
    End,
    Line
      Speaker = Act1Commander
      Text = "Bu dunyoda qahramon qolmagan. Sen chaqirilgan oxirgi qahramonsan."
    End,
    Line
      Speaker = Hero
      Text = "Men uyga qaytishim kerak. U meni kutyapti."
    End,
    Line
      Speaker = Act1Commander
      Text = "Unda malikaning huzuriga yur. Yo'lni faqat u biladi."
    End
  ]
End

Quest
  Name = HoldTheLine
  Kind = MAIN
  Title = "Darvoza oldidagi jang"
  Steps = [
    Step
      Goal = KILL
      Target = EnemyCommander
      Where = EnemyLine
      Text = "Dushman sarkardasini yiqiting"
      Glow = Yes
    End
  ]
End

Cutscene
  Name = BattleOpening
  Shots = [
    Shot
      ; The kingdom's line before its gate...
      Zone = Line
      Frames = 1
      Hold = 30
    End,
    Shot
      Says = BattleHolds
      Hold = 10
    End,
    Shot
      ; ...and the army coming at it.
      Zone = EnemyLine
      Frames = 45
      Hold = 20
    End
  ]
End

Cutscene
  Name = Landing
  Shots = [
    Shot
      ; The beam of light, and him falling in it: the camera low and close, looking up the beam's way, settling as he
      ; lands (play's own is 55 degrees down, 140 back).
      Zone = Landing
      Frames = 30
      Hold = 40
      Pitch = 30
      Zoom = 85
      Ease = OUT
    End,
    Shot
      Says = HeroLands
      Hold = 10
    End
  ]
End

Cutscene
  Name = BattleOver
  Shots = [
    Shot
      Zone = Line
      Frames = 45
      Hold = 15
    End,
    Shot
      Says = AfterBattle
      Hold = 15
    End
  ]
End

Trigger
  Name = BattleStart
  Map = jang
  When = MAP_START
  Actions = [
    Action
      ; The chapter's name over the screen as it opens.
      Act = TITLE
      Target = ChapterBattle
    End,
    Action
      Act = ALLY
      Target = Soldier
      Count = 4
      Zone = Line
    End,
    Action
      Act = ALLY
      Target = Militia
      Count = 3
      Zone = Line
    End,
    Action
      ; The army comes on at the line.
      Act = CALL
      Target = Skeleton
      Zone = Line
    End,
    Action
      Act = CALL
      Target = Runner
      Zone = Line
    End,
    Action
      Act = CUTSCENE
      Target = BattleOpening
    End
  ]
End

; The world stops for him: a beam of light, the hero in it, the enemy commander thrown back.
Trigger
  Name = HeroArrives
  Map = jang
  When = SEEN
  Target = BattleOpening
  Actions = [
    Action
      Act = EFFECT
      Target = SkyLight
      Zone = Landing
    End,
    Action
      ; Down out of the sky in the beam, a second's fall; the ground cracks and the camera knocks as he lands.
      Act = FALL
      Target = Hero
      Zone = Landing
      Height = 140
      Frames = 30
      Landed = HeroLandsDust
    End,
    Action
      ; The enemy commander thrown back by it: a hop through the air, dust where he lands.
      Act = LEAP
      Target = EnemyCommander
      Zone = Thrown
      Height = 22
      Frames = 24
      Landed = Beaten
    End,
    Action
      Act = FLAG
      Target = HeroLanded
    End,
    Action
      Act = START_QUEST
      Target = HoldTheLine
    End,
    Action
      Act = CUTSCENE
      Target = Landing
    End
  ]
End

; He rises and charges again, at the one who threw him...
Trigger
  Name = EnemyCharges
  Map = jang
  When = AFTER
  Target = HeroArrives
  Delay = 90
  Actions = [
    Action
      Act = CALL
      Target = EnemyCommander
      Zone = Landing
    End
  ]
End

; ...beaten, he kneels — and the commander cuts him down.
Trigger
  Name = EnemyBeaten
  Map = jang
  When = BEATEN
  Target = EnemyCommander
  Actions = [
    Action
      Act = SAY
      Target = EnemyFalls
    End,
    Action
      Act = WALK
      Target = Act1Commander
      Zone = Landing
    End
  ]
End

Trigger
  Name = CommanderCuts
  Map = jang
  When = AFTER
  Target = EnemyBeaten
  Delay = 60
  Actions = [
    Action
      Act = SAY
      Target = CommanderStrikes
    End,
    Action
      Act = KILL
      Target = EnemyCommander
    End
  ]
End

; His army breaks: what is left of it falls, and the commander says what he is.
Trigger
  Name = BattleWon
  Map = jang
  When = AFTER
  Target = CommanderCuts
  Delay = 30
  Actions = [
    Action
      Act = KILL
      Target = Skeleton
    End,
    Action
      Act = KILL
      Target = Runner
    End,
    Action
      Act = KILL
      Target = SkeletonMage
    End,
    Action
      Act = CUTSCENE
      Target = BattleOver
    End
  ]
End

Trigger
  Name = ToTheCapital
  Map = jang
  When = SEEN
  Target = BattleOver
  Actions = [
    Action
      Act = MAP
      Target = poytaxt
    End
  ]
End

; ===========================================================================
; 2. poytaxt — the capital: the queen, the medallion, the merchant, people's asks.
; ===========================================================================

Conversation
  Name = CommanderInCapital
  Lines = [
    Line
      Speaker = Act1Commander
      Text = "Bu — poytaxt. Malika saroyda kutmoqda. Ortimdan yur."
    End
  ]
End

Conversation
  Name = QueenWelcome
  Lines = [
    Line
      Speaker = Act1Queen
      Text = "Xush kelibsiz, qahramon. Qo'mondon darvoza oldidagi jangni aytib berdi."
    End,
    Line
      Speaker = Act1Queen
      Text = "Saltanatimni qora ritsar bosib oldi: qal'alarimiz uning qo'lida, xalqim qo'rquvda."
    End,
    Line
      Speaker = Act1Queen
      Text = "Mana, oltin — va bu medalyon. U siz o'ldirgan har bir dushmanning jonini yutib, kuchini sizga quyadi."
    End,
    Line
      Speaker = Act1Queen
      Text = "Uni faqat qahramon taqa oladi."
    End,
    Line
      Speaker = Hero
      Text = "Qora ritsarni o'ldirsam, uyga qayta olamanmi?"
    End,
    Line
      Speaker = Act1Queen
      Text = "Ha. Uni o'ldiring — yo'l ochiladi. Ammo avval mashq qiling: hozir u sizni bir zarbada yiqitadi."
    End
  ]
  Starts = [Training]
End

Conversation
  Name = ToTrainingLine
  Lines = [
    Line
      Speaker = Act1Commander
      Text = "Mashq maydoni — shahar ostidagi eski qabrlar. Ikki qavat tushing, so'ng qayting."
    End
  ]
End

Quest
  Name = Training
  Kind = MAIN
  Title = "Mashq"
  Steps = [
    Step
      Goal = REACH
      Target = Gate
      Text = "Shahar darvozasidan mashq maydoniga chiqing"
    End
  ]
End

Cutscene
  Name = CapitalShown
  Shots = [
    Shot
      Zone = Square
      Frames = 1
      Hold = 20
    End,
    Shot
      Says = CommanderInCapital
      Hold = 10
    End,
    Shot
      ; The castle's court, where the queen sits: the camera turns to face her throne from the south and draws in.
      Zone = Throne
      Frames = 60
      Hold = 20
      Turn = 0
      Pitch = 40
      Zoom = 95
      Ease = IN_OUT
    End
  ]
End

Trigger
  Name = CapitalArrival
  Map = poytaxt
  When = MAP_START
  If = [
    Condition
      Is = FLAG_UNSET
      Target = Trained
    End
  ]
  Actions = [
    Action
      ; The chapter's name over the screen as it opens.
      Act = TITLE
      Target = ChapterCapital
    End,
    Action
      Act = CUTSCENE
      Target = CapitalShown
    End,
    Action
      ; She goes ahead to the court; he follows.
      Act = WALK
      Target = Act1Commander
      Zone = CourtSide
    End
  ]
End

Trigger
  Name = QueenGivesAct1
  Map = poytaxt
  When = HEARD
  Target = QueenWelcome
  Actions = [
    Action
      Act = GIVE
      Target = Medallion
    End,
    Action
      Act = GOLD
      Count = 100
    End,
    Action
      Act = FLAG
      Target = Welcomed
    End
  ]
End

Trigger
  Name = ToTraining
  Map = poytaxt
  When = QUEST_DONE
  Target = Training
  Actions = [
    Action
      Act = SAY
      Target = ToTrainingLine
    End,
    Action
      Act = MAP
      Target = mashq
    End
  ]
End

