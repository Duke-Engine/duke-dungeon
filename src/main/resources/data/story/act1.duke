  ]
End

; The camp reached: into the Black Knight's castle.
Trigger
  Name = ToTheCastle
  Map = world
  When = QUEST_DONE
  Target = ToWar
  Actions = [
    Action
      Act = FLAG
      Target = LandsFreed
    End,
    Action
      Act = TITLE
      Target = ChapterWar
    End,
    Action
      Act = SAY
      Target = CampReached
    End,
    Action
      Act = MAP
      Target = qora_qasr
    End
  ]
End

; How strong the Black Knight stands in his castle: half of himself at the least, and the other half as much as there
; are graves and caves left of all the world has (Graveyard and Cave blocks); shown while the road north is going.
KnightStrength
  Boss = DarkLord
  Map = qora_qasr
  Least = 50
  Word = "Qora ritsar kuchi: %d%%"
  During = ToWar
End

