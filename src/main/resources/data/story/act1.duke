; ---------------------------------------------------------------------------
; Act 1, start to the turning — see docs/plan/2026-10-15-act1.md and, for the world it is played
; in, docs/plan/2026-10-15-seamless-campaign.md.
;
;   1. world      the opening battle, on the field before the capital's north gate (Darvoza_oldi)
;   2. world      the palace: the queen, her gold and her medallion; people's small asks
;   3. world      the old graves west of the field (Eski_qabrlar): their raiser, the graves, the farewell
;   4. world      the open world: its graves and caves, and the road north to the Black Knight's camp
;   5. qora_qasr  the dark castle: its lord's death, the medallion drinks him whole — the turning
;
; Joints 1-3 are the one open world: no loading screen between them. The act's world story runs
; only with the flag Act1, which every joint sets (Act 2's runs with Act2), so the open world played
; off the stages list stays as it was. Every name the owner has not chosen is a STAND-IN: the
; commander ("Qo'mondon"), the queen ("Malika"), the hero's beloved (the Rogue's own name, Erika: she
; is Act 2's heroine), the townsfolk, the enemy commander and the castle's lord. The hero is the
; Knight (his DisplayName is the descent's).
; ---------------------------------------------------------------------------

Campaign
  Word = "1-qism: Oxirgi qahramon"
  Blurb = "Jang maydonidan qora qasrgacha. Hikoya shu yerdan boshlanadi."
  Hero = Knight
  ; Generated floors under names of their own: their bosses open the next floor as the descent's
  ; do, and the story's DEPTH triggers say when they end.
  Descents = [
    ; The open world's caves, each a floor of its own under its mouth (data/story/caves.duke): the deeper the
    ; floor, the harder its monsters.
    Descent
      Name = Gor_kirish
      FirstDepth = 2
    End,
    Descent
      Name = Gor_1
      FirstDepth = 2
    End,
    Descent
      Name = Gor_2
      FirstDepth = 3
    End,
    Descent
      Name = Gor_3
      FirstDepth = 4
    End,
    Descent
      Name = Gor_4
      FirstDepth = 4
    End,
    Descent
      Name = Gor_5
      FirstDepth = 5
    End
  ]
  ; In order; the first is where a new game opens. What a hero skipped straight to one is given
  ; (the --act1=N debug arg, N from 1): the flags, things and experience the joints before it give,
  ; the zone he is put in (At) and the quests he has going.
  Joints = [
    Joint
      Map = world
      Flags = [Act1]
    End,
    Joint
      Map = world
      Flags = [Act1, HeroLanded, BattleWon]
      Experience = 100
      Gold = 20
      At = Saroy
    End,
    Joint
      Map = world
      Flags = [Act1, HeroLanded, BattleWon, Welcomed, GravesWake]
      Items = [Medallion]
      Quests = [Training]
      Experience = 120
      Gold = 120
      At = Eski_qabrlar
    End,
    Joint
      Map = world
      Flags = [Act1, HeroLanded, BattleWon, Welcomed, GravesWake, GoneOldGraves, Trained, WarBegun]
      Items = [Medallion]
      Quests = [ToWar]
      Experience = 400
      Gold = 200
      At = Eski_qabrlar
    End,
    Joint
      Map = qora_qasr
      Flags = [Act1, HeroLanded, BattleWon, Welcomed, GravesWake, GoneOldGraves, Trained, WarBegun, LandsFreed]
      Items = [Medallion]
      Experience = 800
      Gold = 300
    End
  ]
  ; The maps the act left when it folded into the world: a save on one loads on the world at the
  ; joint that took its place (its flags added, its quests started, put in its At).
  Retired = [
    Retired
      Map = jang
      Joint = 1
    End,
    Retired
      Map = poytaxt
      Joint = 2
    End,
    Retired
      Map = mashq
      Joint = 3
    End,
    Retired
      Map = urush
      Joint = 4
    End
  ]
End

