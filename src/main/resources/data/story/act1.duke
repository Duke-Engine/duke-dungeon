  Actions = [
    Action
      Act = PLACE
      Zone = CourtSide
    End,
    Action
      Act = CUTSCENE
      Target = WarCouncilShown
    End,
    Action
      Act = START_QUEST
      Target = ToWar
    End,
    Action
      Act = FLAG
      Target = WarBegun
    End
  ]
End

Trigger
  Name = ToTheWar
  Map = poytaxt
  When = QUEST_DONE
  Target = ToWar
  Actions = [
    Action
      Act = MAP
      Target = urush
    End
  ]
End

; ---- the side quests: the blacksmith's cellar, and the old woman's ring ----

Conversation
  Name = BlacksmithAsks
  Lines = [
    Line
      Speaker = Blacksmith
      Text = "Qahramon! Yerto'lamdan skeletlar chiqib kelyapti. Yerto'la shaharning o'ng yuqori burchagida, mening ustaxonam tepasida. Uchala skeletni qirib bering — evaziga qo'lqop beraman."
    End
  ]
  Starts = [Cellar]
End

Conversation
  Name = BlacksmithThanks
  Lines = [
    Line
      Speaker = Blacksmith
      Text = "Tinchlik qaytdi! Mana, va'da qilgan qo'lqopim."
    End
  ]
End

Conversation
  Name = OldWomanAsks
  Lines = [
    Line
      Speaker = OldWoman
      Text = "O'g'lim, marhum cholimning uzugini yerto'lada tushirib qo'ydim. Topib bersang, duo qilaman."
    End
  ]
  Starts = [LostRing]
End

Conversation
  Name = OldWomanThanks
  Lines = [
    Line
      Speaker = OldWoman
      Text = "Topdingmi! Ilohim, yo'ling ochiq bo'lsin. Mana bu tumorni ol — senga asqatadi."
    End
  ]
End

Quest
  Name = Cellar
  Kind = SIDE
  Title = "Yerto'ladagi skeletlar"
  Description = "Temirchining yerto'lasi shaharning o'ng yuqori (shimoli-sharqiy) burchagida, ustaxonasining tepasida — M xaritada belgilangan. U yerga boring, uchala skeletni o'ldiring, so'ng temirchiga qayting."
  Steps = [
    Step
      Goal = KILL
      Target = Skeleton
      Count = 3
      Text = "Shaharning o'ng yuqori burchagidagi yerto'laga boring, skeletlarni qiring %d/%d"
      Where = Cellar
      Glow = Yes
    End,
    Step
      Goal = TALK
      Target = Blacksmith
      Text = "Temirchiga qayting"
      OnDone = Done
        Says = BlacksmithThanks
        Experience = 60
        Item = Gauntlet
      End
    End
  ]
End

Quest
  Name = LostRing
  Kind = SIDE
  Title = "Momoning uzugi"
  Description = "Zebo momo cholining uzugini yerto'lada tushirib qo'ygan. Yerto'la shaharning o'ng yuqori burchagida — M xaritada belgilangan."
  Steps = [
    Step
      Goal = COLLECT
      Target = FamilyRing
      Text = "Shaharning o'ng yuqori burchagidagi yerto'lada uzukni toping"
      Where = Cellar
      Glow = Yes
    End,
    Step
      Goal = GIVE
      Target = OldWoman
      Item = FamilyRing
      Text = "Uzukni Zebo momoga bering"
      OnDone = Done
        Says = OldWomanThanks
        Experience = 40
        Item = Amulet
      End
    End
  ]
End

; Her late husband's ring: a thing a quest asks for, which gives nothing and is never dropped.
LootItem
  Name = FamilyRing
  DisplayName = "Cholning uzugi"
  Icon = icons/items/ring.png
  Kind = QUEST
  Value = 0
  Weight = 0
End

Trigger
  Name = CellarStirs
  Map = poytaxt
  When = QUEST_STARTED
  Target = Cellar
  Actions = [
    Action
      Act = SPAWN
      Target = Skeleton
      Count = 3
      Zone = Cellar
    End
  ]
End

