; ===========================================================================
; 2. The palace, in the capital (world: Saroy, Taxt, Bozor, Yerto'la).
; ===========================================================================

; Spots in the capital the act's people stand at (the world's file is WorldMapWriter's, so they are the
; act's own places, as Act 2's are). In cells: name x y radius.
Place
  Map = world
  Zone = "CourtSide 108 463 1"
End

Place
  Map = world
  Zone = "BlacksmithSpot 118 457 1"
End

Place
  Map = world
  Zone = "OldWomanSpot 115 465 1"
End

; The capital's people, every time the world is laid in the act (a load lays it again): the queen on
; her throne, the merchant on the plaza, the blacksmith and the old woman by it.
Trigger
  Name = Act1Capital
  Map = world
  When = MAP_START
  Repeat = Yes
  If = [
    Condition
      Is = FLAG_SET
      Target = Act1
    End
  ]
  Actions = [
    Action
      Act = SPAWN
      Target = Act1Queen
      Zone = Taxt
    End,
    Action
      Act = SPAWN
      Target = Merchant
      Zone = Bozor
    End,
    Action
      Act = SPAWN
      Target = Blacksmith
      Zone = BlacksmithSpot
    End,
    Action
      Act = SPAWN
      Target = OldWoman
      Zone = OldWomanSpot
    End
  ]
End

; The commander: on the field until the battle is won, then on the road ahead of him to the palace,
; and at the palace from his welcome on.
Trigger
  Name = Act1CommanderField
  Map = world
  When = MAP_START
  Repeat = Yes
  If = [
    Condition
      Is = FLAG_SET
      Target = Act1
    End,
    Condition
      Is = FLAG_UNSET
      Target = Welcomed
    End
  ]
  Actions = [
    Action
      Act = SPAWN
      Target = Act1Commander
      Zone = Saf
    End
  ]
End

Trigger
  Name = Act1CommanderPalace
  Map = world
  When = MAP_START
  Repeat = Yes
  If = [
    Condition
      Is = FLAG_SET
      Target = Act1
    End,
    Condition
      Is = FLAG_SET
      Target = Welcomed
    End
  ]
  Actions = [
    Action
      Act = SPAWN
      Target = Act1Commander
      Zone = CourtSide
    End
  ]
End

Conversation
  Name = CommanderInCapital
  Lines = [
    Line
      Speaker = Act1Commander
      Text = "Bu — poytaxt. Malika saroyda, taxtida kutmoqda. Yur."
    End
  ]
End

Conversation
  Name = QueenWelcome
  Lines = [
    Line
      Speaker = Act1Queen
      Text = "Xush kelibsiz, qahramon. Qo'mondon darvoza oldidagi jangni aytib berdi."
    End,
    Line
      Speaker = Act1Queen
      Text = "Saltanatimni qora ritsar bosib oldi: qal'alarimiz uning qo'lida, xalqim qo'rquvda."
    End,
    Line
      Speaker = Act1Queen
      Text = "Mana, oltin — va bu medalyon. U siz o'ldirgan har bir dushmanning jonini yutib, kuchini sizga quyadi."
    End,
    Line
      Speaker = Act1Queen
      Text = "Uni faqat qahramon taqa oladi."
    End,
    Line
      Speaker = Hero
      Text = "Qora ritsarni o'ldirsam, uyga qayta olamanmi?"
    End,
    Line
      Speaker = Act1Queen
      Text = "Ha. Uni o'ldiring — yo'l ochiladi. Ammo avval o'sha qabrlarni to'xtating: o'liklar ulardan tinmay chiqmoqda. Askarlarimni oling."
    End
  ]
  Starts = [Training]
End

Conversation
  Name = ToTrainingLine
  Lines = [
    Line
      Speaker = Act1Commander
      Text = "Askarlarim qabrlar oldida sizni kutadi. Qabrlar — shimoliy darvoza ortida, g'arbda. Ular oldida sehrgar turibdi: u tirik ekan, qabrlarga zarar yetmaydi."
    End
  ]
End

; The graves (data/story/graveyards.duke): the raiser first, for while it stands nothing the graves take holds,
; then each grave struck down on its own.
Quest
  Name = Training
  Kind = MAIN
  Title = "Eski qabrlar"
  Description = "O'liklar shimoliy darvoza ortidagi eski qabrlardan chiqmoqda. Qabrlar oldida sehrgar turibdi: u tirik ekan, qabrlarga zarar yetmaydi. Avval uni o'ldiring, so'ng qabrlarni birma-bir buzing."
  Steps = [
    Step
      Goal = REACH
      Target = Eski_qabrlar
      Text = "Shimoliy darvozadan chiqib, eski qabrlarga boring"
    End,
    Step
      Goal = KILL
      Target = GraveRaiser
      Where = Eski_qabrlar
      Text = "Qabr sehrgarini o'ldiring"
      Glow = Yes
    End,
    Step
      Goal = KILL
      Target = Grave
      Count = 3
      Where = Eski_qabrlar
      Text = "Qabrlarni birma-bir buzing %d/%d"
      Glow = Yes
      OnDone = Done
        Experience = 150
      End
    End
  ]
End

Cutscene
