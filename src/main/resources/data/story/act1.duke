    Action
      Act = ALLY
      Target = Soldier
      Count = 4
      Zone = Eski_qabrlar
    End,
    Action
      Act = SAY
      Target = SoldiersCome
    End
  ]
End

; The last grave down: the cave, the camp in the north, the city attacked, and he goes on alone.
Trigger
  Name = TrainingDone
  Map = world
  When = QUEST_DONE
  Target = Training
  Actions = [
    Action
      Act = FLAG
      Target = Trained
    End,
    Action
      Act = SAY
      Target = CaveSeen
    End,
    Action
      Act = SAY
      Target = CityAttacked
    End,
    Action
      Act = REMOVE
      Target = Soqchi
    End,
    Action
      Act = REMOVE
      Target = Soldier
    End,
    Action
      ; No council in the palace: he is on his own now (the old way back to the queen waited on this).
      Act = FLAG
      Target = WarBegun
    End,
    Action
      Act = START_QUEST
      Target = ToWar
    End,
    Action
      Act = CHECKPOINT
    End
  ]
End

; ===========================================================================
; 4. The Black Knight's camp, in the north of the world (world: Qora_qarorgoh): stepping into it takes him into his
;    castle. How strong he stands there is what is left of the graves and the caves (KnightStrength).
; ===========================================================================

Conversation
  Name = CampReached
  Lines = [
    Line
      Speaker = Hero
      Text = "Qora ritsarning qarorgohi. Qanchalik ko'p qabr va g'or qolgan bo'lsa, u shunchalik kuchli bo'ladi..."
