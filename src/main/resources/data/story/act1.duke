; ---- the side quests: the blacksmith's cellar, and the old woman's ring ----

Conversation
  Name = BlacksmithAsks
  Lines = [
    Line
      Speaker = Blacksmith
      Text = "Qahramon! Shaharni kalamush va ko'rshapalaklar bosib ketdi — bozorda ham, ko'chada ham. Uyasi shaharning o'ng yuqori burchagidagi yerto'lada, mening ustaxonam tepasida. Uyani tozalab bering — evaziga qo'lqop beraman."
    End
  ]
  Offer = Yes
  Starts = [Cellar]
End

Conversation
  Name = BlacksmithThanks
  Lines = [
    Line
      Speaker = Blacksmith
      Text = "Uyasi tozalandi, shahar nafas oldi! Mana, va'da qilgan qo'lqopim."
    End
  ]
End

Conversation
  Name = OldWomanAsks
  Lines = [
    Line
      Speaker = OldWoman
      Text = "O'g'lim, marhum cholimning uzugini yerto'lada tushirib qo'ydim. Topib bersang, duo qilaman."
    End
  ]
  Offer = Yes
  Starts = [LostRing]
End

Conversation
  Name = OldWomanThanks
  Lines = [
    Line
      Speaker = OldWoman
      Text = "Topdingmi! Ilohim, yo'ling ochiq bo'lsin. Mana bu tumorni ol — senga asqatadi."
    End
  ]
End

Quest
  Name = Cellar
  Kind = SIDE
  Title = "Kalamush va ko'rshapalaklar"
  Description = "Shaharni kalamush va ko'rshapalaklar bosib ketgan. Ularning uyasi temirchining yerto'lasida — shaharning o'ng yuqori (shimoli-sharqiy) burchagida, M xaritada belgilangan. Avval kalamushlarni, so'ng uyadan uchib chiqadigan ko'rshapalaklarni qiring, keyin temirchiga qayting."
  Steps = [
    Step
      Goal = KILL
      Target = Rat
      Count = 5
      Text = "Kalamushlarni qiring — uyasi shaharning o'ng yuqori burchagidagi yerto'lada %d/%d"
      Where = "Yerto'la"
      Glow = Yes
    End,
    Step
      Goal = KILL
      Target = Bat
      Count = 5
      Text = "Uyadan uchib chiqqan ko'rshapalaklarni qiring %d/%d"
      Where = "Yerto'la"
      Glow = Yes
    End,
    Step
      Goal = TALK
      Target = Blacksmith
      Text = "Temirchiga qayting"
      OnDone = Done
        Says = BlacksmithThanks
        Experience = 60
        Item = Gauntlet
      End
    End
  ]
End

Quest
  Name = LostRing
  Kind = SIDE
  Title = "Momoning uzugi"
  Description = "Zebo momo cholining uzugini yerto'lada tushirib qo'ygan. Yerto'la shaharning o'ng yuqori burchagida — M xaritada belgilangan."
  Steps = [
    Step
      Goal = COLLECT
      Target = FamilyRing
      Text = "Shaharning o'ng yuqori burchagidagi yerto'lada uzukni toping"
      Where = "Yerto'la"
      Glow = Yes
    End,
    Step
      Goal = GIVE
      Target = OldWoman
      Item = FamilyRing
      Text = "Uzukni Zebo momoga bering"
      OnDone = Done
        Says = OldWomanThanks
        Experience = 40
        Item = Amulet
      End
    End
  ]
End

; Her late husband's ring: a thing a quest asks for, which gives nothing and is never dropped.
LootItem
  Name = FamilyRing
  DisplayName = "Cholning uzugi"
  Icon = icons/items/ring.png
  Kind = QUEST
  Value = 0
  Weight = 0
End

Trigger
  Name = CellarStirs
  Map = world
