Gate
  Name = Act1Battle
  Map = world
  If = [
    Condition
      Is = FLAG_SET
      Target = Act1
    End,
    Condition
      Is = FLAG_UNSET
      Target = Welcomed
    End
  ]
  Open = [Darvoza_oldi, "Yo'lak", Poytaxt]
