; ---------------------------------------------------------------------------
; The open world's caves and its graveyards in the wilds (docs/plan/2026-10-19-open-world-act1.md): the Black
; Knight draws strength from every one left. Each opens once the hero goes on alone (WarBegun). A cave's floor is the
; campaign's Descent of its name (act1.duke); its mouth is the world's zone of the same name (WorldMapWriter).
; ---------------------------------------------------------------------------

; The one he sees from the old graves.
Cave
  Name = Gor_kirish
  Map = world
  Zone = Gor_kirish
  Wakes = WarBegun
End

Cave
  Name = Gor_1
  Map = world
  Zone = Gor_1
  Wakes = WarBegun
End

