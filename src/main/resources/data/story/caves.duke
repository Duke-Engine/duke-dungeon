; The wilds' graveyards: as the old graves, a raiser before three graves, each laid once he goes on alone.
Graveyard
  Name = Qabriston_1
  Map = world
  Zone = Qabriston_1
  Wakes = WarBegun
  Raiser = GraveRaiser
  Grave = Grave
  Graves = 3
  Ring = 4.5
  Raises = [Skeleton, Runner, Skeleton]
  EveryFrames = 150
  MostStanding = 6
  ShieldLook = GraveWard
  ShieldFrames = 30
  RisesLook = GraveRises
  BrokenLook = GraveBroken
  RaiseBeam = RaiseBeam
  ; Its graves all down and left unhurt three seconds, it casts seven and raises them all again.
  CalmFrames = 90
  RestoreFrames = 210
  RestoreClip = Cast
  RestoreLook = GraveRises
End

