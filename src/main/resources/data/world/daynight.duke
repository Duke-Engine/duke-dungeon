; ===========================================================================
; The open world's day and night, and its weather. See
; docs/plan/2026-10-15-day-and-night.md.
;
; The hour is the run's clock -- frames of play, saved with the game -- read
; round a day of CycleFrames. Every machine reads the same hour, so a ghost
; that wakes at dusk wakes on every machine at once. Only the open world (a
; wide map) is drawn by the hour; the castles, the halls and the descent keep
; their own light, the keep's dark among them.
;
; The hour is real light (E86): the sun's height and colour, the shade's,
; and the haze at the world's edge, eased from key to key; at night every
; fire's and lamp's light (a LIGHT layer) reaches further. A weather's Tint
; lies over the world alone, under the panel and the bars. Inside, scene.duke's
; Sun.
; ===========================================================================
DayNight
  ; A whole day: 20 minutes of play (30 frames a second).
  CycleFrames = 36000
  ; A new game begins in the morning.
  StartHour = 8
  NightFrom = 20
  NightTo = 5

  ; The sky at an hour, eased between the hours written and round midnight:
  ; the hour, the sun's height in degrees, its strength and the shade's in
  ; percent (scene.duke's Sun is 40, 100, 55), then the sun's colour, the
  ; shade's and the haze's -- the haze is also what the fog paints where nothing has been seen, so it is
  ; dark at every hour: an RTS's black shroud, never a pale mist (the owner, 2026-10-20). Night is a cold low "moon": dark, and every road
  ; and creature still read through it.
  Sky = [
    "0 30 28 40 0x8CA8E0 0x4A5A9A 0x0A1428",
    "4.5 30 28 40 0x8CA8E0 0x4A5A9A 0x0A1428",
    "5.5 8 40 42 0xB08AC0 0x6A5A90 0x16121E",
    "6.5 12 75 48 0xFFA868 0x9A86B0 0x1C1418",
    "8 30 95 54 0xFFE8C8 0xD8DCF4 0x141A20",
    "12 40 100 55 0xFFF7E6 0xE6E6FF 0x161C24",
    "17 28 95 54 0xFFE8C8 0xD8DCF4 0x141A20",
    "18.5 10 80 46 0xFF8A48 0xA07A9A 0x1C1412",
    "19.5 6 45 42 0xB070A0 0x5A4A88 0x140E1C",
    "20.5 30 28 40 0x8CA8E0 0x4A5A9A 0x0A1428",
  ]
  ; Every fire's and lamp's light at the darkest hour, times its own.
  NightLights = 2

  ; The marsh's will-o-the-wisp, the Arvoh, only roams at night: by day it
  ; keeps to where it stands and senses nobody -- unless it is struck.
  NightRoamers = [Wisp]

  ; Crickets, heard in the open world at night.
  NightLoop = ambience.night

  ; A weather lasts three minutes; then the next is drawn for the ground under
  ; him, from the run's seed: the same weather on every machine and every load.
  WeatherFrames = 5400
  ; By the ground's paint character (data/maps/world): m the marsh's mud, n the
  ; highlands' snow, r rock, f the wood, s sand; * any other.
  Weathers = [
    "m = Fog 40, Rain 25, Clear 35",
    "n = Snow 60, Clear 40",
    "r = Clear 55, Rain 20, Storm 15, Fog 10",
    "f = Clear 60, Rain 30, Fog 10",
    "s = Clear 90, Storm 10",
    "* = Clear 65, Rain 25, Storm 10",
  ]
  ; How each looks and sounds. What falls is a picture round the camera, a
  ; column every FallSpacing units across a box FallBox wide: the box over the
  ; spacing, halved and squared four times, is how many -- kept under 4096.
  Looks = [
    Weather
      Name = Rain
      Tint = 0x28323C
      TintPercent = 18
      Falls = kit/effects/particles/trace_01.png
      ; Pale blue streaks, five widths long.
      FallColour = 0xC8E0FF
      Stretch = 5
      FallSpeed = 90
      FallSize = 2.4
      FallSpacing = 3
      FallBox = 120
      Sway = 0.2
      Loop = weather.rain
    End,
    Weather
      Name = Storm
      Tint = 0x18202C
      TintPercent = 30
      Falls = kit/effects/particles/trace_01.png
      ; Pale blue streaks, five widths long.
      FallColour = 0xC8E0FF
      Stretch = 5
      FallSpeed = 120
      FallSize = 2.8
      FallSpacing = 2.5
      FallBox = 120
      Sway = 0.4
      Loop = weather.rain
      ; A flash and a clap about once in 25 seconds.
      ThunderFrames = 750
      Thunder = weather.thunder
    End,
    Weather
      Name = Snow
      Tint = 0xC8D2E0
      TintPercent = 12
      Falls = kit/effects/particles/circle_05.png
      FallSpeed = 8
      FallSize = 1
      FallSpacing = 3
      FallBox = 120
      Sway = 3
      Loop = weather.wind
    End,
    ; A fog bank over the marsh: nothing falls, the world goes pale and near.
    Weather
      Name = Fog
      Tint = 0xB4BEC4
      TintPercent = 34
    End,
  ]

  ; The clock by the minimap names the part of the day.
  ClockWords = [Tun, Tong, Kun, Shom]
End
