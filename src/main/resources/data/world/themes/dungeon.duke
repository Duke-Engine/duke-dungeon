; ---------------------------------------------------------------------------
; How a floor looks
;
; A theme is two things. Its Terrain is the ground: how the chambers are cut and
; how the land rises under them -- a wood is open and rolling, a cellar close and
; cut, and those are different floors, not one floor dressed twice. Everything
; else is the look: a kit to build the floor from, a colour for the dark, and
; whatever creatures are drawn differently while it lasts. The look changes no
; cell, no monster and no number the simulation reads -- which is why a test can
; hold the checksum still across two themes that differ only in how they look.
;
; A fourth theme is a file like this one and a folder of models. There is no Java.
;
;   Theme      what the kit is and how it is placed
;   Terrain    the ground its floors are carved into
;   Tones      its variations, one drawn from the seed for each floor
;   Monsters   the creatures drawn differently while it lasts
;
; Which depth wears which is the map's to say: Themes in data/maps/endless.duke.
;
; The placement numbers are the awkward part and they are awkward because kits
; disagree. Where a wall's origin sits, how wide a wall was modelled against its
; own floor tiles, whether the models carry their own colours -- every kit
; answers differently, and every one of those answers is measured rather than
; guessed. See DungeonTilesTest, which loads each of them and checks.
;
; And one of them is not a measurement at all but a question about the art:
; is the wall piece a SURFACE or a THING? A surface tiles -- two storeys of it is
; two courses, every one alike, all facing the way the boundary faces. A thing
; does none of that: two storeys of tree is one bigger tree, and a row of
; identical trees at identical spacing is an orchard rather than a wood. That is
; what WallFillsRock, WallClump, WallSpread and WallVariety are between them, and a
; kit that says none of them gets masonry, which is what every kit got before
; they existed.
; ---------------------------------------------------------------------------

; Caverns floored with worked stone and bounded by the cliff they were cut from.
; The owner's rule: a cave is walled by rock, and a worked slab belongs only where
; something was built -- so the wall is a THING, a cliff rock standing in each
; piece of rock that borders a floor (the KayKit Forest pack's, on the forest's
; atlas, which is why that picture is in the dungeon's folder too), and the
; masonry slab survives only as the RockFace under raised ground.
;
; No corner post: a cliff line has no notch to plug, and this kit's corner piece
; is a length of wall bent round a right angle anyway.
Theme
  Name = Dungeon
  TileSize = 4
  ; The rocks are modelled on their own scale -- 3.69 across, where the floor is
  ; four -- so they are sized by their own module: one rock is one cell across
  ; and about a storey tall. Measured off the model, as every number here is.
  WallTileSize = 3.69
  ; The lid over the rock lies on the ground, as the wood's does: what you cannot
  ; walk into is the cliff standing on it, not a roof at wall height.
  WallHeight = 0
  ; No WallShift: a rock stands in the middle of its own cell and takes none, and
  ; the masonry face sets itself back by its own measured depth.
  Stairs = models/tiles/dungeon/stairs.gltf
  WallFillsRock = Yes
  ; Two rocks to a cell, close about its middle, each a little bigger or smaller
  ; and turned its own way: a cliff line rather than a row of one boulder. Close,
  ; because a rock is solid to the ground where a tree is a trunk, and a rock
  ; leaning out over the floor is a rock the heroes walk through.
  WallClump = 2
  WallSpread = 0.18
  WallVariety = 0.35
  ; Masonry is for what was built: the retaining wall under a raised floor, which
  ; the client draws only where rock stands above the foot of its face.
  RockFace = models/tiles/dungeon/wall.gltf
  ; ★ The lid on the rock is a FLOOR TILE, the same model and picture as the
  ; ground of a room, and deeper in the rock nothing stands on it -- so without a
  ; colour of its own the rock beyond the cliff line reads as more floor. Dark and
  ; a little cold: rock in shadow. Under the rocks themselves it barely shows,
  ; because they cover their cell -- which is also why the wood can go without.
  CapTint = 0x66626E
  ; And each storey up a little brighter, which is the same question one level
  ; out: a raised room is the same tiles higher up, and looking down a slope
  ; there is otherwise nothing to say it is not simply further away. 100 is flat.
  ;
  ; Worked DOWN from the tallest storey the map has, because a tint multiplies
  ; and multiplying can only darken -- ask a white tile to be brighter and it
  ; hands back the white it already was. So the top floor is left alone and the
  ; ones under it step down, which comes out looking like what this says.
  StoreyShadePercent = 108
  FogTint = 0x07060A
  ; ---- the ground ----
  ;
  ; Caverns cut out of the rock and the tunnels between them. Close: a hall keeps
  ; near the curve it was cut to, where a wood's glades wander. Each cavern floor
  ; is laid nearly level and the tunnels do the climbing -- going deeper is
  ; walking down a slope into the next hall, where it used to be a flight of
  ; stairs at every doorway.
  Terrain = Terrain
    ; How far a chamber's edge strays from the curve, and a tunnel from the
    ; straight line, as percentages.
    Ragged = 20
    Winding = 30
    ; Tunnels beyond the ones that join every chamber, as a percentage of the
    ; chambers: a way round. Never into the boss's hall.
    Loops = 20
    ; A block of rock left standing inside a cavern -- a pillar to fight round.
    IslandsPerRoom = [0, 2]
    ; The ground, in steps of a sixteenth of a cell. Rise is how high it gets
    ; over the lowest point, HillSize about how many cells across a rise is, and
    ; Slope the steepest it may be across one cell: 16 is a cliff, so up to 15.
    Rise = 40
    HillSize = 7
    Slope = 7
    ; How level a cavern's floor is laid, as a percentage.
    Level = 70
  End
  ; Where it grows on a floor that mixes biomes: how wild, then how alive, each
  ; 0 to 100. Caves are more cut than grown, and damp enough for moss -- see
  ; Biomes in data/world/generation.duke.
  Climate = [15, 50]
  ; What lies about on a cavern's floor, for the look alone -- nothing walks into
  ; it: fallen stone. See forest.duke for what the numbers mean.
  Scenery = [
    Scatter
      Model = models/tiles/forest/pebble.gltf
      PerHundred = 12
      Scale = 3
    End,
    Scatter
      Model = models/tiles/forest/stone.gltf
      PerHundred = 6
      Scale = 2.5
    End
  ]
  Tones = [
    Tone
      Name = Stone
      Floor = models/tiles/dungeon/floor.gltf
      Wall = models/tiles/dungeon/cliff_a.gltf
      Walls = [models/tiles/dungeon/cliff_b.gltf, models/tiles/dungeon/cliff_c.gltf, models/tiles/dungeon/spire_a.gltf]
    End,
    Tone
      Name = Cracked
      Floor = models/tiles/dungeon/floor_rocks.gltf
      Wall = models/tiles/dungeon/cliff_b.gltf
      Walls = [models/tiles/dungeon/cliff_c.gltf, models/tiles/dungeon/spire_b.gltf, models/tiles/dungeon/cliff_a.gltf]
    End
  ]
  Monsters = [
    ; ---- what stands about, theme by theme ------------------------------------
    ;
    ; The templates are the same either way (data/props/); what a Pillar is made
    ; of is the theme's business. Scales are measured off the models: a pillar four
    ; units tall wants 2.5 to stand a storey high, a barrel two units wants 3.
    ThemeMonster
      Name = Pillar
      Model = models/props/dungeon/pillar.gltf
      ModelScale = 2.5
    End,
    ThemeMonster
      Name = Statue
      Model = models/props/dungeon/pillar_decorated.gltf
      ModelScale = 2.5
    End,
    ThemeMonster
      Name = Barrel
      Model = models/props/dungeon/barrel.gltf
      ModelScale = 3.0
    End,
    ; The chest a monster leaves behind. It has been a torch-coloured box since the
    ; game was written, because no kit shipped with one; this one does.
    ThemeMonster
      Name = Chest
      Model = models/props/dungeon/chest.gltf
      ModelScale = 5.0
    End,
    ; The fountain at the way in: the same stone in every theme, and the water it
    ; carries is its Effect -- see data/props/fountain.duke. Scaled to fifteen across,
    ; a cell and a half, the basin its Geometry is as wide as.
    ThemeMonster
      Name = Fountain
      Model = models/props/fountain/fountain.glb
      ModelScale = 7.5
      Effect = FountainWater
    End
  ]
End
