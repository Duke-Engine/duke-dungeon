; ---------------------------------------------------------------------------
; A pine wood on high ground.
;
; The forest's kit on colder, higher land: the same dirt underfoot and the same
; retaining wall where a terrace stands proud, with pines where the forest has
; its broad trees. A pine is narrow and tall, so it is sized three to a cell
; rather than one -- a cell-wide pine would stand three storeys over its glade
; and hide it from the camera -- and the ground here rises highest of anywhere
; in the descent.
;
; A biome more than a whole floor's theme: a floor that mixes them grows this
; wherever its weather is wild and only just alive -- see Biomes in
; data/world/generation.duke. The numbers mean what they mean in forest.duke.
; ---------------------------------------------------------------------------
Theme
  Name = PineWood
  TileSize = 4
  ; A module of six for a pine 3.74 across: each comes out about six units wide
  ; and eighteen tall, and three stand in every cell of rock.
  WallTileSize = 6
  WallHeight = 0
  Stairs = models/tiles/forest/stairs.gltf
  WallFillsRock = Yes
  WallClump = 3
  WallSpread = 0.3
  WallVariety = 0.45
  RockFace = models/props/forest/wall.gltf
  StoreyShadePercent = 108
  ; A cold dark under the needles.
  FogTint = 0x05090B
  Terrain = Terrain
    Ragged = 40
    Winding = 45
    Loops = 30
    IslandsPerRoom = [1, 3]
    Rise = 72
    HillSize = 12
    Slope = 7
    Level = 20
  End
  ; Wilderness, and alive only just: needles, stone and cold.
  Climate = [90, 35]
  Tones = [
    Tone
      Name = Tall
      Floor = models/tiles/forest/floor_rocky.gltf
      Wall = models/tiles/forest/pine_tall.gltf
    End,
    Tone
      Name = Young
      Floor = models/tiles/forest/floor.gltf
      Wall = models/tiles/forest/pine.gltf
    End
  ]
  ; What stands about is the wood's own: see forest.duke.
  Monsters = [
    ThemeMonster
      Name = Pillar
      Model = models/props/forest/tree_bare.gltf
      ModelScale = 3.5
    End,
    ThemeMonster
      Name = Statue
      Model = models/props/forest/rock.gltf
      ModelScale = 6.5
    End,
    ThemeMonster
      Name = Barrel
      Model = models/props/forest/rock_small.gltf
      ModelScale = 9.0
    End,
    ThemeMonster
      Name = Chest
      Model = models/props/forest/chest.gltf
      ModelScale = 5.0
    End,
    ThemeMonster
      Name = Fountain
      Model = models/props/fountain/fountain.glb
      ModelScale = 7.5
      Effect = FountainWater
    End
  ]
End
