; Duke Dungeon — the front menu: its rows, every fixed word of the client's menus in the game's own,
; and the live scene behind them. See docs/plan/2026-09-30-main-menu.md.
MainMenu
  ; The game's name: window title and the heading over the menu. "Last Hero" is a stand-in until the owner names it.
  Title = "Last Hero"
  ; The line under the title.
  Subtitle = "Har safar boshqa zindon"
  ; The front menu: Davom ettirish (with a save), Yangi o'yin, Yuklash (with saves), Mualliflar -- the game's own
  ; rows -- then the engine's Settings and Quit, worded here.
  SettingsWord = Sozlamalar
  QuitWord = Chiqish
  ; The owner, 2026-10-09: the rows at one side, the scene seen across the rest.
  Side = LEFT
  Margin = 64
  CreditsWord = Mualliflar
  CreditsBlurb = "O'yin kimlarning ishidan yasalgan"
  CreditsTitle = MUALLIFLAR
  CreditsHint = "YUQORI PAST tanlang    ESC ortga"
  ; The client's fixed words, each "the English it says when a game names none = what this game says".
  ; The Keys list in Settings (E46) is among them: its heading, and the client's own controls by their English names.
  Words = [
    "PAUSED = TO'XTATILDI",
    "Resume = Davom etish",
    "Settings = Sozlamalar",
    "Quit to the main menu = Bosh menyuga chiqish",
    "Quit to the desktop = O'yindan chiqish",
    "ESC resume = ESC davom etish",
    "QUIT TO THE MAIN MENU? = BOSH MENYUGA CHIQILSINMI?",
    "QUIT TO THE DESKTOP? = O'YINDAN CHIQILSINMI?",
    "everything on this floor is lost = o'yin saqlanadi, qaytib davom ettirasiz",
    "Keep playing = O'ynashda davom etish",
    "Quit = Chiqish",
    "ESC keep playing = ESC o'ynashda davom etish",
    "SETTINGS = SOZLAMALAR",
    "Fullscreen = To'liq ekran",
    "NO = YO'Q",
    "YES = HA",
    "Size = O'lcham",
    "MONITOR = MONITOR",
    "Anti-aliasing = Silliqlash",
    "OFF = O'CHIQ",
    "Volume = Ovoz",
    "Effects = Effektlar",
    "Voice = Nutq",
    "Music = Musiqa",
    "Ambience = Muhit",
    "Camera shake = Kamera titrashi",
    "Full = To'liq",
    "Half = Yarim",
    "Off = O'chiq",
    "Track = Kuy",
    "Save = Saqlash",
    "Cancel = Bekor qilish",
    "Back = Orqaga",
    "anti-aliasing from the next launch = silliqlash keyingi ishga tushirishda",
    "unsaved changes = saqlanmagan o'zgarishlar",
    "UP DOWN choose    LEFT RIGHT change    ESC back = YUQORI PAST tanlang    CHAP O'NG o'zgartiring    ESC chiqish",
    "UP DOWN choose    ENTER take = YUQORI PAST tanlang    ENTER tanlash",
    "Keys = Tugmalar",
    "Pan up = Kamera yuqoriga",
    "Pan left = Kamera chapga",
    "Pan down = Kamera pastga",
    "Pan right = Kamera o'ngga",
    "Turn left = Chapga burish",
    "Turn right = O'ngga burish",
    "Zoom in = Yaqinlashtirish",
    "Zoom out = Uzoqlashtirish",
    "Reset view = Kamerani tiklash",
    "Stop = To'xta",
    "Scatter = Tarqalish",
    "Force attack = Majburiy hujum",
    "Queue waypoints = Yo'l nuqtalari navbati",
    "Add to selection = Tanlovga qo'shish",
    "Select all = Hammasini tanlash",
    "Select all of kind = Shu turdagilarni tanlash",
    "Select same type = Bir xilini tanlash",
    "Next unit = Keyingi jangchi",
    "Previous unit = Oldingi jangchi",
    "Centre on base = Qarorgohga qaytish",
    "Latest alert = So'nggi ogohlantirish",
    "Options = Menyu",
    "Toggle command bar = Buyruqlar paneli",
    "Chat all = Hammaga xabar",
    "Chat allies = Ittifoqchilarga xabar",
    "Screenshot = Skrinshot",
    "Pause = Pauza",
  ]
  ; ---- the scene behind the menu: the kingdom's soldiers holding a clearing against the skeletons ----
  ; A real fight of the game's own creatures and brains, the fallen coming back, so it never ends.
  SceneLook = "Forest,Wooded"
  Soldiers = [Knight, Knight, Rogue, Rogue, Mage]
  Foes = [Skeleton, Skeleton, Skeleton, Runner, Brute, SkeletonMage]
  ; The camera over it, higher than the one a game is played with (55 degrees, 140 back): the owner, 2026-10-10.
  ScenePitch = 66
  SceneZoom = 230
  ; Cells left of the fight it looks at, so the fight stands to the right of the menu at the left.
  SceneShift = 7
End

; What the window shows before the front menu, and while any map loads (the owner, 2026-10-15): the maker's credit,
; then the game's name (MainMenu's Title, and its Subtitle under it) coming up gold out of the dark, then a load
; screen with a bar and a hint -- the menu fades in only once the scene behind it is laid and running. A key or a
; click skips the splash after SkipAfter. Times in seconds.
Splash
  EngineWord = "Duke Engine"
  EngineSeconds = 1.0
  TitleSeconds = 3.0
  RiseSeconds = 1.2
  SkipAfter = 0.5
  ; Kenney's jingle (CC0), as the name lands; a Sound block in data/sounds/ui.duke.
  Sound = splash
  TitleFont = fonts/Cinzel-Bold.ttf
  TitleColour = 0xE8C37A
  GlowColour = 0xE8A33D
  TextColour = 0xD9CFBA
  LoadingWord = "Yuklanmoqda…"
  Tips = [
    "Taom jonni tiklaydi: Z tugmasi bilan yeng.",
    "G tugmasi o'tin bo'lsa gulxan yoqadi; gulxanda ovqat pishiriladi.",
    "M tugmasi xaritani ochadi.",
    "L tugmasi topshiriqlar daftarini ochadi.",
    "C tugmasi qahramon varag'ini ochadi.",
    "Yiqilgan dushmandan qolgan narsalarni yig'ib oling.",
  ]
  TipSeconds = 4.0
  BarSpeed = 120
  FadeSeconds = 0.6
End
