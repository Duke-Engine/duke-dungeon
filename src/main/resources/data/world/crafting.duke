; Each second of work, the hammer; done, the sword's ring (CC0, see CREDITS.md).
Sound
  Name = work.craft
  Channel = Effects
  Positional = Yes
  Gain = 0.45
  Files = [audio/sfx/weapon/metal_hit_1.ogg, audio/sfx/weapon/metal_hit_2.ogg, audio/sfx/weapon/metal_hit_3.ogg]
End

Sound
  Name = craft.done
  Channel = Effects
  Positional = Yes
  Gain = 0.6
  Files = [audio/sfx/skill/sword_ring.ogg]
End

; Sparks off his work each second.
Effect
  Name = WorkCraft

  Layers = [
    Layer
      Name = Sparks
      Type = BURST
      Texture = kit/effects/particles/spark_01.png
      Blend = Additive
      Count = 8
      Life = [0.25, 0.45]
      Size = [0.8, 0.3]
      Colour = [0xFFE6A0, 0xFF8A2A]
      Alpha = [1, 0]
      Speed = [8, 14]
      Direction = UP
      Spread = 70
      Gravity = 30
      Height = 3
    End
  ]
End
