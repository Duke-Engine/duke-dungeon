; ---------------------------------------------------------------------------
; How a fight FEELS. Drawing only, but for the Stagger block (and the hero thresholds it reads):
; that one the simulation keeps.
;
; Three things carry it, each in its own place:
;   * the number and the flash on every hit -- HitNumbers (hud.duke), HitFeel (scene.duke);
;   * the camera knock, which is for BIG moments only -- the knight's W and R
;     (knight_knocks.duke), the meteor, and what is below;
;   * nothing else shakes the screen: an ordinary blow is a number and a flash.
;
; A HeavyBlow says that a creature of Template, struck for MajorAt or more (after its
; armour), has been hit hard, and plays Plays on it. Plays is an EffectList, which is where
; a camera knock lives; its strengths are the reference's six (SUBTLE, NORMAL, STRONG,
; SEVERE, CINE_EXTREME, CINE_INSANE) and several land at once, added up to a ceiling -- a
; wave through five skeletons is a rumble, not a quake, so the per-blow ones stay SUBTLE.
; No block for a template means no knock for it: fodder dies to a Q and nobody feels it.
;
; A BigDeath plays Plays where a Template fell.
;
; The hero's thresholds are what a boss's slam or a brute's swing is worth; the beasts'
; are about a fifth of their health, so only the blow that is a real part of the fight.
; ---------------------------------------------------------------------------
EffectList
  Name = HeavyHit
  Entries = [
    Shake
      Strength = SUBTLE
    End
  ]
End

EffectList
  Name = HeroHit
  Entries = [
    Shake
      Strength = NORMAL
    End
  ]
End

EffectList
  Name = Thud
  Entries = [
    Shake
      Strength = NORMAL
    End
  ]
End

EffectList
  Name = Slam
  Entries = [
    Shake
      Strength = STRONG
    End
  ]
End

; What knocks the screen when it is HIM that is hurt hard.
HeavyBlow
  Template = Knight
  MajorAt = 45
  Plays = HeroHit
End
HeavyBlow
  Template = Mage
  MajorAt = 35
  Plays = HeroHit
End
HeavyBlow
  Template = Rogue
  MajorAt = 35
  Plays = HeroHit
End

; And the big things, when a blow on them is a big one.
HeavyBlow
  Template = Brute
  MajorAt = 60
  Plays = HeavyHit
End
HeavyBlow
  Template = Reaper
  MajorAt = 90
  Plays = HeavyHit
End
HeavyBlow
  Template = Warden
  MajorAt = 110
  Plays = HeavyHit
End
HeavyBlow
  Template = Champion
  MajorAt = 130
  Plays = HeavyHit
End
HeavyBlow
  Template = QueenBoss
  MajorAt = 130
  Plays = HeavyHit
End

; Deaths worth feeling: the bodies that fall hard.
BigDeath
  Template = Brute
  Plays = Thud
End
BigDeath
  Template = Reaper
  Plays = Thud
End
BigDeath
  Template = Warden
  Plays = Slam
End
BigDeath
  Template = Champion
  Plays = Slam
End
BigDeath
  Template = QueenBoss
  Plays = Slam
End
BigDeath
  Template = Knight
  Plays = Thud
End
BigDeath
  Template = Mage
  Plays = Thud
End
BigDeath
  Template = Rogue
  Plays = Thud
End

; The wilds (data/units/wilds_*.duke): a camp boss is hit hard at about a fifth of his health and
; slams as he falls; an elite and the ogre are big bodies that thud.
HeavyBlow
  Template = GoblinChief
  MajorAt = 105
  Plays = HeavyHit
End
HeavyBlow
  Template = Dragon
  MajorAt = 110
  Plays = HeavyHit
End
HeavyBlow
  Template = GiantKing
  MajorAt = 130
  Plays = HeavyHit
End
HeavyBlow
  Template = BogHorror
  MajorAt = 110
  Plays = HeavyHit
End
BigDeath
  Template = GoblinChief
  Plays = Slam
End
BigDeath
  Template = Dragon
  Plays = Slam
End
BigDeath
  Template = GiantKing
  Plays = Slam
End
BigDeath
  Template = BogHorror
  Plays = Slam
End
BigDeath
  Template = BloodWolf
  Plays = Thud
End
BigDeath
  Template = FireLizard
  Plays = Thud
End
BigDeath
  Template = StoneGoleling
  Plays = Thud
End
BigDeath
  Template = VenomFrog
  Plays = Thud
End
BigDeath
  Template = Ogre
  Plays = Thud
End

; The catch in the motion: a MAJOR blow (critical, or HitNumbers' BigAt and over) slows the one struck and the one
; striking to Slow of their speed for Seconds -- the window's animation only, the simulation runs on. A second blow
; inside it does not lengthen it. Particles are not dipped. CritOnly would keep it for crits alone.
Flinch
  ; When a creature that is hurt plays its Hurt clip. The client never plays it over a swing, a cast, its work or
  ; while it has a target (E71); this says at most once in Seconds, and with HeavyOnly only at a heavy blow -- a
  ; critical one or HitNumbers' BigAt and over. The owner's playtest of 1.0.43: a hero in a crowd "stuck
  ; trembling from the incoming blows". No creature has one the client plays: the monsters name no Hurt,
  ; and a hero's flinch is his stagger, below.
  Seconds = 1.0
  HeavyOnly = true
End

; A hero struck hard staggers -- the simulation's, not only the window's: a blow on him of his HeavyBlow's
; MajorAt or more (after his armour; above) stuns him for Frames (the skill system's stun: his weapon's wind-up
; starts over after it, its reload waits, no skill casts, his walk stops and an order given in it waits for its
; end), his Hurt clip playing for exactly those frames; and none takes him again for ImmuneFrames after it ends,
; so a crowd cannot hold him. 30 frames a second: 11 is 0.37s, 36 is 1.2s. Light blows never stagger.
Stagger
  Frames = 11
  ImmuneFrames = 36
End

HitStop
  Seconds = 0.05
  Slow = 0.1
  MajorOnly = true
  CritOnly = false
End

; A critical blow, on top of a heavy one: it plays its own list on the creature struck -- hurt.<T>.normal.crit, which
; the client uses where it is named and otherwise falls back to the heavy blow's. A knock for every creature (a
; crit is rare and is the moment to feel), a stronger one where it is a hero that is struck, so the crit on him lands
; harder than the crit he deals.
EffectList
  Name = CritHit
  Entries = [
    Shake
      Strength = NORMAL
    End
  ]
End

EffectList
  Name = HeroCrit
  Entries = [
    Shake
      Strength = STRONG
    End
  ]
End

CritBlow
  Plays = CritHit
End
CritBlow
  Template = Knight
  Plays = HeroCrit
End
CritBlow
  Template = Mage
  Plays = HeroCrit
End
CritBlow
  Template = Rogue
  Plays = HeroCrit
End
