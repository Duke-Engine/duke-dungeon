; ---------------------------------------------------------------------------
; Uniques: epic things, written by hand, four to six affixes each. Gives are its
; affixes, a Stat and how much (ATTRIBUTE its own attribute); its base's figure is the base's best. Skills are
; passives it
; lends: an aura reaches whoever stands with him too.
; ---------------------------------------------------------------------------

Unique
  Name = ajdar_tishi
  DisplayName = Ajdar tishi
  Base = keng_qilich
  Level = 6
  Gives = ["ATTACK 14", "ATTACK_SPEED 12", "LIFESTEAL 6", "CRIT_CHANCE 8", "CRIT_DAMAGE 40"]
  Lore = "Ajdarning og'zidan sug'urib olingan; tig'i hali ham iliq."
End

Unique
  Name = qala_devori
  DisplayName = "Qal'a devori"
  Base = temir_sovut
  Level = 7
  Gives = ["ARMOUR 6", "HEALTH_REGEN 5", "HEALTH 80", "LIFESTEAL 3"]
  Lore = "Poytaxt qulagan kuni ham bu sovut bukilmagan."
End

Unique
  Name = bori_boshi
  DisplayName = "Bo'ri boshi"
  Base = shoxli_dubulga
  Level = 8
  Gives = ["HEALTH 90", "MANA_REGEN 3", "LIFESTEAL 4", "HEALTH_REGEN 4"]
  Lore = "Oxirgi oq bo'rining bosh suyagidan; to'lin oyda uvillaydi."
End

Unique
  Name = shamol_izi
  DisplayName = Shamol izi
  Base = charm_etik
  Level = 4
  Attribute = Agility
  Gives = ["ATTRIBUTE 5", "ATTACK_SPEED 14", "MOVE_SPEED 12", "HEALTH_REGEN 3"]
  Lore = "Uni kiygan chopqirni hech kim quvib yetolmagan."
End

Unique
  Name = kampir_marjoni
  DisplayName = Kampir marjoni
  Base = zumrad_tumor
  Level = 8
  Gives = ["MANA 40", "MANA_REGEN 4", "CRIT_CHANCE 5", "CRIT_DAMAGE 30"]
  Lore = "Yalmog'iz kampir uni qochgan qizning bo'ynidan yulib olgan."
  Skills = [
    Skill
      Key = U
      Effect = MANA_AURA
      Name = "Kampir sehri: yonidagilarga +3 Mana/s"
      ManaRegen = 30
      Radius = 40
      MaxRank = 1
    End
  ]
End

Unique
  Name = qonli_ahd
  DisplayName = Qonli ahd
  Base = oltin_uzuk
  Level = 3
  Attribute = Strength
  Gives = ["ATTRIBUTE 5", "LIFESTEAL 8", "HEALTH 40", "CRIT_DAMAGE 50"]
  Lore = "Har zarbadan bir tomchi qon so'raydi va oladi."
  Skills = [
    Skill
      Key = U
      Effect = DAMAGE_AURA
      Name = "Qon ahdi: yonidagilarga +10% Zarba"
      BoostPercent = 10
      Radius = 40
      MaxRank = 1
    End
  ]
End

