; ---------------------------------------------------------------------------
; What is found — see docs/plan/2026-10-15-loot.md.
;
; A thing a monster drops, a map's treasure holds or the merchant sells is made
; here: a base (what it is: a sword, mail, a ring), a rarity (common, magic, rare,
; epic), and for magic and rare things affixes rolled by its item level. An epic
; thing is a Unique, written by hand. Food and drink are stacks in the backpack,
; eaten from the belt with keys 1-4.
;
; Every figure is the engine's: a base moves its slot's figure (ATTACK and ARMOUR
; in percent, HEALTH and MANA flat, ATTRIBUTE whole points), and every affix is
; the engine's Affix (E43), any figure on any slot it names: crit and move speed
; (E44), a skill's rank, and LIFESTEAL as a passive the thing lends.
; ---------------------------------------------------------------------------

ItemRules
  ; Each rarity's word and colour, common, magic, rare, epic: the name on a card,
  ; and the light a thing lying on the ground stands in.
  Rarities = [Oddiy, Sehrli, Noyob, Afsonaviy]
  Colours = [0xC8CCD2, 0x5B9BFF, 0xE8B23A, 0xB46CFF]
  ; The rarities each source drops, out of their sum: an ordinary monster, an elite,
  ; a boss, a treasure a map places, the merchant's stock.
  Normal = [700, 250, 45, 5]
  Elite = [380, 430, 160, 30]
  Boss = [0, 450, 430, 120]
  Chest = [250, 450, 260, 40]
  Shop = [550, 380, 70, 0]
  ; How many affixes, from and to.
  MagicAffixes = [1, 2]
  RareAffixes = [3, 4]
  ; A thing's price: its base's, times its rarity's in percent, and 8% more each
  ; item level past the first. It sells for Trade's SellPercent of it.
  Prices = [100, 250, 500, 1200]
  PricePerLevel = 8
  ; The chance an elite drops anything (a monster's and a boss's are LootDrops').
  EliteDropPercent = 15
  ; The wilds' elites too (data/units/wilds_*.duke): bigger, tinted, with an affix or two.
  Elites = [Brute, Champion, Warden, Reaper, BloodWolf, FireLizard, StoneGoleling, VenomFrog, BanditVeteran,
    GiantArmabee, OrcWarlord, ZombieGiant, BroodMother, BloodShark, PirateCaptain, FrostYeti, HellDemon, FireGolem,
    LightGolem, ShadowGolem]
  ; Who guards a camp of the open world: each drops as a boss does -- always, BossDrops things,
  ; BossLevel above its own -- wherever it stands.
  CampBosses = [GoblinChief, Dragon, GiantKing, BogHorror, BanditChief, MushroomKing, Troll, FallenKing, Kraken,
    Wyvern, DemonBrute, Minotaur]
  ; Of an ordinary or elite drop, how many in a hundred are food or drink.
  PotionPercent = 35
  ; A boss drops one thing, a level above its own (two until the owner cut drops, 2026-10-19).
  BossDrops = 1
  BossLevel = 1
  ; A base is found from its Level to six levels past it, then is left behind.
  BaseWindow = 6
  ; A rare's name: one of the first, one of the second.
  FirstNames = [Qora, Qonli, Muzli, Olovli, Tungi, Qahrli, Jim, Yovuz, Qadimiy, "So'nggi", "Bo'ronli", Kumush, Temir, Sovuq, Shum, Telba]
  SecondNames = [tish, "tig'", yara, qahr, "o'lim", chaqmoq, soya, "bo'ron", ilon, burgut, "bo'ri", "yo'lbars", qasos, "la'nat", sado, alanga]
  ; The light a magic, a rare and an epic thing lying on the ground stands in,
  ; played on it again every BeamFrames (30 = one second). A common one lies dark.
  Beams = [LootBeamMagic, LootBeamRare, LootBeamEpic]
  BeamFrames = 45
  ; The belt: the first four potion stacks in the backpack, keys 1-4, and how long
  ; after a draught it is ready again.
  BeltSize = 4
  BeltFrames = 30
  LevelWord = "%d-daraja"
  CompareWord = Kiyilgan bilan solishtiring
  CountWord = "Soni: %d"
  DrinkHint = "%s: yeyish, ichish"
  ; What each belt key does, on the Settings screen's list of keys; %d the key.
  BeltKeyWord = "Belbog'dan yeyish: %d"
  ; A map's placed thing called this is a treasure: a roll at the floor's level.
  Treasure = Xazina
  ; A card's colours: the base figure, an affix, a unique's story, and a difference
  ; to what is worn, more and less.
  FigureColour = 0xFFFFFF
  AffixColour = 0x7FB2FF
  LoreColour = 0xD8B05A
  BetterColour = 0x6CD86C
  WorseColour = 0xE05A4A
  ; The words of the figures E44 added, on a card and the character sheet; %s the key.
  CritChanceWord = Kritik zarba
  CritDamageWord = Kritik zarba kuchi
  MoveSpeedWord = Yurish tezligi
  ; The longest line a card says, in letters: a unique's story is broken to it.
  Wrap = 40
End

