; ---------------------------------------------------------------------------
; The light a thing lying on the ground stands in: a thin column of its rarity's
; colour and a glow at its foot, played on it again every BeamFrames.
; ---------------------------------------------------------------------------

Effect
  Name = LootBeamMagic

  Layers = [
    Layer
      Name = Beam
      Type = PILLAR
      Texture = kit/effects/particles/pillar_core.png
      Blend = Additive
      Count = 1
      Life = [2.2, 2.2]
      Size = [3, 3]
      Height = 34
      Direction = UP
      Colour = [0x5B9BFF, 0x3F86FF]
      Alpha = [0.5, 0.5]
      FadeIn = 0.4
      FadeOut = 0.6
      At = CASTER
      Follows = Yes
    End,

    Layer
      Name = Foot
      Type = AURA
      Texture = kit/effects/particles/light_02.png
      Blend = Additive
      Cover = 0.1
      Count = 1
      Size = [8, 8]
      Colour = [0x8AB8FF, 0x5B9BFF]
      Alpha = [0.45, 0.45]
      FadeIn = 0.3
      FadeOut = 0.5
      Height = 2
    End
  ]
End

Effect
  Name = LootBeamRare

  Layers = [
    Layer
      Name = Beam
      Type = PILLAR
      Texture = kit/effects/particles/pillar_core.png
      Blend = Additive
      Count = 1
      Life = [2.2, 2.2]
      Size = [3.5, 3.5]
