; ---------------------------------------------------------------------------
; How the hero is played: the modern way (WASD walks him, the mouse aims, the left
; button attacks, the right one works), the classic Dota/WC3 way (the mouse does
; everything) or the action way (the mouse turns the camera, no pointer) -- see
; docs/plan/2026-10-15-modern-controls.md and 2026-10-15-action-controls.md.
;
; A skill keeps its own Key (Q W E R in its hero's file) as its name everywhere:
; the cast, his ranks, the save, an item's SKILL_RANK:E. Only the letter pressed
; changes, since W is a step forward in the modern scheme.
; ---------------------------------------------------------------------------
Controls
  ; MODERN, the owner's choice for a new player (2026-10-15), since the engine
  ; walks him on WASD, swings and locks on by the left button and rolls him on
  ; Space (E74-E80). A player's own choice wins (-Dlasthero.controls=classic, or
  ; the "controls" preference until E79's Settings row).
  Scheme = MODERN

  ; The Settings row (E79). The new scheme takes hold the next time the game is
  ; opened: the keys, the mouse and the camera all change together.
  SchemeWord = "Boshqaruv (keyingi ochilishda)"
  ModernWord = "Zamonaviy (WASD)"
  ClassicWord = "Klassik (sichqoncha)"

  ; Slot = the letter that presses it, modern. Q stays; the knight's shield
  ; charge moves to E, his dragon's blood (a passive, never pressed) to R and
  ; his pull to F -- and every hero's four the same way. None of W A S D
  ; (walking), the screens' C L M, the tracker's J, the fire's G, the client's
  ; H and P or the belt's digits: the file is refused if so.
  ModernSkillKeys = ["Q = Q", "W = E", "E = R", "R = F"]

  ; Space, modern: his roll (each hero's DODGE skill), on the keys page.
  DodgeWord = Chetlanish

  ; The third way (docs/plan/2026-10-15-action-controls.md): no pointer in play,
  ; the mouse turns the camera round him, the left button strikes ahead, the
  ; skills on the digits, E works the nearest thing in front of him. Until the
  ; engine's E90-E94 land it plays as Zamonaviy with these keys on top (the
  ; skills on 1-4, the belt on 5-8, no E yet), and its word says so: drop the
  ; bracket's "hozircha ... kabi" once they do.
  ActionWord = "Jangovar (hozircha Zamonaviy kabi)"
  ; Slot = the digit that presses it, action. Every slot a digit of its own,
  ; the passive's too (its digit then does nothing, as R does in modern).
  ActionSkillKeys = ["Q = 1", "W = 2", "E = 3", "R = 4"]
  ; The belt's stacks in order, on the digits after the skills: one a stack
  ; (ItemRules' BeltSize is 4).
  ActionBeltKeys = "5678"
  ; Work, talk or take the nearest thing in front of him (E94). Q R F are free.
  InteractKey = E
  ; The prompt over that thing, "[E] Gaplashish": each context order's word
  ; (the cursor's name -- a person's Talk, data/world/food.duke's Gathers, a
  ; thing on the floor's PickUp, the gate's ToTheGate, his horse's Ride), then what it
  ; says. Riding (data/world/mounts.duke): T calls and mounts as in every
  ; scheme, E on his horse mounts it, Space on horseback gets him off (the
  ; dodge is a skill, and a skill pressed riding dismounts), as do LMB and 1-4.
  InteractOrders = [Talk, Chop, Harvest, Fill, Mine, Cook, PickUp, ToTheGate, Ride]
  InteractWords = ["Gaplashish", "Kesish", "Terish", "Suv olish", "Qazish", "Pishirish", "Olish", "Darvozaga", "Minish"]
End
