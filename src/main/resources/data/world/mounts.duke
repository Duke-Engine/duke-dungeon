; The capital's stable keeper, by the city's east gate (stage/WorldMapWriter):
; he sells the whistle.
Monster
  Name = Otboqar
  DisplayName = "Otboqar Rustam"
  KindOf = [INFANTRY, SELECTABLE]
  Geometry = Cylinder
    Radius = 4
    Height = 12
  End
  VisionRange = 0
  Modules = [
    MoveUpdate
      Speed = 8
      TurnRate = 0
    End
  ]
  MinDepth = 99
  Weight = 0
  Colour = 0x806040
  Scale = 1.0
  Model = models/characters/heroes/ranger.glb
  Tint = 0x9A7A58
  ModelScale = 5.5
  Facing = 90
  Animations = Humanoid
  WalkStride = 4.1
End

Speaker
  Name = Otboqar
  DisplayName = "Otboqar Rustam"
  Picture =
End

Conversation
  Name = OtboqarGreets
  Lines = [
    Line
      Speaker = Otboqar
      Text = "Yaxshi ot - yarim yo'l! Hushtagini oling, shahar tashqarisida T ni bosing, oting chopib keladi."
    End
  ]
End

Npc
  Name = Otboqar
  Talk = OtboqarGreets
  Role = Otboqar
  Radius = 30
  Wander = 0
End

Merchant
  Name = Otboqar
  Stock = [
    ot 300 1,
    suv 5 6,
  ]
End
