; ---------------------------------------------------------------------------
; A horse on the open world (docs/plan/2026-10-15-mounts.md). Owning one is
; carrying its whistle (the Potion "ot" below), sold by the capital's stable
; keeper or given by the story. T calls it -- it neighs and runs in -- and casts
; his MOUNT skill on it (each hero's, Key = T, in data/units): up onto it, and
; off it again. A right-click on it (or action's E) gets him up too. Riding, he
; goes twice his walk and does nothing else: a blow, an attack or a skill gets
; him off, and so does a town or any map that is not out of doors -- the skill's
; NotIn, against the zones the game names (Ichkari on every map not in Maps).
;
; While he rides the horse carries him on its Saddle bone (engine E88): he is
; drawn as his riding look below, his own model playing his riding clips, and
; the horse gallops under him.
; ---------------------------------------------------------------------------

Mount
  Whistle = ot
  Horse = Horse
  Key = T
  KeyWord = Ot
  ; How near the horse's middle he gets up onto it; how far off it starts its run in.
  Reach = 14
  CallDistance = 70
  ; Out of doors: the open world only. Every other map is Ichkari to a MOUNT's NotIn.
  Maps = [world]
  ; Where a rider sits: the horse's bone (art/mounts/export_riders.py), and how far from it, in the horse's units.
  Bone = Saddle
  Seat = "0 0 0"
  NoHorseWord = Otingiz yo'q
  IndoorsWord = Bu yerda otga minib bo'lmaydi
  Call = mount.call
  Puff = MountDust
  ; Quicker legs on the buff row while he rides (MOVE_SPEED, named by Items' MoveSpeedWord).
  Skills = [
    Skill
      Key = T
      Effect = MOVE_SPEED
      Name = Ot
      Icon = icons/items/loot/horse_common.png
      Blurb = Otda: ikki barobar tez.
      MaxRank = 1
    End
  ]
End

; Owning a horse: its whistle. Never eaten, one to a place, sold by the stable
; keeper (data/story below) and never dropped (Weight 0).
Potion
  Name = ot
  DisplayName = "Ot hushtagi"
  Icon = horse
  Level = 1
  Price = 300
  Weight = 0
  Stack = 1
End

; The horse standing about while he is off it: Quaternius' "Horse" (CC0). On the
; engine's neutral side with no Body, so nothing fights it. It runs in at 48 a
; second when he whistles; its own hooves are walking.Horse below.
Monster
  Name = Horse
  DisplayName = Ot
  KindOf = [INFANTRY, SELECTABLE]
  Geometry = Cylinder
    Radius = 5
    Height = 10
  End
  VisionRange = 0
  Modules = [
    MoveUpdate
      Speed = 48
      TurnRate = 0
    End
  ]
  MinDepth = 99
  Weight = 0
  Colour = 0x8A5A30
  ; Its withers stand 10 under this ModelScale; its Saddle bone carries a rider.
  Model = models/characters/mounts/horse.glb
  ModelScale = 4.0
  Facing = 90
  Idle = Idle
  Walk = Gallop
  ; A gallop's stride, in world units, as MonsterClipFitTest measures it: the clip paced to its speed.
  WalkStride = 22
  Death = Death
End

; Each hero riding: drawn as one of these while he is on his horse (his MOUNT
; skill's Look). His own model and things in hand, playing his riding clips
; (Ride_Idle, Ride_Gallop: animations/characters/riding_*.glb), hung on the
; horse's Saddle bone -- so drawn in the horse's frame: no turn of his own
; (Facing 0), his own ModelScale over the horse's 4. Heard by his look: his
; footsteps are the horse's hooves (walking.<Look> below).
Monster
  Name = KnightRiding
  DisplayName = Garen
  KindOf = [INFANTRY]
  Geometry = Cylinder
    Radius = 5
    Height = 12
  End
  VisionRange = 0
  MinDepth = 99
  Weight = 0
  Colour = 0x8A5A30
  Model = models/characters/heroes/lange.glb
  ModelScale = 1.705
  Facing = 0
  Animations = Lange
  Idle = Ride_Idle
  ; As long as the horse's gallop and paced as it is, so the two keep step.
  Walk = Ride_Gallop
  WalkStride = 22
  Death = Death
End

Monster
  Name = RogueRiding
  DisplayName = Erika
  KindOf = [INFANTRY]
  Geometry = Cylinder
    Radius = 5
    Height = 12
  End
  VisionRange = 0
  MinDepth = 99
  Weight = 0
  Colour = 0x8A5A30
  Model = models/characters/heroes/huntress.glb
  ModelScale = 1.375
  Facing = 0
  Animations = Huntress
  Idle = Ride_Idle
  ; As long as the horse's gallop and paced as it is, so the two keep step.
  Walk = Ride_Gallop
  WalkStride = 22
  Death = Death_A
  ; The one thing in his hand a look may hold: his bow, his staff.
  Held = Held
    Model = models/items/weapons/elven_bow.glb
    Bone = handslot.l
    Scale = 0.8
    Roll = 180
  End
End

Monster
  Name = MageRiding
  DisplayName = Lira
  KindOf = [INFANTRY]
  Geometry = Cylinder
    Radius = 5
    Height = 12
  End
  VisionRange = 0
  MinDepth = 99
  Weight = 0
  Colour = 0x8A5A30
  Model = models/characters/heroes/mage.glb
  ModelScale = 1.130
  Facing = 0
  Animations = Humanoid
  Idle = Ride_Idle
  ; As long as the horse's gallop and paced as it is, so the two keep step.
  Walk = Ride_Gallop
  WalkStride = 22
  Death = Death_A
  ; The one thing in his hand a look may hold: his bow, his staff.
  Held = Held
    Model = models/items/gear/staff.gltf
    Bone = handslot.r
    Scale = 1
  End
End

; The pointer over his horse: a right-click gets him up onto it.
Cursor
  Name = Ride
  Image = ui/cursors/default/hand_open.png
  HotX = 15
  HotY = 15
  Tint = 0xC89A5A
End

; Dust kicked up where the horse appears from nowhere, and where he gets on and off.
Effect
  Name = MountDust
  Layers = [
    Layer
      Name = Dust
      Type = BURST
      Texture = kit/effects/particles/smoke_01.png
      Blend = Alpha
      Count = 12
      Life = [0.6, 1.0]
      Size = [3, 7]
      Colour = [0xB8A88A, 0x786A58]
      Alpha = [0.6, 0]
      Speed = [6, 12]
      Direction = OUT
      Spread = 20
      Radius = 2
      Height = 1
      TurnJitter = 360
    End
  ]
End

; The horse answering his call: a whinny (Peet J van Eeden, via antumdeluge, CC BY 3.0).
Sound
  Name = mount.call
  Channel = Effects
  Positional = Yes
  Gain = 0.7
  Files = [audio/sfx/horse/whinny.ogg]
End

