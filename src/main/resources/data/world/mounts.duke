; The pointer over his horse: a right-click gets him up onto it.
Cursor
  Name = Ride
  Image = ui/cursors/default/hand_open.png
  HotX = 15
  HotY = 15
  Tint = 0xC89A5A
End

; Dust kicked up where the horse appears from nowhere, and where he gets on and off.
Effect
  Name = MountDust
  Layers = [
    Layer
      Name = Dust
      Type = BURST
      Texture = kit/effects/particles/smoke_01.png
      Blend = Alpha
      Count = 12
      Life = [0.6, 1.0]
      Size = [3, 7]
      Colour = [0xB8A88A, 0x786A58]
      Alpha = [0.6, 0]
      Speed = [6, 12]
      Direction = OUT
      Spread = 20
      Radius = 2
      Height = 1
      TurnJitter = 360
    End
  ]
End

; The horse answering his call: a whinny (Peet J van Eeden, via antumdeluge, CC BY 3.0).
Sound
  Name = mount.call
  Channel = Effects
  Positional = Yes
  Gain = 0.7
  Files = [audio/sfx/horse/whinny.ogg]
End

; A stride's hooves while he rides (congusbongus's "Horse gallop on different
; surfaces", its CC0 strides).
Sound
  Name = mount.gallop
  Channel = Effects
  Positional = Yes
  Gain = 0.45
  Files = [audio/sfx/horse/gallop_grass.ogg, audio/sfx/horse/gallop_ground.ogg]
End

; The horse's own hooves as it runs in, by the ground under it.
Sound
  Name = walking.Horse
  Channel = Effects
  Positional = Yes
  Gain = 0.4
  GapSeconds = 0.55
  Files = [audio/sfx/horse/gallop_ground.ogg]
End

Sound
  Name = walking.Horse.grass
  Channel = Effects
  Positional = Yes
  Gain = 0.4
  GapSeconds = 0.55
  Files = [audio/sfx/horse/gallop_grass.ogg]
End

Sound
  Name = walking.Horse.forest
  Channel = Effects
  Positional = Yes
  Gain = 0.4
  GapSeconds = 0.55
  Files = [audio/sfx/horse/gallop_muffled.ogg]
End

Sound
  Name = walking.Horse.mud
  Channel = Effects
  Positional = Yes
  Gain = 0.4
  GapSeconds = 0.55
  Files = [audio/sfx/horse/gallop_muffled.ogg]
End

Sound
  Name = walking.Horse.sand
  Channel = Effects
  Positional = Yes
  Gain = 0.4
  GapSeconds = 0.55
  Files = [audio/sfx/horse/gallop_muffled.ogg]
End

; The capital's stable keeper, by the city's east gate (stage/WorldMapWriter):
; he sells the whistle.
Monster
  Name = Otboqar
  DisplayName = "Otboqar Rustam"
  KindOf = [INFANTRY, SELECTABLE]
  Geometry = Cylinder
    Radius = 4
    Height = 12
  End
  VisionRange = 0
  Modules = [
    MoveUpdate
      Speed = 8
      TurnRate = 0
    End
  ]
  MinDepth = 99
  Weight = 0
  Colour = 0x806040
  Scale = 1.0
  Model = models/heroes/ranger.glb
  Tint = 0x9A7A58
  ModelScale = 5.5
  Facing = 90
  Animations = Humanoid
End

Speaker
  Name = Otboqar
  DisplayName = "Otboqar Rustam"
  Picture =
End

Conversation
  Name = OtboqarGreets
  Lines = [
    Line
      Speaker = Otboqar
      Text = "Yaxshi ot - yarim yo'l! Hushtagini oling, shahar tashqarisida T ni bosing, oting chopib keladi."
    End
  ]
End

Npc
  Name = Otboqar
  Talk = OtboqarGreets
  Role = Otboqar
  Radius = 30
  Wander = 6
End

Merchant
  Name = Otboqar
  Stock = [
    ot 300 1,
    suv 5 6,
  ]
End
