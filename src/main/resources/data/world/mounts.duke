; ---------------------------------------------------------------------------
; A horse on the open world (docs/plan/2026-10-15-mounts.md). Owning one is
; carrying its whistle (the Potion "ot" below), sold by the capital's stable
; keeper or given by the story. T calls it -- it neighs and runs in -- and gets
; him up onto it and off it again; a right-click on it gets him up too. Riding,
; he goes twice his walk and does nothing else: a blow, an attack or a skill
; gets him off, and so does a town or any map that is not out of doors.
;
; While he rides, the horse is no thing of the world: he is drawn as his riding
; look below, the horse's rig and clips with him seated on its back (made by
; art/mounts/export_riders.py), until the engine can sit one unit on another
; (engine request E82).
; ---------------------------------------------------------------------------

Mount
  Whistle = ot
  Horse = Horse
  Looks = [
    "Knight = KnightRiding",
    "Rogue = RogueRiding",
    "Mage = MageRiding",
  ]
  ; Twice his walk: the knight's 21 is 42, the rogue's 27 is 54.
  SpeedPercent = 100
  Key = T
  KeyWord = Ot
  ; Up onto it in 0.6s (30 frames a second), his reach for a thing played meanwhile.
  MountFrames = 18
  MountClip = Gather
  ; How near the horse's middle he gets up onto it; how far off it starts its run in.
  Reach = 14
  CallDistance = 70
  ; Out of doors: the open world only. Not in the city or the villages.
  Maps = [world]
  NoRideZones = [Poytaxt, Olmazor, "Bog'iston", Qoratepa, Tolzor, Yangiobod]
  ; A stride's hooves while he rides and moves: the gallop's 0.58s.
  GallopFrames = 17
  NoHorseWord = Otingiz yo'q
  IndoorsWord = Bu yerda otga minib bo'lmaydi
  Call = mount.call
  Gallop = mount.gallop
  Puff = MountDust
End

; Owning a horse: its whistle. Never eaten, one to a place, sold by the stable
; keeper (data/story below) and never dropped (Weight 0).
Potion
  Name = ot
  DisplayName = "Ot hushtagi"
  Icon = horse
  Level = 1
  Price = 300
  Weight = 0
  Stack = 1
End

; The horse standing about while he is off it: Quaternius' "Horse" (CC0). On the
; engine's neutral side with no Body, so nothing fights it. It runs in at 48 a
; second when he whistles; its own hooves are walking.Horse below.
Monster
  Name = Horse
  DisplayName = Ot
  KindOf = [INFANTRY, SELECTABLE]
  Geometry = Cylinder
    Radius = 5
    Height = 10
  End
  VisionRange = 0
  Modules = [
    MoveUpdate
      Speed = 48
      TurnRate = 0
    End
  ]
  MinDepth = 99
  Weight = 0
  Colour = 0x8A5A30
  Model = models/mounts/horse.glb
  ; Its withers stand 10 under this scale, as under each riding look's.
  ModelScale = 4.0
  Facing = 90
  Idle = Idle
  Walk = Gallop
  ; A gallop's stride, in world units: the clip paced to its speed.
  WalkStride = 28
  Death = Death
End

; Each hero riding: drawn as one of these while he is on his horse (drawAs). The
; same ModelScale as his own look, which is what each file was sized for.
