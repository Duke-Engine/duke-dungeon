; The knight's Q, the wave his sword sends out -- see the Q skill of the Knight.
; A thing in flight like every arrow, so it is a creature with one ArrowUpdate;
; unlike an arrow it is never stopped by a body: the engine's WAVE carries it on
; through everything in the lane and hurts each one once. Stone, the keep's shut
; gate or the end of its Distance is what stops it.
Projectile
  Name = SwordWave
  DisplayName = Qilich to'lqini
  VisionRange = 0
  Modules = [
    ArrowUpdate
    End
  ]


; Its body is a model: a fat half-moon of white light, 24 tip to tip and 6.8 thick in
; the middle -- the skill's HitWidth (18) and its faded tips -- lying just off the floor
; and turned the way it flies as every arrow is (its bulge is the model's +X, so Facing
; 0). Its leading edge is where the wave is; the band trails behind it. Unlit and added
; to the floor, so it glows. Made for this, CC0: art/effects/knight_wave.py.
;
; ★ Why a model and not a layer of the effect (the owner's playtest of 1.0.39: "a plain
; dot flies off"): the client lets a projectile carry only its TRAIL, AURA and timeless
; LIGHT layers while it flies (LayeredEffects.inFlight). An ARC is not one of them: the
; half-moon layer it was drawn with before was kept for where it LANDS, and a wave that
; runs out of Distance lands nowhere -- so all that flew was the sparks, a dot.
  Model = models/effects/knight_wave.glb
  Scale = 1
  Facing = 0
  Height = 1.5
  Tint = 0xDDEBFF
  Effect = SwordWave
  EffectOffset = 0
End

; ---------------------------------------------------------------------------
; What the half-moon (the projectile's model, above) sheds as it runs: a soft white
; wake lying where it passed, and sparks. Both are TRAILs, which the client carries
; with a thing in flight. Each lives a moment, so the wake fades behind it, and when
; the wave reaches the end of its Distance and is gone, the last of its light fades
; out there. No light of its own: it crosses a room, and a moving light down every
; corridor is the costliest thing an effect can do.
; ---------------------------------------------------------------------------
Effect
  Name = SwordWave
  Layers = [
    Layer
      Name = Wake
      Type = TRAIL
      Texture = kit/effects/particles/circle_05.png
      Blend = Additive
      Count = 24
      Rate = 60
      Life = [0.3, 0.35]
      Size = [9, 5]
      Colour = [0xCFE4FF, 0x40506A]
      Alpha = [0.55, 0]
      Direction = NONE
    End,
    Layer
      Name = Sparks
      Type = TRAIL
      Texture = kit/effects/particles/star_04.png
      Blend = Additive
      Cover = 0.3
      Count = 26
      Rate = 65
      Life = [0.24, 0.4]
      Size = [3.5, 0.6]
      SizeEase = 2
      Colour = [0xFFE6B0, 0x5A4A30]
      Alpha = [1, 0]
      Speed = [2, 6]
      Direction = ALL
      Drag = 2
      Spin = 90
    End,
    Layer
      Name = Burst
      Type = BURST
      Texture = kit/effects/particles/circle_05.png
      Blend = Additive
      Cover = 0.3
      Count = 18
      Life = [0.18, 0.3]
      Size = [2.88, 0.48]
      Colour = [0xFFFFFF, 0x6A7A90]
      Alpha = [1, 0]
      Speed = [8, 20]
      Direction = ALL
      Drag = 3
    End
  ]
End

; ---------------------------------------------------------------------------
; The flash at his sword as he throws the wave -- the knight's Q's Look. It was the
; mage's CastFlash, borrowed; it is its own now because the client keys a cast's
; GESTURE by its Look (Visuals.castAnim), and the knight's Q has a gesture
; (Cast_Wave) that the mage's fire must not be asked for. White steel, not fire:
; the colours of the wave it lets go.
; ---------------------------------------------------------------------------
Effect
  Name = WaveFlash
  Layers = [
    Layer
      Name = Spark
      Type = IMPACT
      Texture = kit/effects/particles/flare_01.png
      Blend = Additive
      Count = 1
      Life = [0.22, 0.22]
      Size = [8, 26]
      SizeEase = 3
      Colour = [0xFFFFFF, 0xCFE4FF]
      Alpha = [1, 0]
      FadeOut = 0.6
      Height = 6
      TurnJitter = 0
    End,
    Layer
      Name = Light
      Type = LIGHT
      Seconds = 0.25
      LightColour = 0xCFE4FF
      LightPower = 1.5
      LightRadius = 36
      FadeOut = 0.8
    End
  ]
End
