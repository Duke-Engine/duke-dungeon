; The knight's Q, the wave his sword sends out -- see the Q skill of the Knight.
; A thing in flight like every arrow, so it is a creature with one ArrowUpdate;
; unlike an arrow it is never stopped by a body: the engine's WAVE carries it on
; through everything in the lane and hurts each one once. Stone, the keep's shut
; gate or the end of its Distance is what stops it.
Projectile
  Name = SwordWave
  DisplayName = Qilich to'lqini
  VisionRange = 0
  Modules = [
    ArrowUpdate
    End
  ]


; No model: a white-steel half-moon and the sparks it sheds, both drawn by the
; effect below.
  Height = 6
  Tint = 0xDDEBFF
  Effect = SwordWave
  EffectOffset = 0
End

; ---------------------------------------------------------------------------
; A HALF-MOON lying on the floor and running the way it was thrown -- the owner,
; 2026-10-10: "not a sphere, a crescent". The kit's slash (the arc Cleave cuts
; with) laid flat as an ARC, which the client turns so its bulge points the way
; the wave is travelling, read from how it moved since the last frame. Let out
; continuously and short-lived, so the newest is the wave and the ones just
; behind it fade into a faint wake. As wide as the skill's HitWidth (14).
;
; Not Follows: a layer that follows is drawn in the wave's own frame, and the
; turn is read off the ground it has crossed. White-steel and gold, the colours
; of Cleave, so it reads as the swing thrown on. No light of its own: it crosses
; a room, and a moving light down every corridor is the costliest thing an
; effect can do.
; ---------------------------------------------------------------------------
Effect
  Name = SwordWave
  Layers = [
    Layer
      Name = HalfMoon
      Type = ARC
      Texture = kit/effects/particles/slash_04.png
      Blend = Additive
      Count = 14
      Rate = 50
      Life = [0.18, 0.22]
      Size = [15, 13]
      Colour = [0xFFFFFF, 0xCFE4FF]
      Alpha = [1, 0]
      FadeOut = 0.6
      ; Just off the floor, so it never sinks into a step.
      Height = 1.5
      Direction = NONE
      TurnJitter = 0
    End,
    Layer
      Name = Sparks
      Type = TRAIL
      Texture = kit/effects/particles/star_04.png
      Blend = Additive
      Cover = 0.3
      Count = 26
      Rate = 65
      Life = [0.24, 0.4]
      Size = [3.5, 0.6]
      SizeEase = 2
      Colour = [0xFFE6B0, 0x5A4A30]
      Alpha = [1, 0]
      Speed = [2, 6]
      Direction = ALL
      Drag = 2
      Spin = 90
    End,
    Layer
      Name = Burst
      Type = BURST
      Texture = kit/effects/particles/circle_05.png
      Blend = Additive
      Cover = 0.3
      Count = 18
      Life = [0.18, 0.3]
      Size = [2.88, 0.48]
      Colour = [0xFFFFFF, 0x6A7A90]
      Alpha = [1, 0]
      Speed = [8, 20]
      Direction = ALL
      Drag = 3
    End
  ]
End

; ---------------------------------------------------------------------------
; The flash at his sword as he throws the wave -- the knight's Q's Look. It was the
; mage's CastFlash, borrowed; it is its own now because the client keys a cast's
; GESTURE by its Look (Visuals.castAnim), and the knight's Q has a gesture
; (Cast_Wave) that the mage's fire must not be asked for. White steel, not fire:
; the colours of the wave it lets go.
; ---------------------------------------------------------------------------
Effect
  Name = WaveFlash
  Layers = [
    Layer
      Name = Spark
      Type = IMPACT
      Texture = kit/effects/particles/flare_01.png
      Blend = Additive
      Count = 1
      Life = [0.22, 0.22]
      Size = [8, 26]
      SizeEase = 3
      Colour = [0xFFFFFF, 0xCFE4FF]
      Alpha = [1, 0]
      FadeOut = 0.6
      Height = 6
      TurnJitter = 0
    End,
    Layer
      Name = Light
      Type = LIGHT
      Seconds = 0.25
      LightColour = 0xCFE4FF
      LightPower = 1.5
      LightRadius = 36
      FadeOut = 0.8
    End
  ]
End
