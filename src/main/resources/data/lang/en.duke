; ---- data/story/villages.duke ----
Speaker.Villager.DisplayName = "Villager"  ; uz: Qishloqi
Speaker.Farmer.DisplayName = "Farmer"  ; uz: Dehqon
Speaker.Traveller.DisplayName = "Traveller"  ; uz: Yo'lovchi
Speaker.Pedlar.DisplayName = "Peddler Sobir"  ; uz: Chayqovchi Sobir
Speaker.TowerKeeper.DisplayName = "Tower Keeper"  ; uz: Minorabon
Conversation.VillagerGreets.Text = "Peace be with you, guest! Welcome to our village."  ; uz: Assalomu alaykum, mehmon! Qishlog'imizga xush kelibsiz.
Conversation.FarmerGreets.Text = "The land gave a good harvest this year. Just keep away from the roads at night."  ; uz: Yer bu yil yaxshi hosil berdi. Faqat kechalari yo'llardan uzoqroq yuring.
Conversation.TravellerGreets.Text = "May your road be open! I walk from village to village."  ; uz: Yo'lingiz ochiq bo'lsin! Men qishloqdan qishloqqa yuraman.
Conversation.PedlarGreets.Text = "Stop, stop! I have everything you need for the road — cheap!"  ; uz: To'xtang, to'xtang! Yo'l uchun kerakli narsalar bor — arzon!
Conversation.KeeperGreets.Text = "There is a road from tower to tower. Which one will you take? I will open the map."  ; uz: Minoradan minoraga yo'l bor. Qaysi biriga borasiz? Xaritani ochaman.
Npc.Villager.Role = "Villager"  ; uz: Qishloqi
Npc.Farmer.Role = "Farmer"  ; uz: Dehqon
Npc.Traveller.Role = "Traveller"  ; uz: Yo'lovchi
Npc.Pedlar.Role = "Merchant"  ; uz: Savdogar
Npc.TowerKeeper.Role = "Tower Keeper"  ; uz: Minorabon
Title.Journey.Text = "On the road..."  ; uz: Yo'lda...
Title.Journey.Subtext = "From tower to tower"  ; uz: Minoradan minoraga

; ---- data/story/act2.duke ----
Campaign.act2.Word = "Part 2: The Archer"  ; uz: 2-qism: Kamonchi
Campaign.act2.Blurb = "Years later, she comes looking for her beloved. If Part 1 was saved, it continues from there."  ; uz: Yillar o'tib, u yigitini izlab keladi. 1-qism saqlangan bo'lsa, o'sha yerdan davom etadi.
Speaker.Baker.DisplayName = "Baker Karim"  ; uz: Novvoy Karim
Speaker.Guard.DisplayName = "Guard Jasur"  ; uz: Qorovul Jasur
Speaker.Elder.DisplayName = "Elder Hamid"  ; uz: Oqsoqol Hamid
Npc.Baker.Role = "Baker"  ; uz: Novvoy
Npc.Guard.Role = "Guard"  ; uz: Qorovul
Npc.Elder.Role = "Elder"  ; uz: Oqsoqol
Conversation.HeroineArrives.Text = "That same light again... For years I searched for it — and this light has brought me here too."  ; uz: Yana o'sha nur... Yillar davomida uni izladim — va shu nur meni ham olib keldi.
Conversation.HeroineArrives.Text.1 = "He is in this world. I know it."  ; uz: U shu dunyoda. Bilaman.
Conversation.CommanderMeetsHer.Text = "Another light... The kingdom has summoned a hero again. Who are you?"  ; uz: Yana nur... Saltanat yana qahramon chaqirdi. Sen kimsan?
Conversation.CommanderMeetsHer.Text.1 = "I am looking for a young man. Years ago he fell here — with a sword, a little bewildered."  ; uz: Men bir yigitni izlayapman. U bundan yillar oldin shu yerga tushgan — qilichli, bir oz sarosimada.
Conversation.CommanderMeetsHer.Text.2 = "The last hero... He went to the dark castle and never came back. The queen has forbidden anyone to speak of him."  ; uz: Oxirgi qahramon... U qora qasrga ketdi va qaytmadi. Malika u haqda gapirishni taqiqlagan.
Conversation.CommanderMeetsHer.Text.3 = "I cannot tell you much. Ask in the city — people know what I cannot say."  ; uz: Men senga ko'p narsa aytolmayman. Shaharda so'ra — odamlar men aytolmaganni biladi.
Conversation.BakerTalks.Text = "A hero? Yes, there was one once. Now even saying his name is frightening. They say evil comes from the dark castle."  ; uz: Qahramon? Ha, bir vaqtlar bor edi. Endi uning nomini aytish ham qo'rqinchli. Qora qasrdan yovuzlik keladi, deyishadi.
Conversation.GuardTalks.Text = "Twenty years I have stood guard — and the queen has not aged a day. Strange, eh? But I did not say that."  ; uz: Yigirma yil qorovullik qildim — malika bir kun ham qarimadi. Ajib, a? Lekin buni men aytmadim.
Conversation.ElderTalks.Text = "Even when my grandfather was young, the queen was just as beautiful. No one knows her age..."  ; uz: Bobom yosh bo'lganida ham malika shunday go'zal edi. Uning yoshini hech kim bilmaydi...
Conversation.ElderKnows.Text = "Looking for the hero? Then learn the queen's secret — it comes with him."  ; uz: Qahramonni izlayapsanmi? Unda malikaning sirini bil — u bilan birga.
Conversation.ElderKnows.Text.1 = "Deep in the dark forest, in a hut on chicken legs, lives the crone Baba Yaga. Only she knows the queen's secret."  ; uz: Qorong'i o'rmonning tubida, tovuq oyoqli kulbada Yalmog'iz kampir yashaydi. Malikaning sirini faqat u biladi.
Conversation.ElderKnows.Text.2 = "Then I will go to the forest."  ; uz: Unda o'rmonga boraman.
Quest.Rumours.Title = "In Search of Him"  ; uz: Uni izlab
Quest.Rumours.Text = "Ask around the city: the elder knows something"  ; uz: Shaharda so'rab-surishtiring: oqsoqol nimadir biladi
Quest.Witch.Title = "The Crone of the Dark Forest"  ; uz: Qorong'i o'rmondagi kampir
Quest.Witch.Text = "Find the crone Baba Yaga deep in the dark forest"  ; uz: Qorong'i o'rmon tubidagi Yalmog'iz kampirni toping
Quest.WitchsPrice.Title = "The Crone's Price"  ; uz: Kampirning bahosi
Quest.WitchsPrice.Text = "Kill the necromancer in the forest"  ; uz: O'rmondagi o'likchini o'ldiring
Quest.WitchsPrice.Text.1 = "Return to the crone"  ; uz: Kampirga qayting
LootItem.CageKey.DisplayName = "Cage Key"  ; uz: Qafas kaliti
Conversation.DamselFreed.Text = "I am free! Thank you, sister. If the crone tells you the secret — believe her, she does not lie. She only asks her price."  ; uz: Ozodman! Rahmat, opa. Kampir sizga sirni aytsa — ishoning, u yolg'on gapirmaydi. Faqat narxini so'raydi.
Quest.CagedGirl.Title = "The Maiden in the Cage"  ; uz: Qafasdagi qiz
Quest.CagedGirl.Text = "Take the cage key from the necromancer"  ; uz: Qafas kalitini o'likchidan oling
Quest.CagedGirl.Text.1 = "Free the girl from the cage"  ; uz: Qizni qafasdan chiqaring
Conversation.GreenFreed.Text = "The Green Field is free. The merchants return to the road."  ; uz: Yashil dala ozod. Savdogarlar yo'lga qaytadi.
Conversation.RockyFreed.Text = "The Stony Hills are free. The mountain roads are open again."  ; uz: Toshli adir ozod. Tog' yo'llari yana ochiq.
Conversation.SandFreed.Text = "The Sandy Steppe is free. The caravans will pass again."  ; uz: Qumli dasht ozod. Karvonlar yana o'tadi.
Conversation.AllFreed.Text = "All three lands are free. The magic of the queen's castle has weakened — now the gate will open."  ; uz: Uchala yer ozod. Malika qasrining sehri zaiflashdi — endi darvoza ochiladi.
Conversation.CastleSealed.Text = "The gate is sealed by magic. Just as the crone said — I must free the lands first."  ; uz: Darvoza sehr bilan yopiq. Kampir aytgandek — avval yerlarni ozod qilishim kerak.
Quest.FreeGreen.Title = "Green Field"  ; uz: Yashil dala
Quest.FreeGreen.Text = "Clear the Green Field camp"  ; uz: Yashil dala lagerini tozalang
Quest.FreeRocky.Title = "Stony Hills"  ; uz: Toshli adir
Quest.FreeRocky.Text = "Clear the Stony Hills camp"  ; uz: Toshli adir lagerini tozalang
Quest.FreeSand.Title = "Sandy Steppe"  ; uz: Qumli dasht
Quest.FreeSand.Text = "Clear the Sandy Steppe camp"  ; uz: Qumli dasht lagerini tozalang
Quest.ToTheQueen.Title = "The Queen's Castle"  ; uz: Malika qasri
Quest.ToTheQueen.Text = "Go to the Queen's Castle"  ; uz: Malika qasriga boring
Title.ChapterArrival.Text = "Part 2: The Archer"  ; uz: 2-qism: Kamonchi
Title.ChapterArrival.Subtext = "Years later"  ; uz: Yillar o'tib
Title.ChapterHall.Text = "The Queen's Hall"  ; uz: Malika zali
Title.ChapterHall.Subtext = "Part 2"  ; uz: 2-qism
Title.TheEndCard.Text = "The End"  ; uz: Oxiri
Title.TheEndCard.Subtext = "The curse is lifted"  ; uz: La'nat ko'tarildi
Conversation.GirlAtHome.Text = "If not for you, I would still be in that cage. The commander gave me shelter."  ; uz: Siz bo'lmaganingizda, hali ham o'sha qafasda bo'lardim. Qo'mondon menga boshpana berdi.
Npc.FreedDamsel.Role = "Freed"  ; uz: Ozod

