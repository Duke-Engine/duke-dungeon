Monster.KnightRiding.DisplayName = "Garen"  ; uz: Garen
Monster.RogueRiding.DisplayName = "Erika"  ; uz: Erika
Monster.MageRiding.DisplayName = "Lira"  ; uz: Lira
Monster.Otboqar.DisplayName = "Rustam the Stablemaster"  ; uz: Otboqar Rustam
Speaker.Otboqar.DisplayName = "Rustam the Stablemaster"  ; uz: Otboqar Rustam
Conversation.OtboqarGreets.Text = "A good horse is half the road! Take the whistle, press T outside the city, and your horse comes running."  ; uz: Yaxshi ot - yarim yo'l! Hushtagini oling, shahar tashqarisida T ni bosing, oting chopib keladi.
Npc.Otboqar.Role = "Stablemaster"  ; uz: Otboqar

; ---- data/story/medallion.duke ----
Medallion.SoulsWord = "Souls"  ; uz: Jonlar
Medallion.CursedWord = "CURSED"  ; uz: CURSED
Medallion.TurnedWord = "The hero is cursed"  ; uz: Qahramon la'natlandi
Medallion.LockedWord = "The medallion cannot be taken off: it has bound itself to me"  ; uz: Medalyonni yechib bo'lmaydi: u menga bog'lanib qolgan
LootItem.Medallion.DisplayName = "The Queen's Medallion"  ; uz: Malikaning medalyoni
LootItem.Medallion.Slot = "Charm"  ; uz: Tumor
LootItem.Medallion.Name.1 = "Soul Drain"  ; uz: Jon yutish
Projectile.SoulWisp.DisplayName = "Soul"  ; uz: Jon
Speaker.Queen.DisplayName = "Queen"  ; uz: Malika
Npc.Queen.Role = "Queen"  ; uz: Malika
Conversation.QueenGives.Text = "Welcome, hero. No heroes remain in my kingdom — you are the last."  ; uz: Xush kelibsiz, qahramon. Saltanatimda qahramon qolmadi — siz oxirgisisiz.
Conversation.QueenGives.Text.1 = "Wear this medallion. It drinks the life of every enemy you slay and pours their strength into you."  ; uz: Bu medalyonni taqing. U siz o'ldirgan har bir dushmanning jonini yutib, kuchini sizga quyadi.
Conversation.QueenGives.Text.2 = "Only a hero can wear it. Go to the hall, then to the altar."  ; uz: Uni faqat qahramon taqa oladi. Zalga boring, so'ng mehrobga.
Conversation.QueenGives.Text.3 = "Thank you, my queen."  ; uz: Rahmat, malikam.
Conversation.QueenTakes.Text = "The medallion is full. Thank you, hero — it is in my hands again."  ; uz: Medalyon to'ldi. Rahmat, qahramon — u yana mening qo'limda.
Conversation.QueenTakes.Text.1 = "Now you are mine."  ; uz: Endi siz menikisiz.

; ---- data/story/final.duke ----
Speaker.CursedHero.DisplayName = "Cursed Hero"  ; uz: La'natlangan qahramon
Conversation.QueenGreets.Text = "So you came too, girl. His heart is mine now."  ; uz: Demak, sen ham keldingmi, qizaloq. Uning qalbi endi meniki.
Conversation.QueenGreets.Text.1 = "He is my beloved. I am taking him home."  ; uz: U mening yigitim. Uni uyga olib ketaman.
Conversation.QueenGreets.Text.2 = "Take him — if you can beat him."  ; uz: Olib ket — agar uni yenga olsang.
Conversation.QueenCalls.Text = "My knight! Come to me — stop her!"  ; uz: Ritsarim! Yonimga kel — uni to'xtat!
Conversation.HeroSpares.Text = "I will not kill you. This is not you — it is the medallion."  ; uz: Seni o'ldirmayman. Bu sen emassan — bu medalyon.
Conversation.QueenAlone.Text = "Useless slave! Then I will finish her myself."  ; uz: Yaroqsiz qul! Unda o'zim tugataman.
Conversation.QueenFalls.Text = "No... my youth... the souls..."  ; uz: Yo'q... yoshligim... jonlar...
Conversation.QueenFalls.Text.1 = "The medallion is broken. They are free now."  ; uz: Medalyon sindi. Ular endi ozod.
Conversation.QueenFalls.Text.2 = "Where... am I? You... you came looking for me."  ; uz: Men... qayerdaman? Sen... sen meni izlab kelding.
Conversation.QueenFalls.Text.3 = "Let's go home."  ; uz: Uyga ketamiz.
Trigger.TheEnd.Target.1 = "The curse is lifted"  ; uz: La'nat ko'tarildi

; ---- data/story/kampir.duke ----
Speaker.BabaYaga.DisplayName = "Baba Yaga"  ; uz: Yalmog'iz kampir
Speaker.Damsel.DisplayName = "Maiden"  ; uz: Qiz
Conversation.KampirGreets.Text = "Oho, a guest... It has been a long while since a hero walked into the dark forest on his own two feet."  ; uz: Oho, mehmon... Qorong'i o'rmonga o'z oyog'i bilan kelgan qahramonni ko'pdan beri ko'rmagandim.
Conversation.KampirGreets.Text.1 = "The medallion around your queen's neck... Do you know who made it? I do, child."  ; uz: Malikangning bo'ynidagi medalyon... Uni kim yasaganini bilasanmi? Men bilaman, bolam.
Conversation.KampirGreets.Text.2 = "Every secret has its price. It is not yet time — come back, and then we will talk."  ; uz: Har bir sirning bahosi bor. Hali vaqti emas — qaytib kel, shunda gaplashamiz.
Conversation.KampirsPrice.Text = "You want to know the secret, my girl? It is not free. First do a job for me."  ; uz: Sirni bilmoqchimisan, qizim? Bepul emas. Avval mening ishimni bajar.
Conversation.KampirsPrice.Text.1 = "A necromancer roams my forest — robbing my graves and bending souls to his will."  ; uz: O'rmonimda bir o'likchi kezadi — qabrlarimni o'g'irlab, jonlarni o'ziga bo'ysundiradi.
Conversation.KampirsPrice.Text.2 = "Destroy him. When you come back, I will tell you your queen's secret."  ; uz: Uni yo'q qil. Qaytib kelganingda, malikangning sirini aytaman.
Conversation.KampirsSecret.Text = "You did it... Then listen. I made the medallion — on the queen's order."  ; uz: Bajarding... Unda eshit. Medalyonni men yasaganman — malikaning buyurtmasi bilan.
Conversation.KampirsSecret.Text.1 = "It drinks the soul of every enemy slain. Those souls keep the queen young and beautiful forever."  ; uz: U har bir o'ldirilgan dushmanning jonini yutadi. O'sha jonlar malikani abadiy yosh va go'zal saqlaydi.
Conversation.KampirsSecret.Text.2 = "The hero fills the medallion — then it swallows the hero too. Your beloved is in the dark castle now, under the curse."  ; uz: Qahramon medalyonni to'ldiradi — so'ng u qahramonni ham yutadi. Sening yigiting endi qora qasrda, la'nat ichida.
Conversation.KampirsSecret.Text.3 = "It will not stop the war — and the queen keeps summoning new heroes. That same light brought you here too."  ; uz: U urushni to'xtatmaydi — malika esa yangi qahramonlar chaqiraveradi. Seni ham shu nur olib keldi.
Conversation.KampirsSecret.Text.4 = "How do I end it?"  ; uz: Qanday tugataman?
Conversation.KampirsSecret.Text.5 = "Kill the queen. The medallion will shatter, the souls will go free, the curse will lift. But her castle is sealed by magic."  ; uz: Malikani o'ldir. Medalyon sinadi, jonlar ozod bo'ladi, la'nat ko'tariladi. Ammo uning qasri sehr bilan yopiq.
Conversation.KampirsSecret.Text.6 = "First free the conquered lands: three castles — the Green Field, the Stony Hills, the Sandy Steppe. Without them the gate will not open."  ; uz: Avval bosib olingan yerlarni ozod qil: uchta qal'a — Yashil dala, Toshli adir, Qumli dasht. Ularsiz darvoza ochilmaydi.
Conversation.DamselAsks.Text = "Please, let me out of this cage! Before the crone returns from her cauldron..."  ; uz: Iltimos, meni bu qafasdan chiqaring! Kampir qozonidan qaytmasidan oldin...
Conversation.DamselAsks.Text.1 = "The key is on that necromancer — he sold me to the crone. Kill him and the key is yours."  ; uz: Kalit o'sha o'likchida — u meni kampirga sotgan. Uni o'ldirsangiz, kalit sizniki.
Npc.BabaYaga.Role = "Witch"  ; uz: Jodugar
Npc.Damsel.Role = "Captive"  ; uz: Asira
Npc.Imp.Role = "The Crone's Servant"  ; uz: Kampirning xizmatkori

; ---- data/story/act1.duke ----
Campaign.Word = "Part 1: The Last Hero"  ; uz: 1-qism: Oxirgi qahramon
Campaign.Blurb = "From the battlefield to the dark castle. The story begins here."  ; uz: Jang maydonidan qora qasrgacha. Hikoya shu yerdan boshlanadi.
Speaker.Act1Commander.DisplayName = "Commander"  ; uz: Qo'mondon
Speaker.Act1Queen.DisplayName = "Queen"  ; uz: Malika
Speaker.EnemyCommander.DisplayName = "Enemy Commander"  ; uz: Dushman sarkardasi
Speaker.DarkLord.DisplayName = "Dark Knight"  ; uz: Qora ritsar
Speaker.Blacksmith.DisplayName = "Master Smith"  ; uz: Temirchi Usta
Speaker.OldWoman.DisplayName = "Granny Zebo"  ; uz: Zebo momo
Npc.Act1Commander.Role = "Commander"  ; uz: Qo'mondon
Npc.Act1Queen.Role = "Queen"  ; uz: Malika
Npc.Blacksmith.Role = "Blacksmith"  ; uz: Temirchi
Npc.OldWoman.Role = "Granny"  ; uz: Momo
Conversation.BattleHolds.Text = "Hold the line! We will not give up a single step from the gate!"  ; uz: Safni ushlang! Darvozadan bir qadam ham chekinmaymiz!
Conversation.BattleHolds.Text.1 = "Surrender, commander. Your heroes are already finished."  ; uz: Taslim bo'l, qo'mondon. Qahramonlaringiz allaqachon tugagan.
Conversation.BattleHolds.Text.2 = "We may have no hero, but we are still here! Ritualists, summon him!"  ; uz: Qahramon bo'lmasa ham — biz bormiz! Kohinlar, chaqiring uni!
Conversation.HeroLands.Text = "Where... is this? I was just training with Erika..."  ; uz: Bu... qayer? Hozirgina Erika bilan mashq qilayotgan edim...
Conversation.HeroLands.Text.1 = "You fell from the sky in flame — so you are the hero. The ritualists summoned you."  ; uz: Osmondan olov bo'lib tushding — demak, sen qahramonsan. Kohinlar seni chaqirdi.
Conversation.HeroLands.Text.2 = "No... another one?! Retreat!"  ; uz: Yo'q... yana bittasi?! Chekinish!
Conversation.AfterLanding.Text = "They are running! Soldiers, finish off the rest!"  ; uz: Ular qochmoqda! Askarlar, qolganini tugating!
Conversation.AfterLanding.Text.1 = "There are no heroes left in this world. You are the last hero to be summoned."  ; uz: Bu dunyoda qahramon qolmagan. Sen chaqirilgan oxirgi qahramonsan.
Conversation.AfterLanding.Text.2 = "I have to get home. She is waiting for me."  ; uz: Men uyga qaytishim kerak. U meni kutyapti.
Conversation.AfterLanding.Text.3 = "Then go to the queen. Only she knows the way. Follow me — the palace is inside the city."  ; uz: Unda malikaning huzuriga yur. Yo'lni faqat u biladi. Ortimdan yur — saroy shahar ichida.
Quest.FollowCommander.Title = "Following the Commander"  ; uz: Qo'mondon izidan
Quest.FollowCommander.Description = "The commander is taking you to the queen's palace. Follow her: there is a golden mark above her head. If you fall behind, she will wait for you."  ; uz: Qo'mondon sizni malika saroyiga olib boradi. Uning ortidan yuring: boshi uzra oltin belgi bor. Uzoqlashsangiz, u sizni kutadi.
Quest.FollowCommander.Text = "Follow the commander to the palace"  ; uz: Qo'mondon izidan saroyga boring
Quest.MeetTheQueen.Title = "Before the Queen"  ; uz: Malika huzurida
Quest.MeetTheQueen.Description = "The commander has brought you to the palace. Speak with the queen before her throne."  ; uz: Qo'mondon sizni saroyga olib keldi. Taxt oldidagi malika bilan gaplashing.
Quest.MeetTheQueen.Text = "Speak with the queen"  ; uz: Malika bilan gaplashing
Conversation.WaveComes.Text = "Look — more of them, coming from the graves! Hero, fight!"  ; uz: Qarang — qabrlar tomondan yana kelishyapti! Qahramon, jang qil!
Conversation.Retreat.Text = "Only the two of us are left of the line. They keep coming out of those graves."  ; uz: Safimizdan faqat ikkimiz qoldik. Ular o'sha qabrlardan tinmay chiqyapti.
Conversation.Retreat.Text.1 = "We cannot hold them alone. We fall back to the city — the queen will know what to do. Follow me!"  ; uz: Yolg'iz qarshilik qila olmaymiz. Shaharga chekinamiz — malika nima qilishni biladi. Ortimdan yur!
Quest.FirstWave.Title = "The First Wave"  ; uz: Birinchi to'lqin
Quest.FirstWave.Description = "The dead out of the graves have fallen on the line. Cut them down."  ; uz: Qabrlardan chiqqan o'liklar safga yopirildi. Ularni qiring.
Quest.FirstWave.Text = "Cut down the dead out of the graves %d/%d"  ; uz: Qabrlardan chiqqan o'liklarni qiring %d/%d
Conversation.GateShut.Text = "We are not going there now. First, to the queen."  ; uz: Hozir u yerga bormaymiz. Avval malikaning huzuriga.
Speaker.Soqchi.DisplayName = "Guard"  ; uz: Soqchi
Npc.Ritualist.Role = "Ritualist"  ; uz: Kohin
Npc.Soqchi.Role = "Guard"  ; uz: Soqchi
Gate.Act1Battle.Word = "We are not going there now."  ; uz: Hozir u yerga bormaymiz.
Gate.Act1Capital.Word = "We are not going there now."  ; uz: Hozir u yerga bormaymiz.
Gate.Act1War.Word = "We are not going there now."  ; uz: Hozir u yerga bormaymiz.
Conversation.CommanderInCapital.Text = "This is the capital. The queen is waiting in the palace, on her throne. Come."  ; uz: Bu — poytaxt. Malika saroyda, taxtida kutmoqda. Yur.
Conversation.QueenWelcome.Text = "Welcome, hero. The commander has told me of the battle at the gate."  ; uz: Xush kelibsiz, qahramon. Qo'mondon darvoza oldidagi jangni aytib berdi.
Conversation.QueenWelcome.Text.1 = "The Dark Knight has taken my kingdom: our castles are in his hands, and my people live in fear."  ; uz: Saltanatimni qora ritsar bosib oldi: qal'alarimiz uning qo'lida, xalqim qo'rquvda.
Conversation.QueenWelcome.Text.2 = "Here is gold — and this medallion. It drinks the life of every enemy you slay and pours their strength into you."  ; uz: Mana, oltin — va bu medalyon. U siz o'ldirgan har bir dushmanning jonini yutib, kuchini sizga quyadi.
Conversation.QueenWelcome.Text.3 = "Only a hero can wear it."  ; uz: Uni faqat qahramon taqa oladi.
Conversation.QueenWelcome.Text.4 = "If I kill the Dark Knight, can I go home?"  ; uz: Qora ritsarni o'ldirsam, uyga qayta olamanmi?
Conversation.QueenWelcome.Text.5 = "Yes. Kill him and the way opens. But first stop those graves: the dead keep coming out of them. Take my soldiers."  ; uz: Ha. Uni o'ldiring — yo'l ochiladi. Ammo avval o'sha qabrlarni to'xtating: o'liklar ulardan tinmay chiqmoqda. Askarlarimni oling.
Conversation.ToTrainingLine.Text = "I will wait for you at the graves with my soldiers. They lie beyond the battlefield. A sorcerer stands among them: while the graves stand, nothing can harm him."  ; uz: Askarlarim bilan qabrlar oldida sizni kutaman. Qabrlar — jang maydonining narigi tomonida. Ular orasida sehrgar turibdi: qabrlar turgan ekan, unga zarar yetmaydi.
Quest.Training.Title = "The Old Graves"  ; uz: Eski qabrlar
; Quest.Training.Description = ""  ; uz: O'liklar shimoliy darvoza ortidagi eski qabrlardan chiqmoqda. Ular orasida sehrgar turibdi: qabrlar turgan ekan, unga zarar yetmaydi - qabrlar uning jonini to'ldiradi. Avval qabrlarni birma-bir buzing, so'ng sehrgarni o'ldiring.
Quest.Training.Text = "Leave through the north gate and go to the old crypts"  ; uz: Shimoliy darvozadan chiqib, eski qabrlarga boring
Quest.Training.Text.1 = "Break the graves one by one %d/%d"  ; uz: Qabrlarni birma-bir buzing %d/%d
Quest.Training.Text.2 = "Now kill the sorcerer: leave him be, and he raises the graves again"  ; uz: Endi sehrgarni o'ldiring: tinch qo'ysangiz, qabrlarni tiklaydi
Conversation.WarCouncil.Text = "You are back, hero? The medallion is feeding — can you feel it?"  ; uz: Qaytdingizmi, qahramon? Medalyon to'yinmoqda — sezyapsizmi?
Conversation.WarCouncil.Text.1 = "Now, war. We will free the captured castles one by one: find the key, open the gate, kill the commander."  ; uz: Endi urush. Bosib olingan qal'alarni birma-bir ozod qilamiz: kalitni topamiz, darvozani ochamiz, sarkardasini o'ldiramiz.
Conversation.WarCouncil.Text.2 = "Go. Every death makes you stronger."  ; uz: Boring. Har bir o'lim sizni kuchliroq qiladi.
Quest.BackToPalace.Title = "Return to the Palace"  ; uz: Saroyga qaytish
Quest.BackToPalace.Text = "Return to the queen's palace"  ; uz: Malika saroyiga qayting
Quest.ToWar.Title = "Dark Knight"  ; uz: Qora ritsar
Quest.ToWar.Description = "The commander has gone back to defend the city. The Black Knight's camp is in the north, beyond the mountains. Destroy the caves and graves you meet on the way: they give him strength."  ; uz: Qo'mondon shahar himoyasiga qaytdi. Qora ritsarning qarorgohi shimolda, tog'lar ortida. Yo'lda uchragan g'or va qabrlarni yo'q qiling: ular unga kuch beradi.
Quest.ToWar.Text = "Head north — to the Black Knight's camp"  ; uz: Shimolga — Qora ritsar qarorgohiga yo'l oling
Conversation.BlacksmithAsks.Text = "Hero! Rats and bats have overrun the city — the market, the streets. Their nest is in the cellar in the upper right corner of the city, above my workshop. Clear the nest — in return I will give you gauntlets."  ; uz: Qahramon! Shaharni kalamush va ko'rshapalaklar bosib ketdi — bozorda ham, ko'chada ham. Uyasi shaharning o'ng yuqori burchagidagi yerto'lada, mening ustaxonam tepasida. Uyani tozalab bering — evaziga qo'lqop beraman.
Conversation.BlacksmithThanks.Text = "The nest is cleared and the city breathes again! Here are the gauntlets I promised."  ; uz: Uyasi tozalandi, shahar nafas oldi! Mana, va'da qilgan qo'lqopim.
Conversation.OldWomanAsks.Text = "Son, I dropped my late husband's ring in the cellar. If you find it for me, I will bless you."  ; uz: O'g'lim, marhum cholimning uzugini yerto'lada tushirib qo'ydim. Topib bersang, duo qilaman.
Conversation.OldWomanThanks.Text = "You found it! May your road always be open. Take this charm — it will serve you well."  ; uz: Topdingmi! Ilohim, yo'ling ochiq bo'lsin. Mana bu tumorni ol — senga asqatadi.
Quest.Cellar.Title = "Rats and Bats"  ; uz: Kalamush va ko'rshapalaklar
Quest.Cellar.Description = "Rats and bats have overrun the city. Their nest is in the blacksmith's cellar — the upper right (north-east) corner of the city, marked on the M map. Kill the rats first, then the bats that fly out of the nest, and go back to the blacksmith."  ; uz: Shaharni kalamush va ko'rshapalaklar bosib ketgan. Ularning uyasi temirchining yerto'lasida — shaharning o'ng yuqori (shimoli-sharqiy) burchagida, M xaritada belgilangan. Avval kalamushlarni, so'ng uyadan uchib chiqadigan ko'rshapalaklarni qiring, keyin temirchiga qayting.
Quest.Cellar.Text = "Kill the rats — their nest is in the cellar in the upper right corner of the city %d/%d"  ; uz: Kalamushlarni qiring — uyasi shaharning o'ng yuqori burchagidagi yerto'lada %d/%d
Quest.Cellar.Text.1 = "Kill the bats that flew out of the nest %d/%d"  ; uz: Uyadan uchib chiqqan ko'rshapalaklarni qiring %d/%d
Quest.Cellar.Text.2 = "Return to the blacksmith"  ; uz: Temirchiga qayting
Quest.LostRing.Title = "Granny's Ring"  ; uz: Momoning uzugi
Quest.LostRing.Description = "Granny Zebo dropped her late husband's ring in the cellar. The cellar is in the upper right corner of the city — marked on the M map."  ; uz: Zebo momo cholining uzugini yerto'lada tushirib qo'ygan. Yerto'la shaharning o'ng yuqori burchagida — M xaritada belgilangan.
Quest.LostRing.Text = "Find the ring in the cellar in the upper right corner of the city"  ; uz: Shaharning o'ng yuqori burchagidagi yerto'lada uzukni toping
Quest.LostRing.Text.1 = "Give the ring to Granny Zebo"  ; uz: Uzukni Zebo momoga bering
LootItem.FamilyRing.DisplayName = "Old Man's Ring"  ; uz: Cholning uzugi
Conversation.SoldiersCome.Text = "The soldiers are here. The graves first — then the sorcerer's turn!"  ; uz: Askarlar shu yerda. Avval qabrlarni buzamiz — keyin sehrgarning navbati!
Conversation.CaveSeen.Text = "What is that? At the foot of the hill — a black mouth."  ; uz: Anavi nima? Tog' etagida — qop-qora og'iz.
Conversation.CaveSeen.Text.1 = "A cave. Full of monsters. Since the Black Knight began to rule, caves like it have multiplied."  ; uz: G'or. Ichi monstrlarga to'la. Qora ritsar hukmronlik qila boshlagandan beri bunaqa g'orlar ko'payib ketdi.
Conversation.CaveSeen.Text.2 = "To destroy one, every monster in it must be killed. But nobody who went in has come back yet."  ; uz: Uni yo'q qilish uchun ichidagi barcha monstrlarni o'ldirish kerak. Lekin u yerdan hali hech kim qaytib kelmagan.
Conversation.CaveSeen.Text.3 = "Where is the Black Knight's camp?"  ; uz: Qora ritsarning qarorgohi qayerda?
Conversation.CaveSeen.Text.4 = "In the north. Beyond the mountains."  ; uz: Shimolda. Tog'lar ortida.
Conversation.CityAttacked.Text = "Commander! The city is under attack! The gate barely holds!"  ; uz: Qo'mondon! Shaharga hujum qilishdi! Darvoza zo'rg'a turibdi!
Conversation.CityAttacked.Text.1 = "We must go back and defend the city."  ; uz: Biz shahar himoyasiga qaytishimiz kerak.
Conversation.CityAttacked.Text.2 = "Go. I will find the Black Knight and put an end to all of this."  ; uz: Siz boravering. Men Qora ritsarni topaman va buning barchasiga chek qo'yaman.
Conversation.CityAttacked.Text.3 = "Good luck. Know this: before you reach him, destroy as many caves and graves as you can. They give him strength."  ; uz: Omad yor bo'lsin. Bilib qo'y: uning oldiga borguningcha iloji boricha ko'proq g'or va qabrlarni yo'q qil. Ular unga kuch beradi.
Conversation.CampReached.Text = "The Black Knight's camp. The more graves and caves are left, the stronger he will be..."  ; uz: Qora ritsarning qarorgohi. Qanchalik ko'p qabr va g'or qolgan bo'lsa, u shunchalik kuchli bo'ladi...
KnightStrength.Word = "Black Knight's strength: %d%%"  ; uz: Qora ritsar kuchi: %d%%
Conversation.DarkLordWarns.Text = "Another one... Did the queen send you too?"  ; uz: Yana bittasi... Malika seni ham yubordimi?
Conversation.DarkLordWarns.Text.1 = "If I kill you, I go home."  ; uz: Seni o'ldirsam, uyga qaytaman.
Conversation.DarkLordWarns.Text.2 = "I once said the same."  ; uz: Men ham bir vaqtlar shunday deganman.
Conversation.QueenLaughs.Text = "Ha-ha-ha... Thank you, hero."  ; uz: Ha-ha-ha... Rahmat, qahramon.
Conversation.QueenLaughs.Text.1 = "The medallion is full — and it is in my hands again."  ; uz: Medalyon to'ldi — va u yana mening qo'limda.
Conversation.QueenLaughs.Text.2 = "You... tricked me. The Dark Knight was summoned just like me..."  ; uz: Sen... meni aldading. Qora ritsar ham men kabi chaqirilgan edi...
Conversation.QueenLaughs.Text.3 = "Now you are the lord of this castle. Forever. And when I need a new hero — you will fight again."  ; uz: Endi bu qasrning xo'jayini sensan. Abadiy. Menga yangi qahramon kerak bo'lganda — yana jang qilasan.
Quest.DarkCastle.Title = "The Dark Castle"  ; uz: Qora qasr
Quest.DarkCastle.Text = "Kill the Dark Knight"  ; uz: Qora ritsarni o'ldiring
Title.ChapterBattle.Text = "The Battle at the Gate"  ; uz: Darvoza oldidagi jang
Title.ChapterBattle.Subtext = "Part 1"  ; uz: 1-qism
Title.ChapterCapital.Text = "Capital"  ; uz: Poytaxt
Title.ChapterCapital.Subtext = "Part 1"  ; uz: 1-qism
Title.ChapterTraining.Text = "Training: The Old Crypts"  ; uz: Mashq: eski qabrlar
Title.ChapterTraining.Subtext = "Part 1"  ; uz: 1-qism
Title.ChapterWar.Text = "The Conquered Lands"  ; uz: Bosib olingan yerlar
Title.ChapterWar.Subtext = "Part 1"  ; uz: 1-qism
Title.ChapterCastle.Text = "The Dark Castle"  ; uz: Qora qasr
Title.ChapterCastle.Subtext = "Part 1"  ; uz: 1-qism
Title.ActOneEnd.Text = "Part 1 complete"  ; uz: 1-qism tugadi
Title.ActOneEnd.Subtext = "To be continued..."  ; uz: Davomi bor...

; ---- data/story/graveyards.duke ----
