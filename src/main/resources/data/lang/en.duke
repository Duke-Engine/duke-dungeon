Mount.KeyWord = "Horse"  ; uz: Ot
Mount.NoHorseWord = "You have no horse"  ; uz: Otingiz yo'q
Mount.IndoorsWord = "You cannot ride here"  ; uz: Bu yerda otga minib bo'lmaydi
Mount.Name = "Horse"  ; uz: Ot
; Mount.Blurb = ""  ; uz: Otda: ikki barobar tez.
Potion.ot.DisplayName = "Horse whistle"  ; uz: Ot hushtagi
