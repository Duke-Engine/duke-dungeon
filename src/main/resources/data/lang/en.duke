Potion.chizma.DisplayName = "Recipe Scroll"  ; uz: Hunar chizmasi
Unique.olovli_tigh.DisplayName = "Flame Blade"  ; uz: Olovli tig'
Unique.olovli_tigh.Lore = "An ember stone melted into the blade; it smokes when drawn."  ; uz: Olov toshi tig'ga singib ketgan; qinidan chiqsa tutun taraladi.
Unique.ritsar_qasami.DisplayName = "Knight's Oath"  ; uz: Ritsar qasami
Unique.ritsar_qasami.Lore = "Lange tempered it with the oath he swore on his father's sword."  ; uz: Lange uni otasining qilichi ustida ichgan qasami bilan toblagan.
Unique.ovchi_kamoni.DisplayName = "Huntress' Bow"  ; uz: Ovchi kamoni
Unique.ovchi_kamoni.Lore = "Cut from the lone poplar of the green field; its arrows outrun the wind."  ; uz: Yashil daladagi yolg'iz terakdan yo'nilgan; o'qi shamolni quvadi.

