; ---- data/story/story.duke ----
Dialogue.ContinueHint = "Click or press Space to continue"  ; uz: Davom etish uchun bosing / Space
Dialogue.OfferQuestion = "Will you take this quest?"  ; uz: Topshiriqni qabul qilasizmi?
Dialogue.OfferHint = "Enter / left click: accept  |  Esc / right click: not now"  ; uz: Enter / chap tugma: qabul qilaman  |  Esc / o'ng tugma: hozir emas
Speaker.Commander.DisplayName = "Commander Laylo"  ; uz: Qo'mondon Laylo
Conversation.CommanderGreets.Text = "At last you have come! You are the summoned hero, aren't you?"  ; uz: Nihoyat keldingiz! Siz chaqirilgan qahramonsiz, to'g'rimi?
Conversation.CommanderGreets.Text.1 = "Where... am I? A moment ago I was training."  ; uz: Men... qayerdaman? Bir lahza oldin mashq qilayotgan edim.
Conversation.CommanderGreets.Text.2 = "There is no time. Skeletons are gathering in the hall behind the wall — destroy five of them."  ; uz: Vaqt yo'q. Devor ortidagi zalda skeletlar to'planmoqda — beshtasini yo'q qiling.
Conversation.CommanderGreets.Text.3 = "And if you find my charm in the far hall — it was left to me by my mother."  ; uz: Va agar uzoq zalda tumorimni topsangiz — u menga onamdan qolgan.
Conversation.CommanderThanks.Text = "All five are gone? You truly are a hero."  ; uz: Beshtasi ham yo'q bo'ldi? Siz haqiqatan qahramonsiz.
Conversation.CommanderThanks.Text.1 = "Here, take this gauntlet. Now only the guard at the end of the hall remains."  ; uz: Mana, bu qo'lqopni oling. Endi zal oxiridagi qo'riqchini yengish qoldi.
Conversation.LocketReturned.Text = "My charm! Thank you. I will never forget this."  ; uz: Tumorim! Rahmat. Buni hech qachon unutmayman.
Npc.Commander.Role = "Commander"  ; uz: Qo'mondon
Quest.WallSkeletons.Title = "Skeletons Behind the Wall"  ; uz: Devordagi skeletlar
Quest.WallSkeletons.Description = "Commander Laylo said: skeletons are gathering in the hall behind the wall. Destroy five and return to her."  ; uz: Qo'mondon Laylo aytdi: devor ortidagi zalda skeletlar to'planmoqda. Beshtasini yo'q qiling va unga qayting.
Quest.WallSkeletons.Text = "Slay the skeletons %d/%d"  ; uz: Skeletlarni qiring %d/%d
Quest.WallSkeletons.Text.1 = "Return to the commander"  ; uz: Qo'mondonga qayting
Quest.LostLocket.Title = "The Lost Charm"  ; uz: Yo'qolgan tumor
Quest.LostLocket.Description = "The commander's charm, left to her by her mother, is lost in the far hall. Find it and return it to its owner."  ; uz: Qo'mondonga onasidan qolgan tumor uzoq zalda yo'qolgan. Uni topib, egasiga qaytaring.
Quest.LostLocket.Text = "Find the charm in the far hall"  ; uz: Uzoq zalda tumorni toping
Quest.LostLocket.Text.1 = "Give the charm to the commander"  ; uz: Tumorni qo'mondonga bering
LootItem.Locket.DisplayName = "Charm"  ; uz: Tumor
Conversation.CommanderSeesChest.Text = "There it is — the chest in the corner! My charm must be there."  ; uz: Ana u — burchakdagi sandiq! Tumorim o'sha yerda bo'lishi kerak.
Conversation.AmbushLine.Text = "Careful! They have come up behind us!"  ; uz: Ehtiyot bo'ling! Ular orqamizdan kelishdi!
Conversation.LocketHint.Text = "There is the chest, in the corner of the far hall. My charm is inside."  ; uz: Ana o'sha sandiq, uzoq zalning burchagida. Tumorim ichida.

