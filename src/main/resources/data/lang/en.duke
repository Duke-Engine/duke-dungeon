Object.Rogue.DisplayName = "Hero"  ; uz: Hero
Object.Skeleton.DisplayName = "Skeleton"  ; uz: Skeleton

; ---- the maps' titles and the code's own words ----
Map.deep.Title = "The Long Dark"  ; uz: The Long Dark
Map.deep.Description = "Wider than any floor and eight times down. Bring everything."  ; uz: Wider than any floor and eight times down. Bring everything.
Map.first.Title = "The First Descent"  ; uz: The First Descent
Map.first.Description = "One floor, drawn once and never again — learn it, then win it."  ; uz: One floor, drawn once and never again — learn it, then win it.
Map.hall.Title = "The Queen's Hall"  ; uz: Malika zali
Map.hall.Description = "The final fight: the cursed hero and the queen."  ; uz: Oxirgi jang: la'natlangan qahramon va malika.
Map.jang.Title = "Part 1: The Battle at the Gate"  ; uz: 1-qism: Darvoza oldidagi jang
Map.jang.Description = "The hero falls from the sky."  ; uz: Qahramon osmondan tushadi.
Map.medalyon.Title = "Medallion"  ; uz: Medalyon
Map.medalyon.Description = "The queen's medallion: it drinks souls, and in the end, you."  ; uz: Malikaning medalyoni: jonlarni yutadi, oxirida esa sizni.
Map.painted.Title = "Test Map"  ; uz: Sinov xaritasi
Map.painted.Description = "A test of painted ground: hills, rock, snow, sand and roads."  ; uz: Bo'yalgan yer sinovi: tepaliklar, qoya, qor, qum va yo'llar.
Map.poytaxt.Title = "Part 1: The Capital"  ; uz: 1-qism: Poytaxt
Map.poytaxt.Description = "The queen, the medallion and the road to training."  ; uz: Malika, medalyon va mashqqa yo'l.
Map.qasr.Title = "Castle Courtyard"  ; uz: Qasr hovlisi
Map.qasr.Description = "A test of castle pieces: towers, walls, a gate and the black keep."  ; uz: Qasr bo'laklari sinovi: minoralar, devorlar, darvoza va qora qal'a.
Map.qora_qasr.Title = "Part 1: The Dark Castle"  ; uz: 1-qism: Qora qasr
Map.qora_qasr.Description = "The Dark Knight and the secret of the medallion."  ; uz: Qora ritsar va medalyonning siri.
Map.talk.Title = "Commander"  ; uz: Qo'mondon
Map.talk.Description = "Meet the commander: two quests, one hall."  ; uz: Qo'mondon bilan tanishing: ikki topshiriq, bitta zal.
Map.world.Title = "Open World"  ; uz: Ochiq dunyo
Map.world.Description = "The whole kingdom on one map: the city, the dark forest, lands to free and the queen's castle."  ; uz: Butun qirollik bir xaritada: shahar, qorong'i o'rmon, ozod qilinadigan yerlar va malika qasri.
Settings.Language = "Language (after a restart)"  ; uz: Til (qayta ochilganda)
