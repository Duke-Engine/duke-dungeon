Monster.SkeletonHealer.Name.2 = "Mana Spring"  ; uz: Sehr buloqi
Monster.SkeletonHealer.Blurb = "Allies around him refill their mana faster."  ; uz: Atrofidagi o'zinikilarning manasi tezroq to'ladi.

; ---- data/units/skeleton_summoner.duke ----
Monster.SkeletonSummoner.DisplayName = "Skeleton Summoner"  ; uz: Skelet chaqiruvchi
Monster.SkeletonSummoner.Name.1 = "Summon"  ; uz: Chaqiruv
Monster.SkeletonSummoner.Name.2 = "Haste"  ; uz: Shiddat
Monster.SkeletonSummoner.Blurb = "For a few seconds hits much faster."  ; uz: Bir necha soniya ancha tezroq uradi.
Monster.SkeletonSummoner.Name.3 = "Might"  ; uz: Qudrat
Monster.SkeletonSummoner.Blurb.1 = "Allies around him hit harder, and their skills grow stronger too."  ; uz: Atrofidagi o'zinikilar qattiqroq uradi, mahoratlari ham kuchliroq.

; ---- data/units/mage.duke ----
Hero.Mage.DisplayName = "Lira"  ; uz: Lira
Hero.Mage.Title = "Fire and Ice"  ; uz: Olov va muz
Hero.Mage.Name.1 = "STR"  ; uz: STR
Hero.Mage.Name.2 = "AGI"  ; uz: AGI
Hero.Mage.Name.3 = "INT"  ; uz: INT
Hero.Mage.Name.4 = "Fire Bolt"  ; uz: Olov o'qi
Hero.Mage.Blurb = "Fires a bolt of flame in the chosen direction. It stops at the first body or wall it hits and explodes there."  ; uz: Yo'nalish bo'ylab olov o'qi otadi. Birinchi uchragan tanaga yoki devorga urilib to'xtaydi va o'sha joyda portlaydi.
Hero.Mage.Name.5 = "Ice Wave"  ; uz: Muz to'lqini
Hero.Mage.Blurb.1 = "Detonates ice at the chosen spot: it damages everything there and slows it for a while. The slow matters more than the damage."  ; uz: Tanlangan joyda muz portlatadi: u yerdagilarga zarar beradi va ularni bir muddat sekinlashtiradi. Zarari emas — sekinlashuvi muhim.
Hero.Mage.Name.6 = "Blink"  ; uz: Siljish
Hero.Mage.Blurb.2 = "Appears elsewhere in an instant. What lies between — wall or enemy — does not matter at all."  ; uz: Bir zumda boshqa joyda paydo bo'ladi. Oradagi narsa — devormi, dushmanmi — umuman ahamiyatsiz.
Hero.Mage.Blurb.3 = "Calls a meteor down on the chosen spot. It does not land at once: a warning circle appears on the ground, and whoever manages to step out of it survives."  ; uz: Tanlangan joyga meteor chaqiradi. U bir zumda tushmaydi: yerda ogohlantiruvchi doira paydo bo'ladi, va undan chiqib ketishga ulgurgan omon qoladi.
Hero.Mage.NotIn = "Bog'iston"  ; uz: Bog'iston
Hero.Mage.Name.8 = "Horse"  ; uz: Ot
; Hero.Mage.Name.9 = ""  ; uz: Qo'nish zarbasi

