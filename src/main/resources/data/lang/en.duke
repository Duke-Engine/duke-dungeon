; ---- data/units/rogue.duke ----
Hero.Rogue.DisplayName = "Erika"  ; uz: Erika
Hero.Rogue.Title = "Master of the Bow"  ; uz: O'q ustasi
Hero.Rogue.Name.1 = "STR"  ; uz: STR
Hero.Rogue.Name.2 = "AGI"  ; uz: AGI
Hero.Rogue.Name.3 = "INT"  ; uz: INT
Hero.Rogue.Name.4 = "Heavy Arrow"  ; uz: Og'ir o'q
Hero.Rogue.Blurb = "Draws the bow fully and looses a heavy arrow at a single enemy. The arrow cuts across the room, so the target may have time to run."  ; uz: Kamonni to'liq tortib bitta dushmanga og'ir o'q otadi. O'q xonani kesib o'tadi, shuning uchun nishon qochib ulgurishi mumkin.
Hero.Rogue.Name.5 = "Arrow Rain"  ; uz: O'q yomg'iri
Hero.Rogue.Blurb.1 = "Damages every enemy around her at once. Used when surrounded."  ; uz: Atrofdagi hamma dushmanga bir vaqtda zarar yetkazadi. Qurshab olinganda bosiladi.
Hero.Rogue.Name.6 = "Dash"  ; uz: Chopish
Hero.Rogue.Blurb.2 = "Dashes swiftly in the chosen direction. Hurts no one — it is a way out of a fight, not into one."  ; uz: Ko'rsatilgan tomonga tez siljiydi. Hech kimga zarar bermaydi — bu jangdan chiqish yo'li, jangga kirish emas.
Hero.Rogue.Name.7 = "Take Aim"  ; uz: Nishonga ol
Hero.Rogue.Blurb.3 = "For a time all her blows hit harder. She hits no one herself — it is a window that makes everything else worth more."  ; uz: Bir muddat uning hamma zarbalari kuchliroq bo'ladi. O'zi hech kimga tegmaydi — bu boshqa hamma narsani qimmatroq qiladigan oyna.
Hero.Rogue.NotIn = "Bog'iston"  ; uz: Bog'iston
Hero.Rogue.Name.8 = "Horse"  ; uz: Ot
; Hero.Rogue.Name.9 = ""  ; uz: Qo'nish zarbasi

; ---- data/units/knight.duke ----
Hero.Knight.DisplayName = "Garen"  ; uz: Garen
Hero.Knight.Title = "Shield and Sword"  ; uz: Qalqon va qilich
Hero.Knight.Name.1 = "STR"  ; uz: STR
Hero.Knight.Name.2 = "AGI"  ; uz: AGI
Hero.Knight.Name.3 = "INT"  ; uz: INT
Hero.Knight.Name.4 = "Sword Wave"  ; uz: Qilich to'lqini
Hero.Knight.Blurb = "He swings his sword and a wave bursts from it. The wave cuts through every enemy in its path once — it is not stopped by bodies, only by a wall or the end of its range."  ; uz: Qilichini siltaydi va undan to'lqin otilib chiqadi. To'lqin yo'lidagi har bir dushmanni bir martadan kesib o'tadi — tanaga urilib to'xtamaydi, faqat devor yoki o'z masofasi tugaganda to'xtaydi.
Hero.Knight.Name.5 = "Shield Charge"  ; uz: Qalqon bilan surish
Hero.Knight.Blurb.1 = "Holding his shield forward, he rushes in the chosen direction. He catches every enemy in his path and carries them along, then throws them down in front of him when he stops, leaving them stunned."  ; uz: Qalqonini oldinga tutib, ko'rsatilgan tomonga yugurib ketadi. Yo'lida uchragan har bir dushmanni ilib, o'zi bilan birga suradi, to'xtaganda esa ularni oldiga tashlab, gangitib qo'yadi.
Hero.Knight.Name.6 = "Dragon Blood"  ; uz: Ajdar qoni
Hero.Knight.Blurb.2 = "Dragon blood runs in his veins: he takes less damage from every blow and heals himself every second. Both grow stronger with each rank. Not cast — always active."  ; uz: Tomirlarida ajdar qoni oqadi: har bir zarbadan kamroq zarar oladi va har soniyada o'zi tuzalib boradi. Har bir darajada ikkalasi ham kuchayadi. Bosilmaydi — doim ishlaydi.
Hero.Knight.Name.7 = "Reverse Polarity"  ; uz: Teskari qutb
Hero.Knight.Blurb.3 = "Pulls every enemy around him to one point — right in front of him — damaging and stunning them. The gathered enemies can be cut down with a single wave."  ; uz: Atrofidagi barcha dushmanlarni bir nuqtaga — o'zining ro'parasiga — tortib keladi, ularga zarar yetkazadi va gangitib qo'yadi. To'plangan dushmanlarni bitta to'lqin bilan kesish mumkin.
Hero.Knight.NotIn = "Bog'iston"  ; uz: Bog'iston
Hero.Knight.Name.8 = "Horse"  ; uz: Ot
; Hero.Knight.Name.9 = ""  ; uz: Qo'nish zarbasi

