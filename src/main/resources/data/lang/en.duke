Unique.ajdar_tishi.DisplayName = "Dragon's Tooth"  ; uz: Ajdar tishi
Unique.ajdar_tishi.Lore = "Ripped from a dragon's mouth; the blade is still warm."  ; uz: Ajdarning og'zidan sug'urib olingan; tig'i hali ham iliq.
Unique.qala_devori.DisplayName = "Castle Wall"  ; uz: Qal'a devori
Unique.qala_devori.Lore = "This armour did not bend even on the day the capital fell."  ; uz: Poytaxt qulagan kuni ham bu sovut bukilmagan.
Unique.bori_boshi.DisplayName = "Wolf's Head"  ; uz: Bo'ri boshi
Unique.bori_boshi.Lore = "From the skull of the last white wolf; it howls at the full moon."  ; uz: Oxirgi oq bo'rining bosh suyagidan; to'lin oyda uvillaydi.
Unique.shamol_izi.DisplayName = "Trail of the Wind"  ; uz: Shamol izi
Unique.shamol_izi.Lore = "No one ever caught a runner who wore it."  ; uz: Uni kiygan chopqirni hech kim quvib yetolmagan.
Unique.kampir_marjoni.DisplayName = "Crone's Beads"  ; uz: Kampir marjoni
Unique.kampir_marjoni.Lore = "Baba Yaga tore it from the neck of the girl who ran away."  ; uz: Yalmog'iz kampir uni qochgan qizning bo'ynidan yulib olgan.
Unique.kampir_marjoni.Name.1 = "Crone's Spell: nearby allies +3 Mana/s"  ; uz: Kampir sehri: yonidagilarga +3 Mana/s
Unique.qonli_ahd.DisplayName = "Blood Oath"  ; uz: Qonli ahd
Unique.qonli_ahd.Lore = "It asks a drop of blood with every blow — and takes it."  ; uz: Har zarbadan bir tomchi qon so'raydi va oladi.
Unique.qonli_ahd.Name.1 = "Blood Pact: nearby allies +10% Attack"  ; uz: Qon ahdi: yonidagilarga +10% Zarba
